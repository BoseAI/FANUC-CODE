/PROG HOMING
   1:   ;
   2:  OVERRIDE=R[153:V_Homing] ;
   3:  UFRAME_NUM=9 ;
   4:  UTOOL_NUM=1 ;
   5:  COL DETECT ON ;
   6:   ;
   7:  DO[26:StartRSR006Done]=OFF ;
   8:  DO[53:ReadyForLabel]=OFF ;
   9:  CALL V_NEXT_STEP ;
  10:   ;
  11:  IF R[900:Tipo Macchina]=1, CALL CHK_BUF ;
  12:   ;
  13:  PR[50:ZeroPos Robot]=P[101:Home Pos] ;
  14:  R[95:Appoggio]=PR[50,6:ZeroPos Robot]+R[123:OFF.R PrelProd] ;
  15:  IF R[95:Appoggio]<180, JMP LBL[1] ;
  16:  R[95:Appoggio]=R[95:Appoggio]-360 ;
  17:  LBL[1] ;
  18:  PR[50,6:ZeroPos Robot]=R[95:Appoggio] ;
  19:  IF DO[7:Home position]=ON, JMP LBL[3] ;
  20:   ;
  21:  ! Controllo rq h min ;
  22:  PR[9:Appoggio]=LPOS ;
  23:  R[97:Appoggio]=PR[9,1:Appoggio] ;
  24:  R[96:Appoggio]=PR[9,2:Appoggio] ;
  25:  R[95:Appoggio]=PR[9,3:Appoggio] ;
  26:  IF DO[8:Teach pendant enabled]=ON, JMP LBL[10] ;
  27:  //IF R[97:Appoggio]>-570, JMP LBL[10] ;
  28:  IF DI[16:Altezza minima homing]=OFF, JMP LBL[10] ;
  29:  IF R[95:Appoggio]>R[467:AltezzaMinHome], JMP LBL[10] ;
  30:  ! Non c'e' la h min ;
  31:  DO[16:HomeMinHeightMissing]=PULSE,0.3sec ;
  32:  ABORT ;
  33:  END ;
  34:   ;
  35:  LBL[10] ;
  36:   ;
  37:  PR[9:Appoggio]=LPOS ;
  38:  R[97:Appoggio]=PR[9,1:Appoggio] ;
  39:  R[96:Appoggio]=PR[9,2:Appoggio] ;
  40:  R[95:Appoggio]=PR[9,3:Appoggio] ;
  41:  R[98:Appoggio]=PR[9,6:Appoggio] ;
  42:  ! in zona pallet B con ingombro ;
  43:  IF R[96:Appoggio]>250 AND R[97:Appoggio]>-600, JMP LBL[11] ;
  44:   ;
  45:   ;
  46:   ;
  47:  IF R[97:Appoggio]<-440, JMP LBL[5] ;
  48:  ! Robot in zona Pallet ;
  49:  LBL[11] ;
  50:  IF R[95:Appoggio]>100, JMP LBL[20] ;
  51:   ;
  52:  PR[9,3:Appoggio]=100 ;
  53:  L PR[9:Appoggio] 2000mm/sec FINE ;
  54:   ;
  55:  LBL[20] ;
  56:   ;
  57:  IF R[96:Appoggio]>0, JMP LBL[4] ;
  58:  ! Robot in zona Pallet A ;
  59:  PR[1:Appoggio]=P[120:ExitPalletA] ;
  60:  J PR[1:Appoggio] 100% FINE ;
  61:  IF R[911:Rotation Buffer]=0, JMP LBL[3] ;
  62:  PR[1,1:Appoggio]=-241 ;
  63:  PR[1,2:Appoggio]=-616 ;
  64:  PR[1,3:Appoggio]=1000 ;
  65:   ;
  66:  L PR[1:Appoggio] 2000mm/sec FINE ;
  67:  JMP LBL[3] ;
  68:  LBL[4] ;
  69:  ! Robot in zona Pallet B ;
  70:   ;
  71:  PR[1:Appoggio]=P[130:ExitPalletB] ;
  72:  //PR[1,6:Appoggio]=R[98:Appoggio] ;
  73:  J PR[1:Appoggio] 100% FINE ;
  74:  PR[2:Appoggio]=PR[1:Appoggio] ;
  75:  PR[2,6:Appoggio]=PR[50,6:ZeroPos Robot] ;
  76:   ;
  77:  J PR[2:Appoggio] 100% CNT0 ;
  78:  IF R[911:Rotation Buffer]=1, JMP LBL[3] ;
  79:  PR[1:Appoggio]=LPOS ;
  80:  PR[1,1:Appoggio]=-550 ;
  81:  PR[1,2:Appoggio]=-30 ;
  82:  L PR[1:Appoggio] 2000mm/sec FINE ;
  83:   ;
  84:  JMP LBL[3] ;
  85:  LBL[2] ;
  86:  IF R[96:Appoggio]<200, JMP LBL[5] ;
  87:  ! Robot in zona Scarto ;
  88:   ;
  89:  IF R[95:Appoggio]>550, JMP LBL[50] ;
  90:   ;
  91:  PR[9,3:Appoggio]=550 ;
  92:  L PR[9:Appoggio] 2000mm/sec FINE ;
  93:   ;
  94:  LBL[50] ;
  95:   ;
  96:  PR[1:Appoggio]=P[130:ExitPalletB] ;
  97:  PR[1,6:Appoggio]=R[98:Appoggio] ;
  98:  J PR[1:Appoggio] 100% FINE ;
  99:   ;
 100:   ;
 101:  JMP LBL[3] ;
 102:  LBL[5] ;
 103:   ;
 104:  IF R[96:Appoggio]>-750, JMP LBL[6] ;
 105:  ! Robt in zona camera ;
 106:   ;
 107:  PR[9:Appoggio]=LPOS ;
 108:  PR[9,2:Appoggio]=-350 ;
 109:  L PR[9:Appoggio] 2000mm/sec FINE ;
 110:   ;
 111:  LBL[6] ;
 112:  ! Robot in zona Pickup Case ;
 113:   ;
 114:  IF R[95:Appoggio]>550, JMP LBL[3] ;
 115:  PR[9:Appoggio]=LPOS ;
 116:  PR[9,3:Appoggio]=600 ;
 117:  L PR[9:Appoggio] 2000mm/sec FINE ;
 118:   ;
 119:  //PR[9,1:Appoggio]=-1100 ;
 120:  //PR[9,2:Appoggio]=-350 ;
 121:  //L PR[9:Appoggio] 100mm/sec FINE ;
 122:   ;
 123:  //PR[9,6:Appoggio]=PR[50,6:ZeroPos Robot] ;
 124:  //J PR[9:Appoggio] 50% FINE ;
 125:  LBL[3] ;
 126:  UTOOL_NUM=1 ;
 127:  IF R[901:Pinze Presenti]>=1, CALL GRIP_OP ;
 128:  IF R[901:Pinze Presenti]=2, CALL GRIPT_OP ;
 129:  IF R[902:CupsUP/DW Presen]>=1, CALL CUPS_UP ;
 130:   ;
 131:  L PR[50:ZeroPos Robot] 1000mm/sec FINE ;
 132:  DO[66:OutOfObstructFromPickup]=ON ;
 133:  DO[67:OutOfObstructFromCasePak]=ON ;
 134:  DO[68:OutObstructionInterlayer]=ON ;
 135:  DO[78:Out Obstruction PickUp]=ON ;
 136:  DO[79:Out Obstruction Labeller]=ON ;
 137:  DO[80:Out Obstruction ChkLabel]=ON ;
 138:  DO[69:Out Obstruction Pallet A]=ON ;
 139:  DO[70:Out Obstruction Pallet B]=ON ;
 140:  DO[44:Rq Inib All Prel Cartone]=OFF ;
 141:   ;
 142:  WAIT 0.10(sec) ;
 143:   ;
 144:  ! ATTENZIONE ;
 145:  ! P[101]   memorizzato anche ;
 146:  ! come REFPOS 1 ;
 147:  PR[51:Delta Mov]=JPOS ;
 148:  R[98:Appoggio]=PR[51,1:Delta Mov]/57.296 ;
 149:  $REFPOS1[1].$PERCHPOS[1]=R[98:Appoggio] ;
 150:  R[98:Appoggio]=PR[51,2:Delta Mov]/57.296 ;
 151:  $REFPOS1[1].$PERCHPOS[2]=R[98:Appoggio] ;
 152:  R[98:Appoggio]=PR[51,3:Delta Mov]/57.296 ;
 153:  $REFPOS1[1].$PERCHPOS[3]=R[98:Appoggio] ;
 154:  R[98:Appoggio]=PR[51,4:Delta Mov]/57.296 ;
 155:  $REFPOS1[1].$PERCHPOS[4]=R[98:Appoggio] ;
 156:  R[98:Appoggio]=PR[51,5:Delta Mov]/57.296 ;
 157:  $REFPOS1[1].$PERCHPOS[5]=R[98:Appoggio] ;
 158:  R[98:Appoggio]=PR[51,6:Delta Mov]/57.296 ;
 159:  $REFPOS1[1].$PERCHPOS[6]=R[98:Appoggio] ;
 160:  COL DETECT OFF ;
 161:   ;
 162:  R[1:RobotStatus]=0 ;
 163:  END ;
 164:  J P[101:Home Pos] 1% FINE ;
 165:  J P[120:ExitPalletA] 1% FINE ;
 166:  J P[130:ExitPalletB] 1% FINE ;
 167:  J P[160:ExitPickProd] 1% FINE ;
 168:  J P[170:ExitDropProd] 1% FINE ;
 169:   ;
 170:   ;
/POS
P[101:Home Pos]  UF:9 UT:1  X=-810.0 Y=-165.0 Z=990.0 W=180.0 P=0.0 R=0.0
P[120:ExitPalletA]  UF:9 UT:1  X=120.0 Y=-800.0 Z=900.0 W=180.0 P=0.0 R=0.0
P[130:ExitPalletB]  UF:9 UT:1  X=120.0 Y=800.0 Z=885.0 W=180.0 P=0.0 R=0.0
P[160:ExitPickProd]  UF:9 UT:1  X=-1500.0 Y=-150.0 Z=100.0 W=180.0 P=0.0 R=0.0
P[170:ExitDropProd]  UF:9 UT:1  X=-1500.0 Y=-475.0 Z=250.0 W=180.0 P=0.0 R=0.0
