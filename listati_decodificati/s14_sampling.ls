/PROG S14_SAMPLING
   1:   ;
   2:  IF R[1:RobotStatus]=1001, JMP LBL[3] ;
   3:  IF R[1:RobotStatus]=1003, JMP LBL[1] ;
   4:  IF R[1:RobotStatus]=1004, JMP LBL[1] ;
   5:  IF R[1:RobotStatus]=1007, JMP LBL[1] ;
   6:  IF R[1:RobotStatus]=1008, JMP LBL[1] ;
   7:  IF R[1:RobotStatus]=1017, JMP LBL[1] ;
   8:  IF R[1:RobotStatus]=1018, JMP LBL[1] ;
   9:  IF R[1:RobotStatus]=1015, JMP LBL[100] ;
  10:   ;
  11:  JMP LBL[98] ;
  12:   ;
  13:  LBL[1] ;
  14:  OVERRIDE=R[3:SpeedWithProd] ;
  15:   ;
  16:  UFRAME_NUM=9 ;
  17:  UTOOL_NUM=1 ;
  18:  COL DETECT ON ;
  19:   ;
  20:  PR[9:Appoggio]=LPOS ;
  21:  R[97:Appoggio]=PR[9,1:Appoggio] ;
  22:  R[96:Appoggio]=PR[9,2:Appoggio] ;
  23:  R[95:Appoggio]=PR[9,3:Appoggio] ;
  24:   ;
  25:  IF R[97:Appoggio]<520, JMP LBL[2] ;
  26:  ! Robot in zona Pallet ;
  27:   ;
  28:  IF R[95:Appoggio]>100, JMP LBL[20] ;
  29:   ;
  30:  PR[9,3:Appoggio]=100 ;
  31:  L PR[9:Appoggio] 2000mm/sec FINE ;
  32:   ;
  33:  LBL[20] ;
  34:   ;
  35:  IF R[96:Appoggio]>0, JMP LBL[4] ;
  36:  ! Robot in zona Pallet A ;
  37:   ;
  38:  J P[120:ExitPalletA] 100% FINE ;
  39:   ;
  40:  JMP LBL[3] ;
  41:  LBL[4] ;
  42:  ! Robot in zona Pallet B ;
  43:   ;
  44:  J P[130:ExitPalletB] 100% FINE ;
  45:   ;
  46:  JMP LBL[3] ;
  47:  LBL[2] ;
  48:  ! Robot in zona Pickup Case ;
  49:   ;
  50:  PR[9,3:Appoggio]=100 ;
  51:  L PR[9:Appoggio] 2000mm/sec FINE ;
  52:   ;
  53:  LBL[3] ;
  54:   ;
  55:  R[1:RobotStatus]=14 ;
  56:   ;
  57:  IF R[908:PosSampling]=1, JMP LBL[100] ;
  58:   ;
  59:  UFRAME[5]=PR[189:Frame P_B+Off] ;
  60:  UFRAME_NUM=5 ;
  61:  UTOOL[2]=PR[182:Tool A+B] ;
  62:  UTOOL_NUM=2 ;
  63:   ;
  64:  PR[55:Centro Pallet]=P[100:Zero] ;
  65:  PR[55,1:Centro Pallet]=0 ;
  66:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]*0.3 ;
  67:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
  68:   ;
  69:  ! IF NEEDED,RAISE TO 55,3 ;
  70:  PR[54:OutObstruction Z]=LPOS ;
  71:  PR[54,1:OutObstruction Z]=-200 ;
  72:  PR[54,2:OutObstruction Z]=-720 ;
  73:  PR[54,3:OutObstruction Z]=PR[55,3:Centro Pallet] ;
  74:  PR[54,4:OutObstruction Z]=PR[55,4:Centro Pallet] ;
  75:  PR[54,5:OutObstruction Z]=PR[55,5:Centro Pallet] ;
  76:  J PR[54:OutObstruction Z] 100% CNT80 ;
  77:   ;
  78:  ! CORRECT PR55 TO HAVE ;
  79:  ! MINIMUM J6 MOVEMENT ;
  80:  CALL CORR_ANG(54,55) ;
  81:  J PR[55:Centro Pallet] 80% CNT100 ;
  82:  DO[78:Out Obstruction PickUp]=ON ;
  83:   ;
  84:  LBL[100] ;
  85:   ;
  86:  UFRAME[5]=PR[196:Frame Sampling] ;
  87:  UFRAME_NUM=5 ;
  88:  UTOOL[2]=PR[182:Tool A+B] ;
  89:  UTOOL_NUM=2 ;
  90:   ;
  91:  L P[3:EntrDep] 2000mm/sec CNT5 ;
  92:  L P[2:AvvDep] 2000mm/sec CNT3 ;
  93:   ;
  94:  WAIT R[10:RqRobotMission]=114 OR R[20:TEST]=1 ;
  95:   ;
  96:  L P[1:DepProd] 2000mm/sec FINE ;
  97:   ;
  98:  ! Rilascio Pacco ;
  99:  IF R[901:Pinze Presenti]=1, CALL GRIP_DIS ;
 100:   ;
 101:  IF DI[58:No Load Run]=ON, JMP LBL[45] ;
 102:  IF R[106:Sel_TipoAsp]=2, JMP LBL[41] ;
 103:   ;
 104:  SELECT R[57:TipoDepCorrente]=0, JMP LBL[41] ;
 105:         =2, JMP LBL[42] ;
 106:         =3, JMP LBL[43] ;
 107:   ;
 108:  LBL[41] ;
 109:  CALL ASPA_OFF ;
 110:  CALL ASPB_OFF ;
 111:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
 112:  JMP LBL[45] ;
 113:   ;
 114:  LBL[42] ;
 115:  CALL ASPA_OFF ;
 116:  WAIT DI[34:CaseReleaseChA]=ON ;
 117:  JMP LBL[45] ;
 118:   ;
 119:  LBL[43] ;
 120:  CALL ASPB_OFF ;
 121:  WAIT DI[38:CaseReleaseChB]=ON ;
 122:  JMP LBL[45] ;
 123:   ;
 124:  LBL[45] ;
 125:   ;
 126:  OVERRIDE=R[2:NoProductSpeed] ;
 127:   ;
 128:  L P[3:EntrDep] 2000mm/sec CNT100 ;
 129:   ;
 130:   ;
 131:  IF R[908:PosSampling]=1, JMP LBL[101] ;
 132:   ;
 133:  UFRAME[5]=PR[189:Frame P_B+Off] ;
 134:  UFRAME_NUM=5 ;
 135:  UTOOL[2]=PR[182:Tool A+B] ;
 136:  UTOOL_NUM=2 ;
 137:   ;
 138:  J PR[55:Centro Pallet] 80% CNT100 ;
 139:  DO[70:Out Obstruction Pallet B]=ON ;
 140:   ;
 141:  J PR[54:OutObstruction Z] 80% CNT100 ;
 142:   ;
 143:  LBL[101] ;
 144:  R[1:RobotStatus]=1014 ;
 145:  END ;
 146:   ;
 147:   ;
 148:  LBL[98] ;
 149:  MESSAGE[..................] ;
 150:  MESSAGE[..SEQUENCE ERROR..] ;
 151:  MESSAGE[..Status <> 1001 ....] ;
 152:  MESSAGE[..Status <> 1003..] ;
 153:  MESSAGE[..Status <> 1004..] ;
 154:  MESSAGE[..Status <> 1007..] ;
 155:  MESSAGE[..Status <> 1008..] ;
 156:  MESSAGE[..Status <> 1015..] ;
 157:  MESSAGE[..Status <> 1017..] ;
 158:  MESSAGE[..Status <> 1018..] ;
 159:  MESSAGE[..Program Aborted.] ;
 160:  MESSAGE[..................] ;
 161:  CALL ABORT ;
 162:   ;
 163:  LBL[99] ;
 164:  CALL ABORT ;
 165:  J P[100:Zero] 100% CNT100 ;
 166:   ;
 167:   ;
/POS
P[1:DepProd]  UF:5 UT:2  X=216.5 Y=168.0 Z=255.5 W=-180.0 P=0.0 R=0.0
P[2:AvvDep]  UF:5 UT:2  X=216.5 Y=168.0 Z=661.0 W=-180.0 P=0.0 R=0.0
P[3:EntrDep]  UF:5 UT:2  X=216.5 Y=168.0 Z=855.5 W=-180.0 P=0.0 R=0.0
P[100:Zero]  UF:5 UT:2  X=0.0 Y=0.0 Z=0.0 W=-180.0 P=0.0 R=0.0
P[120:ExitPalletA]  UF:9 UT:1  X=700.0 Y=-320.0 Z=250.0 W=180.0 P=0.0 R=0.0
P[130:ExitPalletB]  UF:9 UT:1  X=700.0 Y=320.0 Z=250.0 W=180.0 P=0.0 R=0.0
