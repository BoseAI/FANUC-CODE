 185:  LBL[71] ;
 186:   ;
 187:  LBL[70] ;
 188:   ;
 189:  ! Calc exit prel interlayer ;
 190:  PR[46:UscitaPrelInt]=LPOS ;
 191:   ;
 192:  ! Calc Offset P W ;
 193:  ! For exit prel interlayer ;
 194:  R[99:Appoggio]=R[116:OffsPW_Interl]*R[6:Inclin_PrelInter] ;
 195:  R[99:Appoggio]=R[99:Appoggio]/100 ;
 196:   ;
 197:  ! Sel Offset P W ;
