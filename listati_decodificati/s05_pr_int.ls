 156:   ;
 157:  L PR[47:PosInteTrovato] 2000mm/sec FINE ;
 158:  R[70:BackUpZPickIntl]=PR[49,3:PosPezzoTrovato]-PR[40,3:Prelievo Intl] ;
 159:   ;
