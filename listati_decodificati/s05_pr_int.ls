 161:   ;
 162:  IF R[106:Sel_TipoAsp]=0, JMP LBL[321] ;
 163:  SELECT R[114:Sel_InterTipoAsp]=2, JMP LBL[21] ;
 164:         =3, JMP LBL[22] ;
 165:         =0, JMP LBL[23] ;
 166:   ;
 167:  LBL[321] ;
 168:  WAIT DI[33:CasePickUpChA]=ON TIMEOUT,LBL[99] ;
 169:  JMP LBL[325] ;
 170:   ;
 171:  LBL[322] ;
 172:  WAIT DI[37:CasePickUpChB]=ON TIMEOUT,LBL[99] ;
 173:  JMP LBL[325] ;
 174:   ;
 175:  LBL[323] ;
 176:  WAIT DI[33:CasePickUpChA]=ON TIMEOUT,LBL[99] ;
 177:  WAIT DI[37:CasePickUpChB]=ON TIMEOUT,LBL[99] ;
 178:  JMP LBL[325] ;
 179:   ;
 180:  LBL[325] ;
