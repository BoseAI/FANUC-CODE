  38:  PR[54,1:OutObstruction Z]=0 ;
  39:  PR[54,2:OutObstruction Z]=R[108:Dim.Y Pallet]*0.4 ;
  40:  PR[54,3:OutObstruction Z]=R[682:OutObstruInt] ;
  41:  J PR[54:OutObstruction Z] 100% CNT30 ;
  42:   ;
  43:  UFRAME[5]=PR[189:Frame P_B+Off] ;
  44:  UFRAME_NUM=5 ;
  45:  UTOOL[2]=PR[182:Tool A+B] ;
  46:  UTOOL_NUM=2 ;
  47:   ;
  48:  ! IF NEEDED,RAISE TO 55,3 ;
  49:  PR[54:OutObstruction Z]=LPOS ;
  50:  PR[54,1:OutObstruction Z]=0 ;
  51:  PR[54,2:OutObstruction Z]=R[108:Dim.Y Pallet]*0.4 ;
  52:  PR[54,3:OutObstruction Z]=R[682:OutObstruInt] ;
