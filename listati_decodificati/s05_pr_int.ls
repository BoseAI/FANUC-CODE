  56:   ;
  57:  UFRAME[5]=PR[184:Frame Intlr+OFF] ;
  58:  UFRAME_NUM=5 ;
  59:  UTOOL[3]=PR[183:Tool3 Intl] ;
  60:  UTOOL_NUM=3 ;
  61:   ;
  62:  COL DETECT ON ;
  63:  R[1:RobotStatus]=5 ;
  64:  ! Calcolo l'offset al prelievo ;
  65:  DO[55:Blow Enable for Intl]=ON ;
  66:  PR[41:Avvic Intlayer]=PR[40:Prelievo Intl] ;
  67:  PR[41,3:Avvic Intlayer]=PR[40,3:Prelievo Intl]+R[70:BackUpZPickIntl]+R[478:Avvic Prelievo I] ;
  68:   ;
  69:  OVERRIDE=R[2:NoProductSpeed] ;
  70:  IF R[902:CupsUP/DW Presen]=1, CALL CUPS_DW ;
  71:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
  72:  J P[10:OutObstructionIt] 100% CNT100 ;
  73:  WAIT R[10:RqRobotMission]=105 OR R[20:TEST]=1 ;
  74:   ;
  75:  LBL[1:WAIT Attuatori] ;
  76:  IF DI[62:Cups DW]=OFF AND R[902:CupsUP/DW Presen]=1, JMP LBL[1] ;
  77:   ;
  78:  DO[68:OutObstructionInterlayer]=OFF ;
  79:  DO[44:Rq Inib All Prel Cartone]=ON ;
  80:   ;
  81:  IF DI[58:No Load Run]=ON, JMP LBL[25] ;
  82:  IF R[106:Sel_TipoAsp]=0, JMP LBL[21] ;
  83:  SELECT R[114:Sel_InterTipoAsp]=2, JMP LBL[21] ;
  84:         =3, JMP LBL[22] ;
  85:         =0, JMP LBL[23] ;
  86:   ;
  87:  LBL[21] ;
  88:  CALL ASPA_ON ;
  89:  JMP LBL[25] ;
  90:   ;
  91:  LBL[22] ;
  92:  CALL ASPB_ON ;
  93:  JMP LBL[25] ;
  94:   ;
  95:  LBL[23] ;
  96:  CALL ASPA_ON ;
  97:  CALL ASPB_ON ;
  98:  JMP LBL[25] ;
  99:   ;
 100:  LBL[25] ;
 101:   ;
 102:  ! LBL65 search after failure ;
 103:  LBL[65] ;
 104:  L PR[41:Avvic Intlayer] 2000mm/sec CNT50 ;
 105:   ;
 106:  IF DI[58:No Load Run]=ON, JMP LBL[70] ;
 107:   ;
 108:  ! Ctrl count interlayer after ctrl ;
 109:  IF R[902:CupsUP/DW Presen]=1, JMP LBL[400] ;
 110:  IF R[38:InterlayerCount]<R[39:NumInterPickUp], JMP LBL[400] ;
 111:  DO[50]=OFF ;
 112:  LBL[400] ;
 113:   ;
 114:  ! Ctrl if it is the second pickup ;
 115:  IF DO[50]=ON, JMP LBL[60] ;
 116:   ;
 117:  L PR[41:Avvic Intlayer] 2000mm/sec FINE ;
 118:  OVERRIDE=100 ;
 119:  F[99]=(ON) ;
 120:  CALL CTRL_N(40,0,0,R[482:TorqueToll Intl],1.2,R[478:Avvic Prelievo I],100,33) ;
 121:   ;
 122:  IF R[20:TEST]=1, JMP LBL[121] ;
 123:  IF R[106:Sel_TipoAsp]=0, JMP LBL[121] ;
 124:  SELECT R[114:Sel_InterTipoAsp]=2, JMP LBL[121] ;
 125:         =3, JMP LBL[122] ;
 126:         =0, JMP LBL[123] ;
 127:   ;
 128:  LBL[121] ;
 129:  WAIT DI[33:CasePickUpChA]=ON TIMEOUT,LBL[99] ;
 130:  JMP LBL[125] ;
 131:   ;
 132:  LBL[122] ;
 133:  WAIT DI[37:CasePickUpChB]=ON TIMEOUT,LBL[99] ;
 134:  JMP LBL[125] ;
 135:   ;
 136:  LBL[123] ;
 137:  WAIT DI[33:CasePickUpChA]=ON TIMEOUT,LBL[99] ;
 138:  WAIT DI[37:CasePickUpChB]=ON TIMEOUT,LBL[99] ;
 139:  JMP LBL[125] ;
 140:   ;
 141:  LBL[125] ;
 142:   ;
