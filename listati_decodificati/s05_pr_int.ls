 144:  IF R[902:CupsUP/DW Presen]=1, JMP LBL[401] ;
 145:  DO[50]=ON ;
 146:  LBL[401] ;
 147:  R[38:InterlayerCount]=0 ;
 148:   ;
 149:  PR[47:PosInteTrovato]=LPOS ;
 150:  R[70:BackUpZPickIntl]=PR[47,3:PosInteTrovato]-PR[40,3:Prelievo Intl] ;
