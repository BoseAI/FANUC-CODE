  22:  IF R[1:RobotStatus]=1903, JMP LBL[6] ;
  23:  IF R[1:RobotStatus]=1904, JMP LBL[6] ;
  24:  IF R[1:RobotStatus]=1910, JMP LBL[6] ;
  25:  IF R[1:RobotStatus]=1911, JMP LBL[6] ;
  26:   ;
  27:  JMP LBL[98] ;
  28:   ;
  29:  LBL[3] ;
  30:   ;
  31:  UFRAME[5]=PR[192:Frame P_A+Off] ;
  32:  UFRAME_NUM=5 ;
  33:  UTOOL[2]=PR[182:Tool A+B] ;
  34:  UTOOL_NUM=2 ;
  35:  OVERRIDE=R[2:NoProductSpeed] ;
  36:   ;
