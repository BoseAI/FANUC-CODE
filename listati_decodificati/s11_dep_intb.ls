/PROG S11_DEP_INTB
   1:   ;
   2:  IF R[1:RobotStatus]=1005, JMP LBL[3] ;
   3:  JMP LBL[98] ;
   4:   ;
   5:  LBL[3] ;
   6:   ;
   7:  UFRAME[5]=PR[189:Frame P_B+Off] ;
   8:  UFRAME_NUM=5 ;
   9:  UTOOL_NUM=3 ;
  10:  OVERRIDE=R[3:SpeedWithProd] ;
  11:  R[1:RobotStatus]=11 ;
  12:  DO[70:Out Obstruction Pallet B]=OFF ;
  13:  PR[54:OutObstruction Z]=LPOS ;
  14:  PR[54,1:OutObstruction Z]=0 ;
  15:  PR[54,3:OutObstruction Z]=PR[55,3:Centro Pallet] ;
  16:  PR[54,4:OutObstruction Z]=180 ;
  17:  L PR[54:OutObstruction Z] 2000mm/sec CNT100 ;
  18:   ;
  19:  L PR[55:Centro Pallet] 2000mm/sec CNT80 ;
  20:   ;
  21:  WAIT R[10:RqRobotMission]=111 OR R[20:TEST]=1 ;
  22:  PR[44,6:Deposito Intl]=PR[54,6:OutObstruction Z] ;
  23:  PR[45,6:Avvic Dep Intl]=PR[54,6:OutObstruction Z] ;
  24:  L PR[45:Avvic Dep Intl] 2000mm/sec CNT100 ;
  25:   ;
  26:  L PR[44:Deposito Intl] 2000mm/sec CNT0 ;
  27:   ;
  28:   ;
  29:  IF DI[58:No Load Run]=ON, JMP LBL[225] ;
  30:  IF R[106:Sel_TipoAsp]=0, JMP LBL[221] ;
  31:  SELECT R[114:Sel_InterTipoAsp]=2, JMP LBL[21] ;
  32:         =3, JMP LBL[22] ;
  33:         =0, JMP LBL[23] ;
  34:   ;
  35:  LBL[221] ;
  36:  CALL ASPA_OFF ;
  37:  WAIT DI[34:CaseReleaseChA]=ON OR R[20:TEST]=1 ;
  38:  JMP LBL[225] ;
  39:   ;
  40:  LBL[222] ;
  41:  CALL ASPB_OFF ;
  42:  WAIT DI[38:CaseReleaseChB]=ON OR R[20:TEST]=1 ;
  43:  JMP LBL[225] ;
  44:   ;
  45:  LBL[223] ;
  46:  CALL ASPA_OFF ;
  47:  CALL ASPB_OFF ;
  48:  IF R[20:TEST]=1, JMP LBL[225] ;
  49:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
  50:  JMP LBL[225] ;
  51:   ;
  52:  LBL[225] ;
  53:   ;
  54:  R[30:RqIntlTopPallet]=0 ;
  55:   ;
  56:  R[43]=2 ;
  57:   ;
  58:  CALL V_CNT_P ;
  59:  R[25:IntlHeight]=R[25:IntlHeight]+R[136:IntlThickness] ;
  60:  L PR[45:Avvic Dep Intl] 2000mm/sec CNT100 ;
  61:  DO[44:Rq Inib All Prel Cartone]=OFF ;
  62:   ;
  63:  R[1:RobotStatus]=1011 ;
  64:  PR[55,1:Centro Pallet]=300 ;
  65:  L PR[55:Centro Pallet] 2000mm/sec CNT100 ;
  66:  IF R[902:CupsUP/DW Presen]=1, CALL CUPS_UP ;
  67:   ;
  68:  DO[70:Out Obstruction Pallet B]=ON ;
  69:   ;
  70:  ! WAIT CHANGE MISSION ;
  71:  ! FROM PLC ;
  72:  R[99:Appoggio]=0 ;
  73:  LBL[200] ;
  74:  IF R[10:RqRobotMission]=5, JMP LBL[990] ;
  75:  R[99:Appoggio]=R[99:Appoggio]+1 ;
  76:  IF R[99:Appoggio]>=20, JMP LBL[97] ;
  77:  IF DO[27:Rq Interlayer]=ON, JMP LBL[200] ;
  78:   ;
  79:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  80:  UFRAME_NUM=5 ;
  81:  UTOOL[2]=PR[182:Tool A+B] ;
  82:  UTOOL_NUM=2 ;
  83:  ! PR54=PREL_PROD ENTRY ;
  84:  ! POINT AT ACTUAL HEIGHT ;
  85:  PR[1:Appoggio]=LPOS ;
  86:  PR[54:OutObstruction Z]=P[3:EntrPrelProd] ;
  87:  R[98:Appoggio]=PR[1,3:Appoggio] ;
  88:  R[99:Appoggio]=PR[54,3:OutObstruction Z] ;
  89:  IF R[98:Appoggio]<=R[99:Appoggio], JMP LBL[120] ;
  90:  PR[54,3:OutObstruction Z]=R[98:Appoggio] ;
  91:  LBL[120] ;
  92:  ! NECESSARY J[PR54: ;
  93:  ! FOR RETURN IN INTERVAL ;
  94:  ! 180..-180 ;
  95:  J PR[54:OutObstruction Z] 100% CNT100 ;
  96:   ;
  97:  END ;
  98:   ;
  99:  LBL[97] ;
 100:  MESSAGE[..................] ;
 101:  MESSAGE[..SEQUENCE ERROR..] ;
 102:  MESSAGE[..INTERLAYER FROM ] ;
 103:  MESSAGE[..DEP INT B..] ;
 104:  CALL ABORT ;
 105:   ;
 106:  LBL[98] ;
 107:  MESSAGE[..................] ;
 108:  MESSAGE[..SEQUENCE ERROR..] ;
 109:  MESSAGE[..Status <> 1005 ..] ;
 110:  MESSAGE[..Program Aborted.] ;
 111:  MESSAGE[..................] ;
