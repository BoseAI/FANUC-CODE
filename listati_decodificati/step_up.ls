/PROG STEP_UP
   1:  IF R[30:RqIntlTopPallet]=1, JMP LBL[2] ;
   2:  ! Incremento puntatori ;
   3:  R[21:Counter Prod A]=R[21:Counter Prod A]+1 ;
   4:  IF R[21:Counter Prod A]>=R[110:NumProd x LayerA], JMP LBL[1] ;
   5:   ;
   6:  JMP LBL[2] ;
   7:   ;
   8:  LBL[1:Strato completo ] ;
   9:  R[22:CounterLayerA]=R[22:CounterLayerA]+1 ;
  10:  R[24:CountStrato]=R[22:CounterLayerA]+276 ;
  11:  IF R[22:CounterLayerA]>=R[112:NumLayers Prod], JMP LBL[10] ;
  12:  SELECT R[R[24]]=1, JMP LBL[3] ;
  13:         =2, JMP LBL[3] ;
  14:         =3, JMP LBL[4] ;
  15:         =4, JMP LBL[4] ;
  16:         =5, JMP LBL[3] ;
  17:         =6, JMP LBL[3] ;
  18:         ELSE, JMP LBL[15] ;
  19:   ;
  20:  LBL[4:Interlayer] ;
  21:  DO[27:Rq Interlayer]=ON ;
  22:  LBL[3:Inizio Strato] ;
  23:  R[21:Counter Prod A]=0 ;
  24:  JMP LBL[2] ;
  25:   ;
  26:  LBL[10] ;
  27:  IF DI[43:SelIntDepOnPalEnd]=OFF, JMP LBL[2] ;
  28:  IF R[30:RqIntlTopPallet]=1, JMP LBL[2] ;
  29:  DO[27:Rq Interlayer]=ON ;
  30:  R[30:RqIntlTopPallet]=1 ;
  31:  END ;
  32:   ;
  33:  LBL[2:END] ;
  34:  R[30:RqIntlTopPallet]=0 ;
  35:  CALL V_CNT_P ;
  36:  END ;
  37:   ;
  38:  LBL[15:Errore tipo Laye] ;
  39:  MESSAGE[.......................] ;
  40:  MESSAGE[...ERRORE SELEZIONE....] ;
  41:  MESSAGE[.....TIPO LAYER........] ;
  42:  MESSAGE[.......................] ;
  43:  CALL ABORT ;
  44:  END ;
  45:   ;
