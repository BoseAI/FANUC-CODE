/PROG CC_PREL_2
   1:   ;
   2:  PR[1:Appoggio]=P[100:Zero] ;
   3:  SELECT R[909:FixedWirePick_2]=0, JMP LBL[1001] ;
   4:         =1, JMP LBL[21] ;
   5:         =2, JMP LBL[22] ;
   6:         =3, JMP LBL[23] ;
   7:   ;
   8:  LBL[21:FiloFissoSX] ;
   9:  PR[1,2:Appoggio]=R[113:NCasseInY]*R[125:Dim.Y Prod]/2 ;
  10:  PR[1,2:Appoggio]=0-PR[1,2:Appoggio] ;
  11:  JMP LBL[20] ;
  12:   ;
  13:  LBL[22:F_F_Centrale] ;
  14:  PR[1,2:Appoggio]=0 ;
  15:  JMP LBL[20] ;
  16:   ;
  17:  LBL[23:FiloFissoDX] ;
  18:  PR[1,2:Appoggio]=R[113:NCasseInY]*R[125:Dim.Y Prod]/2 ;
  19:  JMP LBL[20] ;
  20:   ;
  21:  LBL[20] ;
  22:  PR[1,1:Appoggio]=R[133:NCasseInX]*R[124:Dim.X Prod]/2 ;
  23:  PR[1,2:Appoggio]=PR[1,2:Appoggio]+R[121:OFF.Y PrelProd] ;
  24:  PR[1,3:Appoggio]=R[126:Dim.Z Prod] ;
  25:  PR[1,1:Appoggio]=0-PR[1,1:Appoggio]+R[120:OFF.X PrelProd] ;
  26:  PR[1,3:Appoggio]=PR[1,3:Appoggio]+R[122:OFF.Z PrelProd] ;
  27:  PR[1,4:Appoggio]=-180 ;
  28:  PR[1,5:Appoggio]=0 ;
  29:  PR[1,6:Appoggio]=R[123:OFF.R PrelProd] ;
  30:   ;
  31:  PR[2:Appoggio]=PR[1:Appoggio] ;
  32:  PR[2,3:Appoggio]=PR[1,3:Appoggio]+R[150:Avvic Z PrelProd] ;
  33:   ;
  34:  PR[3:Appoggio]=PR[2:Appoggio] ;
  35:  PR[3,3:Appoggio]=PR[2,3:Appoggio]+200 ;
  36:   ;
  37:  PR[4:Appoggio]=PR[1:Appoggio] ;
  38:  PR[4,3:Appoggio]=PR[2,3:Appoggio]+R[126:Dim.Z Prod]+800 ;
  39:   ;
  40:  CALL PR2P_MUL(1,1,'S01_PR_CASE',4) ;
  41:   ;
  42:  CALL PR2P_MUL(4,4,'S03_PALPLACE',1) ;
  43:  CALL PR2P_MUL(3,3,'S03_PALPLACE',1) ;
  44:   ;
  45:  CALL PR2P_MUL(4,4,'S03_PALPL_A',1) ;
  46:  CALL PR2P_MUL(3,3,'S03_PALPL_A',1) ;
  47:   ;
  48:  CALL PR2P_MUL(4,4,'S04_PALPL_B',1) ;
  49:  CALL PR2P_MUL(3,3,'S04_PALPL_B',1) ;
  50:   ;
  51:  CALL PR2P_MUL(3,3,'S10_DEP_INT',1) ;
  52:  CALL PR2P_MUL(3,3,'S10_DEP_INTA',1) ;
  53:  CALL PR2P_MUL(3,3,'S11_DEP_INTB',1) ;
  54:   ;
  55:  END ;
  56:  LBL[1001:Wrong R909] ;
  57:  MESSAGE[...] ;
  58:  MESSAGE[...IMPOSTARE R[909]....] ;
  59:  MESSAGE[....FILO FISSO ALIM....] ;
  60:  MESSAGE[....1 SX...............] ;
  61:  MESSAGE[....2 CENTRALE.........] ;
  62:  MESSAGE[....3 DX...............] ;
  63:  MESSAGE[...] ;
  64:  CALL ABORT ;
  65:   ;
  66:  UFRAME_NUM=9 ;
  67:  UTOOL_NUM=2 ;
  68:  J P[100:Zero] 1% FINE ;
  69:   ;
/POS
P[100:Zero]  UF:0 UT:2  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
