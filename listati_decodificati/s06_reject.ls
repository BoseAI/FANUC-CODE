/PROG S06_REJECT
   1:   ;
   2:  IF R[1:RobotStatus]=0, JMP LBL[6] ;
   3:  IF R[1:RobotStatus]=1001, JMP LBL[98] ;
   4:  IF R[1:RobotStatus]=1007, JMP LBL[100] ;
   5:  IF R[1:RobotStatus]=1008, JMP LBL[100] ;
   6:  IF R[1:RobotStatus]=1013, JMP LBL[98] ;
   7:  IF R[1:RobotStatus]=1017, JMP LBL[98] ;
   8:  IF R[1:RobotStatus]=1018, JMP LBL[98] ;
   9:   ;
  10:  JMP LBL[98] ;
  11:  LBL[6] ;
  12:   ;
  13:  OVERRIDE=R[3:SpeedWithProd] ;
  14:   ;
  15:  UFRAME_NUM=9 ;
  16:  UTOOL_NUM=1 ;
  17:  COL DETECT ON ;
  18:   ;
  19:  PR[9:Appoggio]=LPOS ;
  20:  R[97:Appoggio]=PR[9,1:Appoggio] ;
  21:  R[96:Appoggio]=PR[9,2:Appoggio] ;
  22:  R[95:Appoggio]=PR[9,3:Appoggio] ;
  23:   ;
  24:  IF R[97:Appoggio]<520, JMP LBL[2] ;
  25:  ! Robot in zona Pallet ;
  26:   ;
  27:  IF R[95:Appoggio]>100, JMP LBL[20] ;
  28:   ;
  29:  PR[9,3:Appoggio]=100 ;
  30:  L PR[9:Appoggio] 2000mm/sec FINE ;
  31:   ;
  32:  LBL[20] ;
  33:   ;
  34:  IF R[96:Appoggio]>0, JMP LBL[4] ;
  35:  ! Robot in zona Pallet A ;
  36:   ;
  37:  J P[20:ExitPalletA] 100% FINE ;
  38:   ;
  39:  JMP LBL[3] ;
  40:  LBL[4] ;
  41:  ! Robot in zona Pallet B ;
  42:   ;
  43:  J P[30:ExitPalletB] 100% FINE ;
  44:   ;
  45:  JMP LBL[3] ;
  46:  LBL[2] ;
  47:  ! Robot in zona Pickup Case ;
  48:   ;
  49:  IF R[95:Appoggio]>100, JMP LBL[3] ;
  50:   ;
  51:  PR[9,3:Appoggio]=200 ;
  52:  L PR[9:Appoggio] 2000mm/sec FINE ;
  53:   ;
  54:  LBL[3] ;
  55:   ;
  56:  R[1:RobotStatus]=6 ;
  57:   ;
  58:  IF R[907:PosScarto]=1, JMP LBL[100] ;
  59:   ;
  60:  UFRAME[5]=PR[186:Frame Scarto+OFF] ;
  61:  UFRAME_NUM=5 ;
  62:  UTOOL[2]=PR[182:Tool A+B] ;
  63:  UTOOL_NUM=2 ;
  64:   ;
  65:  PR[55:Centro Pallet]=P[5:0Pallet_NUT] ;
  66:  PR[55,1:Centro Pallet]=150 ;
  67:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]*0.4 ;
  68:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
  69:   ;
  70:  ! IF NEEDED,RAISE TO 55,3 ;
  71:  PR[54:OutObstruction Z]=LPOS ;
  72:  PR[54,1:OutObstruction Z]=-200 ;
  73:  PR[54,2:OutObstruction Z]=-720 ;
  74:  PR[54,3:OutObstruction Z]=PR[55,3:Centro Pallet] ;
  75:  J PR[54:OutObstruction Z] 100% CNT80 ;
  76:   ;
  77:  ! CORRECT PR55 TO HAVE ;
  78:  ! MINIMUM J6 MOVEMENT ;
  79:  CALL CORR_ANG(54,55) ;
  80:   ;
  81:  J PR[55:Centro Pallet] 80% CNT100 ;
  82:  DO[78:Out Obstruction PickUp]=ON ;
  83:   ;
  84:  LBL[100] ;
  85:   ;
  86:  UFRAME[5]=PR[186:Frame Scarto+OFF] ;
  87:  UFRAME_NUM=5 ;
  88:  UTOOL[2]=PR[182:Tool A+B] ;
  89:  UTOOL_NUM=2 ;
  90:   ;
  91:  R[1:RobotStatus]=6 ;
  92:   ;
  93:  L P[3:EntrReject] 2000mm/sec CNT5 ;
  94:  L P[2:AvvReject] 2000mm/sec CNT3 ;
  95:  WAIT R[10:RqRobotMission]=106 OR R[20:TEST]=1 ;
  96:   ;
  97:  L P[1:PosReject] 2000mm/sec FINE ;
  98:   ;
  99:  ! Rilascio Pacco ;
 100:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
 101:   ;
 102:  IF DI[58:No Load Run]=ON, JMP LBL[45] ;
 103:  IF R[106:Sel_TipoAsp]=2, JMP LBL[41] ;
 104:   ;
 105:  SELECT R[57:TipoDepCorrente]=0, JMP LBL[41] ;
 106:         =2, JMP LBL[42] ;
 107:         =3, JMP LBL[43] ;
 108:   ;
 109:  LBL[41] ;
 110:  CALL ASPA_OFF ;
 111:  CALL ASPB_OFF ;
 112:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
 113:  JMP LBL[45] ;
 114:   ;
 115:  LBL[42] ;
 116:  CALL ASPA_OFF ;
 117:  WAIT DI[34:CaseReleaseChA]=ON ;
 118:  JMP LBL[45] ;
 119:   ;
 120:  LBL[43] ;
 121:  CALL ASPB_OFF ;
 122:  WAIT DI[38:CaseReleaseChB]=ON ;
 123:  JMP LBL[45] ;
 124:   ;
 125:  LBL[45] ;
 126:   ;
 127:  OVERRIDE=R[2:NoProductSpeed] ;
 128:   ;
 129:  L P[3:EntrReject] 2000mm/sec CNT100 ;
 130:   ;
 131:  R[1:RobotStatus]=206 ;
 132:  LBL[103] ;
 133:  IF R[10:RqRobotMission]=206, JMP LBL[102] ;
 134:  IF R[10:RqRobotMission]=306, JMP LBL[101] ;
 135:  ! modifed for 8154 ;
 136:  //JMP LBL[103] ;
 137:   ;
 138:  LBL[102] ;
 139:   ;
 140:  IF R[907:PosScarto]=1, JMP LBL[101] ;
 141:   ;
 142:  UFRAME[5]=PR[189:Frame P_B+Off] ;
 143:  UFRAME_NUM=5 ;
 144:  UTOOL[2]=PR[182:Tool A+B] ;
 145:  UTOOL_NUM=2 ;
 146:   ;
 147:  J PR[55:Centro Pallet] 80% CNT100 ;
 148:  DO[70:Out Obstruction Pallet B]=ON ;
 149:   ;
 150:  J PR[54:OutObstruction Z] 80% CNT100 ;
 151:   ;
 152:  LBL[101] ;
 153:   ;
 154:  R[1:RobotStatus]=1006 ;
 155:  END ;
 156:   ;
 157:  LBL[98] ;
 158:  MESSAGE[..................] ;
 159:  MESSAGE[..SEQUENCE ERROR..] ;
 160:  MESSAGE[..Status <> 0..] ;
 161:  MESSAGE[..Status <> 1001..] ;
 162:  MESSAGE[..Status <> 1007..] ;
 163:  MESSAGE[..Status <> 1008..] ;
 164:  MESSAGE[..Status <> 1013..] ;
 165:  MESSAGE[..Program Aborted.] ;
 166:  MESSAGE[..................] ;
 167:  CALL ABORT ;
 168:   ;
 169:  LBL[99] ;
 170:  CALL ABORT ;
 171:   ;
 172:   ;
/POS
P[1:PosReject]  UF:5 UT:2  X=-196.5 Y=0.0 Z=255.5 W=-180.0 P=0.0 R=180.0
P[2:AvvReject]  UF:5 UT:2  X=-196.5 Y=0.0 Z=285.5 W=-180.0 P=0.0 R=180.0
P[3:EntrReject]  UF:5 UT:2  X=-196.5 Y=0.0 Z=1055.5 W=-180.0 P=0.0 R=180.0
P[5:0Pallet_NUT]  UF:5 UT:1  X=0.0 Y=0.0 Z=0.0 W=-180.0 P=0.0 R=0.0
P[20:ExitPalletA]  UF:9 UT:1  X=700.0 Y=-320.0 Z=250.0 W=180.0 P=0.0 R=0.0
P[30:ExitPalletB]  UF:9 UT:1  X=700.0 Y=320.0 Z=250.0 W=180.0 P=0.0 R=0.0
