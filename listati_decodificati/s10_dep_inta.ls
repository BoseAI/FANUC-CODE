/PROG S10_DEP_INTA
   1:   ;
   2:  IF R[1:RobotStatus]=1005, JMP LBL[3] ;
   3:  JMP LBL[98] ;
   4:   ;
   5:  LBL[3] ;
   6:   ;
   7:  UFRAME[5]=PR[189:Frame P_B+Off] ;
   8:  UFRAME_NUM=5 ;
   9:  UTOOL_NUM=3 ;
  10:  OVERRIDE=R[3:SpeedWithProd] ;
  11:  R[1:RobotStatus]=10 ;
  12:   ;
  13:  ! IF NEEDED,RAISE TO 55,3 ;
  14:  ! R[99:  High out obstruct ;
  15:  PR[54:OutObstruction Z]=LPOS ;
  16:  PR[54,1:OutObstruction Z]=0 ;
  17:  PR[54,3:OutObstruction Z]=PR[55,3:Centro Pallet] ;
  18:  PR[54,4:OutObstruction Z]=180 ;
  19:  L PR[54:OutObstruction Z] 2000mm/sec CNT100 ;
  20:  L PR[55:Centro Pallet] 2000mm/sec CNT100 ;
  21:   ;
  22:  UFRAME[5]=PR[192:Frame P_A+Off] ;
  23:  UFRAME_NUM=5 ;
  24:  UTOOL_NUM=3 ;
  25:   ;
  26:  ! NO MODIFIY CNT50 ;
  27:  L PR[55:Centro Pallet] 2000mm/sec CNT50 ;
  28:   ;
  29:   ;
  30:  DO[69:Out Obstruction Pallet A]=OFF ;
  31:   ;
  32:  WAIT R[10:RqRobotMission]=110 OR R[20:TEST]=1 ;
  33:  PR[54:OutObstruction Z]=PR[55:Centro Pallet] ;
  34:  PR[44,6:Deposito Intl]=PR[54,6:OutObstruction Z] ;
  35:  PR[45,6:Avvic Dep Intl]=PR[54,6:OutObstruction Z] ;
  36:  ! NO MODIFIY CNT80 ;
  37:  L PR[45:Avvic Dep Intl] 2000mm/sec CNT80 ;
  38:  DO[44:Rq Inib All Prel Cartone]=OFF ;
  39:   ;
  40:  L PR[44:Deposito Intl] 2000mm/sec CNT0 ;
  41:   ;
  42:  IF DI[58:No Load Run]=ON, JMP LBL[225] ;
  43:  IF R[106:Sel_TipoAsp]=0, JMP LBL[221] ;
  44:  SELECT R[114:Sel_InterTipoAsp]=2, JMP LBL[21] ;
  45:         =3, JMP LBL[22] ;
  46:         =0, JMP LBL[23] ;
  47:   ;
  48:  LBL[221] ;
  49:  CALL ASPA_OFF ;
  50:  WAIT DI[34:CaseReleaseChA]=ON OR R[20:TEST]=1 ;
  51:  JMP LBL[225] ;
  52:   ;
  53:  LBL[222] ;
  54:  CALL ASPB_OFF ;
  55:  WAIT DI[38:CaseReleaseChB]=ON OR R[20:TEST]=1 ;
  56:  JMP LBL[225] ;
  57:   ;
  58:  LBL[223] ;
  59:  CALL ASPA_OFF ;
  60:  CALL ASPB_OFF ;
  61:  IF R[20:TEST]=1, JMP LBL[225] ;
  62:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
  63:  JMP LBL[225] ;
  64:   ;
  65:  LBL[225] ;
  66:   ;
  67:  R[30:RqIntlTopPallet]=0 ;
  68:   ;
  69:  R[43]=2 ;
  70:  CALL V_CNT_P ;
  71:  R[25:IntlHeight]=R[25:IntlHeight]+R[136:IntlThickness] ;
  72:   ;
  73:  L PR[45:Avvic Dep Intl] 2000mm/sec CNT100 ;
  74:   ;
  75:  R[1:RobotStatus]=1010 ;
  76:  L PR[54:OutObstruction Z] 2000mm/sec CNT100 ;
  77:  IF R[902:CupsUP/DW Presen]=1, CALL CUPS_UP ;
  78:   ;
  79:  DO[69:Out Obstruction Pallet A]=ON ;
  80:   ;
  81:  ! WAIT CHANGE MISSION ;
  82:  ! FROM PLC ;
  83:  R[99:Appoggio]=0 ;
  84:  LBL[200] ;
  85:  IF R[10:RqRobotMission]=5, JMP LBL[990] ;
  86:  R[99:Appoggio]=R[99:Appoggio]+1 ;
  87:  IF R[99:Appoggio]>=20, JMP LBL[97] ;
  88:  IF DO[27:Rq Interlayer]=ON, JMP LBL[200] ;
  89:   ;
  90:   ;
  91:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  92:  UFRAME_NUM=5 ;
  93:  UTOOL[2]=PR[182:Tool A+B] ;
  94:  UTOOL_NUM=2 ;
  95:  ! PR54=PREL_PROD ENTRY ;
  96:  ! POINT AT ACTUAL HEIGHT ;
  97:  PR[1:Appoggio]=LPOS ;
  98:  PR[54:OutObstruction Z]=P[3:EntrPrelProd] ;
  99:  R[98:Appoggio]=PR[1,3:Appoggio] ;
 100:  R[99:Appoggio]=PR[54,3:OutObstruction Z] ;
 101:  IF R[98:Appoggio]<=R[99:Appoggio], JMP LBL[120] ;
 102:  PR[54,3:OutObstruction Z]=R[98:Appoggio] ;
 103:  LBL[120] ;
 104:  ! NECESSARY J[PR54: ;
 105:  ! FOR RETURN IN INTERVAL ;
 106:  ! 180..-180 ;
 107:  J PR[54:OutObstruction Z] 100% CNT100 ;
 108:   ;
 109:  END ;
 110:   ;
 111:  LBL[97] ;
 112:  MESSAGE[..................] ;
 113:  MESSAGE[..SEQUENCE ERROR..] ;
 114:  MESSAGE[..INTERLAYER FROM ] ;
 115:  MESSAGE[..DEP INT A..] ;
 116:  CALL ABORT ;
 117:   ;
 118:  LBL[98] ;
 119:  MESSAGE[..................] ;
 120:  MESSAGE[..SEQUENCE ERROR..] ;
 121:  MESSAGE[..Status <> 1005 ..] ;
 122:  MESSAGE[..Program Aborted.] ;
 123:  MESSAGE[..................] ;
 124:  CALL ABORT ;
 125:   ;
 126:  ! OUT OBSTRUCTION ;
 127:  ! FOR PICKUP INTERLAYER ;
 128:  LBL[990] ;
 129:  R[1:RobotStatus]=R[1:RobotStatus]+900 ;
 130:   ;
 131:  OVERRIDE=R[2:NoProductSpeed] ;
 132:   ;
 133:  ! IF NEEDED,RAISE TO 55,3 ;
 134:  PR[54:OutObstruction Z]=LPOS ;
 135:  PR[54,1:OutObstruction Z]=0 ;
 136:  PR[54,2:OutObstruction Z]=R[108:Dim.Y Pallet]*0.4 ;
 137:  PR[54,3:OutObstruction Z]=R[682:OutObstruInt] ;
 138:  L PR[54:OutObstruction Z] 2000mm/sec CNT50 ;
 139:   ;
 140:  UFRAME[5]=PR[189:Frame P_B+Off] ;
 141:  UFRAME_NUM=5 ;
 142:  UTOOL[2]=PR[182:Tool A+B] ;
 143:  UTOOL_NUM=2 ;
 144:   ;
 145:  ! IF NEEDED,RAISE TO 55,3 ;
 146:  PR[54:OutObstruction Z]=LPOS ;
 147:  PR[54,1:OutObstruction Z]=0 ;
 148:  PR[54,2:OutObstruction Z]=R[108:Dim.Y Pallet]*0.4 ;
 149:  PR[54,3:OutObstruction Z]=R[682:OutObstruInt] ;
 150:  L PR[54:OutObstruction Z] 2000mm/sec CNT50 ;
 151:   ;
 152:  UFRAME[5]=PR[184:Frame Intlr+OFF] ;
 153:   ;
 154:  UFRAME_NUM=5 ;
 155:  UTOOL_NUM=3 ;
 156:   ;
 157:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
