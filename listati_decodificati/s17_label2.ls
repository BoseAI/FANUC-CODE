/PROG S17_LABEL2
   1:   ;
   2:  ! Verifico da quale ciclo ;
   3:  ! proviene il robot e ;
   4:  ! scelgo la traiettoria ;
   5:  ! di conseguenza ;
   6:   ;
   7:  IF R[1:RobotStatus]=1001, JMP LBL[1] ;
   8:   ;
   9:  IF R[1:RobotStatus]=1007, JMP LBL[1] ;
  10:   ;
  11:   ;
  12:   ;
  13:  IF R[1:RobotStatus]=1008, JMP LBL[1] ;
  14:   ;
  15:  ! Non vengo da nessuno ;
  16:  ! dei cicli validi ;
  17:  ! Segnalazione allarme ;
  18:  JMP LBL[98] ;
  19:   ;
  20:   ;
  21:  LBL[1] ;
  22:   ;
  23:  UFRAME[5]=PR[178:LayerB Prod59] ;
  24:  UFRAME_NUM=5 ;
  25:  UTOOL_NUM=2 ;
  26:  R[1:RobotStatus]=17 ;
  27:  PR[9:Appoggio]=P[1:Label Done] ;
  28:  CALL ALIGNROT ;
  29:   ;
  30:  DO[79:Out Obstruction Labeller]=OFF ;
  31:  L P[2:Avv Label Done] 2000mm/sec CNT10 ;
  32:   ;
  33:  L P[1:Label Done] 2000mm/sec CNT10 ;
  34:  R[1:RobotStatus]=117 ;
  35:  WAIT R[10:RqRobotMission]=117 OR R[20:TEST]=1 ;
  36:   ;
  37:  IF DI[41:SelLabelSpreadingPath]=OFF, JMP LBL[200] ;
  38:  ! Ciclo spalmatura ;
  39:  ! Da realizzare ;
  40:  LBL[200] ;
  41:   ;
  42:   ;
  43:  R[1:RobotStatus]=1017 ;
  44:  DO[79:Out Obstruction Labeller]=ON ;
  45:   ;
  46:  END ;
  47:  LBL[98] ;
  48:  MESSAGE[..................] ;
  49:  MESSAGE[..SEQUENCE ERROR..] ;
  50:  MESSAGE[..S17_LABEL2..] ;
  51:  MESSAGE[..Status <> 1008 ..] ;
  52:  CALL ABORT ;
  53:   ;
  54:   ;
  55:  LBL[99] ;
  56:  CALL ABORT ;
  57:   ;
/POS
P[1:Label Done]  UF:5 UT:2  X=-122.4 Y=81.0 Z=102.0 W=-180.0 P=0.0 R=300.0
P[2:Avv Label Done]  UF:5 UT:2  X=377.6 Y=101.0 Z=102.0 W=-180.0 P=0.0 R=300.0
