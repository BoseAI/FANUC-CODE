/PROG GET_SIZE
   1:  ! Gestione cambio ;
   2:  ! formato ver 1.0 ;
   3:   ;
   4:   ;
   5:  ! R[41]=DI[24:PresPallet1Mag] ;
   6:   ;
   7:  ! DO[23:Change_size_in_progress] ;
   8:   ;
   9:   ;
  10:  ! Leggo il numero ;
  11:  ! di set di dati da ;
  12:  ! memorizzare ;
  13:   ;
  14:  R[12:Data Flow In]=GI[1:Change_size_step_on] ;
  15:   ;
  16:  ! Codifica pacchetti: ;
  17:  ! 1-4  : dati sistema robot ;
  18:  ! 5-8  : dati formato robot ;
  19:  ! 9-13 : tipi prelievi/depositi st ;
  20:  ! 14-18: tipi prelievi/depositi st ;
  21:  ! 19-33: posizioni e rotazioni dep ;
  22:  ! 34-36: Dati formato robot ;
  23:   ;
  24:  IF R[12:Data Flow In]>37, JMP LBL[2] ;
  25:   ;
  26:  R[99:Appoggio]=R[12:Data Flow In]-R[13:Handshake] ;
  27:   ;
  28:  IF R[99:Appoggio]<=0, JMP LBL[1] ;
  29:  IF R[99:Appoggio]>1, JMP LBL[3] ;
  30:   ;
  31:  IF R[12:Data Flow In]>=1 AND R[12:Data Flow In]<=18, CALL GET_DAT ;
  32:  IF R[12:Data Flow In]>=19 AND R[12:Data Flow In]<=33, CALL PAL_DATA ;
  33:  IF R[12:Data Flow In]>=34, CALL GET_DAT ;
  34:   ;
  35:  R[13:Handshake]=R[12:Data Flow In] ;
  36:   ;
  37:  JMP LBL[1] ;
  38:   ;
  39:   ;
  40:   ;
  41:  LBL[3:Errore di comm.] ;
  42:  MESSAGE[...] ;
  43:  MESSAGE[...] ;
  44:  MESSAGE[...] ;
  45:  MESSAGE[...] ;
  46:  MESSAGE[......ERRORE COMUNICAZI] ;
  47:  MESSAGE[............] ;
  48:  MESSAGE[...] ;
  49:  MESSAGE[...] ;
  50:  MESSAGE[...] ;
  51:  CALL ABORT ;
  52:   ;
  53:  LBL[2:Dati trasferiti] ;
  54:   ;
  55:  ! Memorizzazione Dati ;
  56:  ! IF R[12:Data Flow In]=32 AND D ;
  57:   ;
  58:  ! Estrazione Interlayers ;
  59:  ! IF R[12:Data Flow In]=15 AND D ;
  60:   ;
  61:  R[13:Handshake]=0 ;
  62:   ;
  63:   ;
  64:   ;
  65:  LBL[1:Fine scansione] ;
