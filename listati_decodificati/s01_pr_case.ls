/PROG S01_PR_CASE
   1:   ;
   2:  UTOOL[2]=PR[182:Tool A+B] ;
   3:   ;
   4:  OVERRIDE=R[2:NoProductSpeed] ;
   5:   ;
   6:  IF R[1:RobotStatus]=0, JMP LBL[3] ;
   7:  IF R[1:RobotStatus]=1014, JMP LBL[3] ;
   8:  IF R[1:RobotStatus]=1016, JMP LBL[3] ;
   9:  IF R[1:RobotStatus]=1003, JMP LBL[3] ;
  10:  IF R[1:RobotStatus]=1004, JMP LBL[3] ;
  11:  IF R[1:RobotStatus]=1006, JMP LBL[2] ;
  12:  IF R[1:RobotStatus]=1010, JMP LBL[3] ;
  13:  IF R[1:RobotStatus]=1011, JMP LBL[2] ;
  14:  IF R[1:RobotStatus]=1012, JMP LBL[2] ;
  15:  IF R[1:RobotStatus]=1021, JMP LBL[7] ;
  16:   ;
  17:  JMP LBL[98] ;
  18:   ;
  19:  LBL[7] ;
  20:  ! Arrivo da zona PeP ;
  21:  UFRAME_NUM=9 ;
  22:  UTOOL_NUM=1 ;
  23:   ;
  24:  J P[10:UscitaPeP] 100% CNT100 ;
  25:   ;
  26:  J PR[50:ZeroPos Robot] 100% CNT100 ;
  27:   ;
  28:  JMP LBL[3] ;
  29:   ;
  30:  LBL[2] ;
  31:  UFRAME_NUM=9 ;
  32:  UTOOL_NUM=1 ;
  33:  J PR[50:ZeroPos Robot] 100% CNT100 ;
  34:   ;
  35:  LBL[3] ;
  36:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  37:  UFRAME_NUM=5 ;
  38:  UTOOL_NUM=2 ;
  39:   ;
  40:  R[1:RobotStatus]=1 ;
  41:  J P[3:EntrPrelProd] 100% CNT100 ;
  42:   ;
  43:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
  44:  IF R[902:CupsUP/DW Presen]=1, CALL CUPS_UP ;
  45:  L P[2:Avv Z PrelProd] 2000mm/sec CNT100 ;
  46:  DO[78:Out Obstruction PickUp]=ON ;
  47:   ;
  48:  LBL[6:WaitConsPickUp] ;
  49:  IF R[56:TipoPrelCorrente]<>1, JMP LBL[47] ;
  50:  R[56:TipoPrelCorrente]=R[57:TipoDepCorrente] ;
  51:  LBL[47] ;
  52:  IF R[10:RqRobotMission]<>101 AND R[20:TEST]<>1, JMP LBL[6] ;
  53:   ;
  54:  R[1:RobotStatus]=101 ;
  55:  DO[78:Out Obstruction PickUp]=OFF ;
  56:  DO[44:Rq Inib All Prel Cartone]=ON ;
  57:   ;
  58:  LBL[5:WAIT Attuatori] ;
  59:  IF DI[35:Grippers opened]=OFF AND R[901:Pinze Presenti]=1, JMP LBL[5] ;
  60:  IF DI[63:Cups UP]=OFF AND R[902:CupsUP/DW Presen]=1, JMP LBL[5] ;
  61:   ;
  62:  R[26:RqCtrlTorqueInfe]=0 ;
  63:  IF R[26:RqCtrlTorqueInfe]=0, JMP LBL[4] ;
  64:   ;
  65:  L P[2:Avv Z PrelProd] 2000mm/sec CNT10 ;
  66:  F[99]=(OFF) ;
  67:  PR[1:Appoggio]=P[1:PrelProd] ;
  68:  PR[2:Appoggio]=P[2:Avv Z PrelProd] ;
  69:  CALL CTRL_N(1,2,1,R[482:TorqueToll Intl],2,50,800) ;
  70:  IF (F[100]=OFF), JMP LBL[100] ;
  71:   ;
  72:  LBL[4:No CHK torque] ;
  73:  L P[1:PrelProd] 2000mm/sec CNT0 <opz.EE> <opz.F4> ;
  74:   ;
  75:  IF DI[58:No Load Run]=ON, JMP LBL[1] ;
  76:   ;
  77:  IF R[106:Sel_TipoAsp]=2, JMP LBL[200] ;
  78:   ;
  79:  IF R[56:TipoPrelCorrente]=0 OR R[56:TipoPrelCorrente]=2, CALL ASPA_ON ;
  80:  IF R[56:TipoPrelCorrente]=0 OR R[56:TipoPrelCorrente]=3, CALL ASPB_ON ;
  81:  JMP LBL[1] ;
  82:  LBL[200] ;
  83:  CALL ASPA_ON ;
  84:  CALL ASPB_ON ;
  85:  LBL[1] ;
  86:   ;
  87:  DO[44:Rq Inib All Prel Cartone]=OFF ;
  88:  IF DI[58:No Load Run]=ON, JMP LBL[25] ;
  89:   ;
  90:  SELECT R[56:TipoPrelCorrente]=0, JMP LBL[21] ;
  91:         =2, JMP LBL[22] ;
  92:         =3, JMP LBL[23] ;
  93:   ;
  94:  LBL[21] ;
  95:  WAIT (DI[33:CasePickUpChA]=ON AND DI[37:CasePickUpChB]=ON) ;
  96:  JMP LBL[25] ;
  97:   ;
  98:  LBL[22] ;
  99:  WAIT DI[33:CasePickUpChA]=ON ;
 100:  JMP LBL[25] ;
 101:   ;
 102:  LBL[23] ;
 103:  WAIT DI[37:CasePickUpChB]=ON ;
 104:  JMP LBL[25] ;
 105:   ;
 106:  LBL[25] ;
 107:   ;
 108:  IF R[901:Pinze Presenti]=0, JMP LBL[300] ;
 109:  IF R[902:CupsUP/DW Presen]=1, JMP LBL[300] ;
 110:  CALL GRIP_CL ;
 111:  WAIT DI[36:Grippers Closed]=ON ;
 112:  LBL[300] ;
 113:   ;
 114:  OVERRIDE=R[3:SpeedWithProd] ;
 115:   ;
 116:  IF DI[55:CheckFlapsEnable]=OFF, JMP LBL[500] ;
 117:  ! Check Lower Flaps ;
 118:  SKIP CONDITION DI[513:B24Lower Flap Closed CHK]=OFF ;
 119:  PR[1:Appoggio]=P[100:Zero] ;
 120:  PR[1,3:Appoggio]=40 ;
 121:  L P[1:PrelProd] 1000mm/sec CNT5 Offset,PR[1:Appoggio] Skip,LBL[501] ACC100 ;
 122:  LBL[500] ;
 123:   ;
 124:  L P[2:Avv Z PrelProd] 2000mm/sec CNT100 <opz.F4> ;
 125:   ;
 126:  CALL NEXT_STEP ;
 127:  R[37:=1 PhCaseInHead]=1 ;
 128:   ;
 129:  L P[4:UscPrelProd] 2000mm/sec CNT100 ;
 130:   ;
 131:  DO[78:Out Obstruction PickUp]=ON ;
 132:   ;
 133:  R[1:RobotStatus]=1001 ;
 134:   ;
 135:  END ;
 136:   ;
 137:  LBL[98] ;
 138:  MESSAGE[..................] ;
 139:  MESSAGE[..SEQUENCE ERROR..] ;
 140:  MESSAGE[..Status <> 0 ..] ;
 141:  MESSAGE[..Status <> 1003 ..] ;
 142:  MESSAGE[..Status <> 1004 ..] ;
 143:  MESSAGE[..Status <> 1006 ..] ;
 144:  MESSAGE[..Status <> 1010 ..] ;
 145:  MESSAGE[..Status <> 1011 ..] ;
 146:  MESSAGE[..Status <> 1012 ..] ;
 147:  MESSAGE[..Status <> 1014 ..] ;
 148:  MESSAGE[..Status <> 1016 ..] ;
 149:  MESSAGE[..Status <> 1021 ..] ;
 150:  MESSAGE[..Program Aborted.] ;
 151:  MESSAGE[..................] ;
 152:  CALL ABORT ;
 153:   ;
 154:  LBL[99] ;
 155:  CALL ABORT ;
 156:  END ;
 157:   ;
 158:  LBL[100:CollisionDet] ;
 159:  MESSAGE[..................] ;
 160:  MESSAGE[....COLLISION.....] ;
 161:  MESSAGE[....DETECTED......] ;
 162:  MESSAGE[..................] ;
 163:  DO[45:Torque alarm]=PULSE,0.3sec ;
 164:  ! CALL ABORT ;
 165:  END ;
 166:   ;
 167:  LBL[501] ;
 168:  MESSAGE[..................] ;
 169:  MESSAGE[...LOWER FLAPS....] ;
 170:  MESSAGE[......OPENED......] ;
 171:  DO[54:LowerFlapError]=PULSE,3.0sec ;
 172:  WAIT 1.00(sec) ;
 173:  END ;
 174:   ;
/POS
P[1:PrelProd]  UF:5 UT:2  X=-196.5 Y=-158.0 Z=255.5 W=-180.0 P=0.0 R=180.0
P[2:Avv Z PrelProd]  UF:5 UT:2  X=-196.5 Y=-158.0 Z=555.5 W=-180.0 P=0.0 R=180.0
P[3:EntrPrelProd]  UF:5 UT:2  X=-196.5 Y=-158.0 Z=1100.0 W=-180.0 P=0.0 R=180.0
P[4:UscPrelProd]  UF:5 UT:2  X=-196.5 Y=-158.0 Z=1355.5 W=-180.0 P=0.0 R=180.0
P[10:UscitaPeP]  UF:9 UT:1  X=-1500.0 Y=-200.0 Z=200.0 W=-180.0 P=0.0 R=0.0
P[100:Zero]  UF:5 UT:2  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
