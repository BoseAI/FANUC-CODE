/PROG MEM_DATI
   1:   ;
   2:  ! PR[200: Save Frame9 ;
   3:  PR[200:Save Frame9]=UFRAME[9] ;
   4:  PR[200,12:Save Frame9]=R[460:ZFloor] ;
   5:  ! Frame for Pick&Place ;
   6:  UFRAME[8]=PR[200:Save Frame9] ;
   7:   ;
   8:  PR[200:Save Frame9]=UFRAME[9] ;
   9:   ;
  10:  PR[197:UTool1 AUX]=P[100:Zero] ;
  11:  PR[197,1:UTool1 AUX]=R[192:OffXTool] ;
  12:  PR[197,2:UTool1 AUX]=R[193:OffYTool] ;
  13:  PR[197,3:UTool1 AUX]=R[194:OffZTool] ;
  14:  PR[197,4:UTool1 AUX]=R[195:OffWTool] ;
  15:  PR[197,5:UTool1 AUX]=R[196:OffPTool] ;
  16:  PR[197,6:UTool1 AUX]=R[197:OffRTool] ;
  17:  CALL CAL_TOOL(197,197) ;
  18:  UTOOL[1]=PR[197:UTool1 AUX] ;
  19:   ;
  20:  ! R[900:Tipo Macchina] ;
  21:  !       =1 CP+MINIFLEX ;
  22:  !       =2 FLEX ;
  23:  !       =3 FLEX 2P ;
  24:  !       =4 MINIFLEX ;
  25:  !       =5 NO PAL ;ò ;
  26:  R[900:Tipo Macchina]=3 ;
  27:   ;
  28:  ! R[901:Pinze Presenti] ;
  29:  !       =0 Assente ;
  30:  !       =1 Presente ;
  31:  R[901:Pinze Presenti]=0 ;
  32:   ;
  33:  ! R[902:VentoseUP/DN Presenti] ;
  34:  !       =0 Assente ;
  35:  !       =1 Presente ;
  36:  R[902:CupsUP/DW Presen]=0 ;
  37:   ;
  38:  ! R[903:FixedWirePick_1] ;
  39:  !       =1 FILO FISSO SX ;
  40:  !       =2 FILO FISSO CENTRALE ;
  41:  !       =3 FILO FISSO DX ;
  42:  R[903:FixedWirePick_1]=1 ;
  43:   ;
  44:  ! R[909:FixedWirePick_2] ;
  45:  !       =1 FILO FISSO SX ;
  46:  !       =2 FILO FISSO CENTRALE ;
  47:  !       =3 FILO FISSO DX ;
  48:  R[909:FixedWirePick_2]=3 ;
  49:   ;
  50:  ! R[904:FiloFissoPallet ] ;
  51:  !       =1 FILO FISSO DX ;
  52:  !       =2 FILO FISSO CENTRALE ;
  53:  !       =3 FILO FISSO SX ;
  54:  R[904:FiloFissoPallet]=3 ;
  55:   ;
  56:   ;
  57:  ! R[905:Label Present] ;
  58:  !       =0 Assente ;
  59:  !       =1 Presente ;
  60:  R[905:Label Present]=0 ;
  61:   ;
  62:   ;
  63:  ! R[906:M710/M20] ;
  64:  !       =1 M710 ;
  65:  !       =2 M20 ;
  66:  !       =3 M20 35kg ;
  67:  R[906:M710/M20]=3 ;
  68:   ;
  69:   ;
  70:  ! R[907:Pos Rulliera Scarto] ;
  71:  !       =1 Lato prelievo cassa ;
  72:  !       =2 Lato opp prelievo cassa ;
  73:  R[907:PosScarto]=1 ;
  74:   ;
  75:  ! R[908: Pos RullieraSampling] ;
  76:  !       =1 Lato prelievo cassa ;
  77:  !       =2 Lato opp prelievo cassa ;
  78:  !   		+ reject R[907=1 ;
  79:  !       =3 Lato opp prelievo cassa ;
  80:  !   		+ reject R[907=2 ;
  81:   ;
  82:  R[908:PosSampling]=1 ;
  83:  ! R[910: Tipologia Sampling] ;
  84:  !       =0 Box ;
  85:  !       =1 Rulliera ;
  86:  R[910:Type sampling]=0 ;
  87:   ;
  88:  ! R[911: Orientamento Buffer ;
  89:  !       =0 Bufferizzazione ;
  90:  !    parallela direzione uscita ;
  91:  !    pallet ;
  92:  !       =1 Bufferizzazione ;
  93:  !    perpendicolare direzione ;
  94:  !    uscita pallet ;
  95:  R[911:Rotation Buffer]=1 ;
  96:   ;
  97:  IF R[906:M710/M20]=1, CALL MEM_M710 ;
  98:  IF R[906:M710/M20]=2, CALL MEM_M20 ;
  99:  IF R[906:M710/M20]=3, CALL MEM_M20_35KG ;
 100:   ;
 101:  ! Case pick up point calc ;
 102:  IF R[106:Sel_TipoAsp]>0, JMP LBL[2] ;
 103:  R[135:NFilePresaB]=0 ;
 104:  LBL[2] ;
 105:   ;
 106:  IF DI[42:SelPick_2]=OFF, CALL CC_PREL_1 ;
 107:  IF DI[42:SelPick_2]=ON, CALL CC_PREL_2 ;
 108:   ;
 109:  ! Def.space1 ;
 110:  ! zona ingombro prelievo cassa ;
 111:  UFRAME[5]=PR[190:Frame PR+OFF] ;
 112:  CALL INV_PR(190,9) ;
 113:  $RSPACE1[1].$UFINV_POST=PR[9:Appoggio] ;
 114:  ! occorre impostare la var ;
 115:  ! $RSPACE1[1].$UFINV_POST ;
 116:  ! al valore inverso del ;
 117:  ! vettore del frame ;
 118:  $RSPACE1[1].$UFRAM_NUM=5 ;
 119:  $RSPACE1[1].$UTOOL_NUM=2 ;
 120:  R[99:Appoggio]=PR[1,1:Appoggio]-100 ;
 121:  $RSPACE1[1].$FIRST_VTEX[1]=R[99:Appoggio] ;
 122:  R[99:Appoggio]=PR[1,1:Appoggio]+100 ;
 123:  $RSPACE1[1].$SECND_VTEX[1]=R[99:Appoggio] ;
 124:  R[99:Appoggio]=PR[1,2:Appoggio]-100 ;
 125:  $RSPACE1[1].$FIRST_VTEX[2]=R[99:Appoggio] ;
 126:  R[99:Appoggio]=PR[1,2:Appoggio]+100 ;
 127:  $RSPACE1[1].$SECND_VTEX[2]=R[99:Appoggio] ;
 128:  R[99:Appoggio]=PR[1,3:Appoggio]-100 ;
 129:  $RSPACE1[1].$FIRST_VTEX[3]=R[99:Appoggio] ;
 130:  R[99:Appoggio]=PR[1,3:Appoggio]+R[126:Dim.Z Prod]+140 ;
 131:  ! Ctrl che l'altezza di fuori ingo ;
 132:  !  ad un minimo d'interferenza col ;
 133:  IF R[99:Appoggio]>500, JMP LBL[100] ;
 134:  R[99:Appoggio]=500 ;
 135:  LBL[100] ;
 136:  $RSPACE1[1].$SECND_VTEX[3]=R[99:Appoggio] ;
 137:   ;
 138:  ! Reject points su Ribaltatore ;
 139:  PR[4:Appoggio]=PR[1:Appoggio] ;
 140:   ;
 141:  PR[1,1:Appoggio]=PR[1,1:Appoggio]+R[500:OffsX Reject]-20 ;
 142:  PR[1,2:Appoggio]=PR[1,2:Appoggio]+R[501:OffsY Reject]-10 ;
 143:  PR[1,3:Appoggio]=PR[1,3:Appoggio]+R[502:OffsZ Reject] ;
 144:   ;
 145:  PR[2:Appoggio]=PR[1:Appoggio] ;
 146:   ;
 147:  PR[2,1:Appoggio]=PR[1,1:Appoggio]+R[666:OffAccRejectX] ;
 148:  PR[2,2:Appoggio]=PR[1,2:Appoggio]+R[667:OffAccRejectY] ;
 149:  PR[2,3:Appoggio]=PR[2,3:Appoggio]+R[668:OffAccRejectZ] ;
 150:   ;
 151:  PR[3:Appoggio]=PR[2:Appoggio] ;
 152:  PR[3,3:Appoggio]=PR[1,3:Appoggio]+R[681:Z AvvRejectt] ;
 153:   ;
 154:  CALL PR2P_MUL(1,1,'S16_REJ_RIB',3) ;
 155:   ;
 156:  ! Reject points su rulliera ;
 157:  ! Reject points zero X=> ;
 158:  !  Near carter of reject ;
 159:  ! Reject points zero Y=> ;
 160:  !  In middle of rolls ;
 161:  PR[4,1:Appoggio]=0 ;
 162:  PR[4,1:Appoggio]=R[133:NCasseInX]*R[124:Dim.X Prod]/-2 ;
 163:  PR[4,1:Appoggio]=PR[4,1:Appoggio]+R[500:OffsX Reject] ;
 164:  PR[4,2:Appoggio]=0 ;
 165:  PR[4,2:Appoggio]=PR[4,2:Appoggio]+R[501:OffsY Reject] ;
 166:  PR[4,3:Appoggio]=R[126:Dim.Z Prod] ;
 167:  PR[4,3:Appoggio]=PR[4,3:Appoggio]+R[502:OffsZ Reject] ;
 168:  PR[4,6:Appoggio]=180 ;
 169:   ;
 170:  PR[5:Appoggio]=PR[4:Appoggio] ;
 171:  PR[5,1:Appoggio]=PR[5,1:Appoggio]+R[666:OffAccRejectX] ;
 172:  PR[5,2:Appoggio]=PR[5,2:Appoggio]+R[667:OffAccRejectY] ;
 173:  PR[5,3:Appoggio]=PR[5,3:Appoggio]+R[668:OffAccRejectZ] ;
 174:   ;
 175:  PR[6:Appoggio]=PR[5:Appoggio] ;
 176:  PR[6,3:Appoggio]=PR[4,3:Appoggio]+R[681:Z AvvRejectt] ;
 177:   ;
 178:  CALL PR2P_MUL(4,1,'S06_REJECT',3) ;
 179:   ;
 180:  ! Punto Etichetta ;
 181:  IF R[905:Label Present]=1, CALL CC_LABEL1 ;
 182:  IF R[905:Label Present]=1, CALL CC_LABEL2 ;
 183:   ;
 184:  ! Punto Spalmatore ;
 185:  IF R[905:Label Present]=1, CALL CC_SPALM ;
 186:   ;
 187:  ! Punto Controllo Etichetta ;
 188:  IF R[905:Label Present]=1, CALL CC_LABCK1 ;
 189:  //IF R[905:Label Present]=1, CALL CC_LABCK2 ;
 190:   ;
 191:  ! Sampling points calc ;
 192:  IF (R[910:Type sampling]<>0) THEN ;
 193:  PR[1,1:Appoggio]=R[124:Dim.X Prod]/2 ;
 194:  ENDIF ;
 195:  PR[1,3:Appoggio]=R[126:Dim.Z Prod] ;
 196:  PR[1,1:Appoggio]=0-PR[1,1:Appoggio]+R[512:OffsX_DepSamp] ;
 197:  PR[1,2:Appoggio]=0-PR[1,2:Appoggio]+R[513:OffsY_DepSamp] ;
 198:  PR[1,3:Appoggio]=PR[1,3:Appoggio]+R[514:OffsZ_DepSamp] ;
 199:  PR[1,4:Appoggio]=-180 ;
 200:  PR[1,5:Appoggio]=0 ;
 201:  PR[1,6:Appoggio]=0 ;
 202:   ;
 203:  PR[2:Appoggio]=PR[1:Appoggio] ;
 204:  PR[2,3:Appoggio]=PR[2,3:Appoggio]+R[126:Dim.Z Prod]+150 ;
 205:   ;
 206:  PR[3:Appoggio]=PR[1:Appoggio] ;
 207:  PR[3,3:Appoggio]=R[126:Dim.Z Prod]+600 ;
 208:   ;
 209:  CALL PR2P_MUL(1,1,'S15_REWORK',3) ;
 210:  CALL PR2P_MUL(1,1,'S14_SAMPLING',3) ;
 211:   ;
 212:  ! CP+MINIFLEX ;
 213:  ! Punto Origine Buffer ;
 214:  F[10]=(OFF) ;
 215:  IF R[900:Tipo Macchina]=4, JMP LBL[13] ;
 216:   ;
 217:  PR[10:OrigineBuffer]=P[100:Zero] ;
 218:  PR[10,1:OrigineBuffer]=R[124:Dim.X Prod]/2 ;
 219:  PR[10,1:OrigineBuffer]=R[503:OffXBuffer]-PR[10,1:OrigineBuffer] ;
 220:  PR[10,2:OrigineBuffer]=R[125:Dim.Y Prod]/2 ;
 221:  PR[10,2:OrigineBuffer]=R[504:OffYBuffer]+PR[10,2:OrigineBuffer] ;
 222:  PR[10,3:OrigineBuffer]=R[126:Dim.Z Prod]+R[505:OffZBuffer] ;
 223:  PR[10,4:OrigineBuffer]=-180 ;
 224:  PR[10,5:OrigineBuffer]=0 ;
 225:  PR[10,6:OrigineBuffer]=0 ;
 226:  JMP LBL[12] ;
 227:   ;
 228:  LBL[13] ;
 229:  IF (R[124:Dim.X Prod]>R[463:X_BigCasexBuffer])F[10]=(ON) ;
 230:   ;
 231:  PR[10:OrigineBuffer]=P[100:Zero] ;
 232:  IF (F[10]), JMP LBL[14] ;
 233:  ! MINIFLEX ;
 234:  ! Punto Origine Buffer ;
 235:  ! Cartone Piccolo ;
 236:  PR[10,1:OrigineBuffer]=R[125:Dim.Y Prod]/2 ;
 237:  PR[10,1:OrigineBuffer]=R[503:OffXBuffer]+PR[10,1:OrigineBuffer] ;
 238:  PR[10,2:OrigineBuffer]=R[124:Dim.X Prod]/2 ;
 239:  PR[10,2:OrigineBuffer]=R[504:OffYBuffer]+PR[10,2:OrigineBuffer] ;
 240:  PR[10,3:OrigineBuffer]=R[126:Dim.Z Prod]+R[505:OffZBuffer] ;
 241:  PR[10,4:OrigineBuffer]=-180 ;
 242:  PR[10,5:OrigineBuffer]=0 ;
 243:  PR[10,6:OrigineBuffer]=90 ;
 244:  JMP LBL[12] ;
 245:   ;
 246:  LBL[14] ;
 247:  ! MINIFLEX ;
 248:  ! Punto Origine Buffer ;
 249:  ! Cartone Grande ;
 250:  PR[10,1:OrigineBuffer]=R[124:Dim.X Prod]/2 ;
 251:  PR[10,1:OrigineBuffer]=R[503:OffXBuffer]+PR[10,1:OrigineBuffer] ;
 252:  PR[10,2:OrigineBuffer]=R[125:Dim.Y Prod]/2 ;
 253:  PR[10,2:OrigineBuffer]=R[504:OffYBuffer]+PR[10,2:OrigineBuffer] ;
 254:  PR[10,3:OrigineBuffer]=R[126:Dim.Z Prod]+R[505:OffZBuffer] ;
 255:  PR[10,4:OrigineBuffer]=-180 ;
 256:  PR[10,5:OrigineBuffer]=0 ;
 257:  PR[10,6:OrigineBuffer]=0 ;
 258:  JMP LBL[12] ;
 259:   ;
 260:  LBL[12] ;
 261:   ;
 262:  ! Pick&Place ;
 263:  ! Pickup Positions ;
 264:  PR[1:Appoggio]=P[100:Zero] ;
 265:  PR[1,1:Appoggio]=R[800:X Pickup Bundles] ;
 266:  PR[1,2:Appoggio]=R[801:Y Pickup Bundles] ;
 267:  PR[1,3:Appoggio]=R[802:Z Pickup Bundles] ;
 268:  PR[1,4:Appoggio]=R[803:W Pickup Bundles] ;
 269:  PR[1,5:Appoggio]=R[804:P Pickup Bundles] ;
 270:  PR[1,6:Appoggio]=R[805:R Pickup Bundles] ;
 271:   ;
 272:  PR[2:Appoggio]=PR[1:Appoggio] ;
 273:  PR[2,3:Appoggio]=R[810:Z OutPickBundle] ;
 274:   ;
 275:  PR[3:Appoggio]=PR[1:Appoggio] ;
 276:  PR[3,3:Appoggio]=R[833:Z OutDepBundles] ;
 277:   ;
 278:  CALL PR2P_MUL(1,1,'S20_PICKPR',3) ;
 279:   ;
 280:  ! Deposit Positions ;
 281:  IF (R[831:Z DepLastLayer]<R[827:Z DepositBundle])R[831:Z DepLastLayer]=R[827:Z DepositBundle] ;
 282:  PR[1:Appoggio]=P[100:Zero] ;
 283:  PR[1,1:Appoggio]=R[825:X DepositBundle] ;
 284:  PR[1,2:Appoggio]=R[826:Y DepositBundle] ;
 285:  PR[1,3:Appoggio]=R[827:Z DepositBundle] ;
 286:  PR[1,4:Appoggio]=R[828:W DepositBundle] ;
 287:  PR[1,5:Appoggio]=R[829:P DepositBundle] ;
 288:  PR[1,6:Appoggio]=R[830:R DepositBundle] ;
 289:   ;
 290:  PR[2:Appoggio]=PR[1:Appoggio] ;
 291:  PR[2,3:Appoggio]=R[834:Z ConsHopperUp] ;
 292:   ;
 293:  PR[3:Appoggio]=PR[1:Appoggio] ;
 294:  PR[3,3:Appoggio]=R[833:Z OutDepBundles] ;
 295:   ;
 296:  CALL PR2P_MUL(1,11,'S21_DEPPR',3) ;
 297:   ;
 298:  ! Calcolo l'offset al prelievo int ;
 299:   ;
 300:  CALL CC_PREL_INT ;
 301:   ;
 302:  ! Memorizzo Tool ;
 303:  PR[182,1:Tool A+B]=R[117:ScostTestaX]+R[192:OffXTool] ;
 304:  PR[182,2:Tool A+B]=R[118:ScostTestaY]+R[193:OffYTool] ;
 305:  PR[182,3:Tool A+B]=R[119:ScostTestaZ]+R[194:OffZTool] ;
 306:  PR[182,4:Tool A+B]=R[195:OffWTool] ;
 307:  PR[182,5:Tool A+B]=R[196:OffPTool] ;
 308:  PR[182,6:Tool A+B]=R[197:OffRTool] ;
 309:   ;
 310:  ! Memorizzo Tool A e B ;
 311:  PR[180:Tool A]=PR[182:Tool A+B] ;
 312:  PR[181:Tool B]=PR[182:Tool A+B] ;
 313:   ;
 314:  ! Alim  con ASP  A ;
 315:  IF R[106:Sel_TipoAsp]=0, JMP LBL[210] ;
 316:  ! Alim con ASP  A+B imforzata ;
 317:  IF R[106:Sel_TipoAsp]=2, JMP LBL[210] ;
 318:  ! Alim  con ASP  A+B indinpendente ;
 319:  IF R[106:Sel_TipoAsp]=3, JMP LBL[205] ;
 320:  ! Alim con ASP  A+B indipendente s ;
 321:  SELECT R[123:OFF.R PrelProd]=0, JMP LBL[200] ;
 322:         =90, JMP LBL[201] ;
 323:         =180, JMP LBL[200] ;
 324:         =270, JMP LBL[201] ;
 325:   ;
 326:  ! Alim  ad L con Offset R=0 ;
 327:  ! Alim  in linea con Offset R=0 ;
 328:  LBL[200] ;
 329:  R[97:Appoggio]=R[135:NFilePresaB]*R[124:Dim.X Prod]/2 ;
 330:  R[98:Appoggio]=R[134:NFilePresaA]*R[124:Dim.X Prod]/2 ;
 331:  PR[180,1:Tool A]=PR[182,1:Tool A+B]+R[97:Appoggio] ;
 332:  PR[181,1:Tool B]=PR[182,1:Tool A+B]-R[98:Appoggio] ;
 333:  JMP LBL[210] ;
 334:  ! Alim  ad L con Offset R=90 ;
 335:  LBL[201] ;
 336:  R[97:Appoggio]=R[135:NFilePresaB]*R[125:Dim.Y Prod]/2 ;
 337:  R[98:Appoggio]=R[134:NFilePresaA]*R[125:Dim.Y Prod]/2 ;
 338:  PR[180,1:Tool A]=PR[182,1:Tool A+B]+R[97:Appoggio] ;
 339:  PR[181,1:Tool B]=PR[182,1:Tool A+B]-R[98:Appoggio] ;
 340:  JMP LBL[210] ;
 341:   ;
 342:  ! Alim con ASP  A+B indinpendente ;
 343:  LBL[205] ;
 344:  SELECT R[123:OFF.R PrelProd]=0, JMP LBL[206] ;
 345:         =90, JMP LBL[207] ;
 346:         =180, JMP LBL[206] ;
 347:         =270, JMP LBL[207] ;
 348:   ;
 349:  ! Alim  ad L con Offset R=0 ;
 350:  LBL[206] ;
 351:  R[97:Appoggio]=R[135:NFilePresaB]*R[125:Dim.Y Prod]/2 ;
 352:  R[98:Appoggio]=R[134:NFilePresaA]*R[125:Dim.Y Prod]/2 ;
 353:  PR[180,2:Tool A]=PR[182,2:Tool A+B]-R[97:Appoggio] ;
 354:  PR[181,2:Tool B]=PR[182,2:Tool A+B]+R[98:Appoggio] ;
 355:  JMP LBL[210] ;
 356:  ! Alim  ad L con Offset R=90 ;
 357:  ! Alim  in linea con Offset R=90 ;
 358:  LBL[207] ;
 359:  R[97:Appoggio]=R[135:NFilePresaB]*R[124:Dim.X Prod]/2 ;
 360:  R[98:Appoggio]=R[134:NFilePresaA]*R[124:Dim.X Prod]/2 ;
 361:  PR[180,2:Tool A]=PR[182,2:Tool A+B]-R[97:Appoggio] ;
 362:  PR[181,2:Tool B]=PR[182,2:Tool A+B]+R[98:Appoggio] ;
 363:  JMP LBL[210] ;
 364:   ;
 365:  LBL[210] ;
 366:   ;
 367:  ! Memorizzo Tool Interlayer ;
 368:  PR[183:Tool3 Intl]=PR[182:Tool A+B] ;
 369:  PR[183,3:Tool3 Intl]=PR[182,3:Tool A+B]+R[476:EscursVentose] ;
 370:   ;
 371:  PR[199:Tool4]=PR[183:Tool3 Intl] ;
 372:  PR[199,2:Tool4]=PR[183,2:Tool3 Intl]-300 ;
 373:   ;
 374:  CALL CAL_TOOL(180,180) ;
 375:  CALL CAL_TOOL(181,181) ;
 376:  CALL CAL_TOOL(182,182) ;
 377:  CALL CAL_TOOL(183,183) ;
 378:  CALL CAL_TOOL(199,199) ;
 379:  UTOOL[2]=PR[182:Tool A+B] ;
 380:  UTOOL[3]=PR[183:Tool3 Intl] ;
 381:  UTOOL[4]=PR[199:Tool4] ;
 382:  ! Lettura dati avvenuta ;
 383:  MESSAGE[...] ;
 384:  MESSAGE[...] ;
 385:  MESSAGE[...] ;
 386:  MESSAGE[...] ;
 387:  MESSAGE[......DATI FORMATO.....] ;
 388:  MESSAGE[......MEMORIZZATI......] ;
 389:  MESSAGE[...] ;
 390:  MESSAGE[...] ;
 391:  MESSAGE[...] ;
 392:   ;
 393:  END ;
 394:  UFRAME_NUM=9 ;
 395:  UTOOL_NUM=2 ;
 396:  J P[100:Zero] 1% FINE ;
 397:   ;
/POS
P[100:Zero]  UF:0 UT:2  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
