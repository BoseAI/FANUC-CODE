/PROG PALCOORD
   1:   ;
   2:  COL DETECT ON ;
   3:  ! Correction pointers case on pall ;
   4:   ;
   5:  R[24:CountStrato]=R[22:CounterLayerA]+276 ;
   6:  SELECT R[R[24]]=1, JMP LBL[21] ;
   7:         =2, JMP LBL[22] ;
   8:         =3, JMP LBL[23] ;
   9:         =4, JMP LBL[24] ;
  10:         =5, JMP LBL[21] ;
  11:         =6, JMP LBL[22] ;
  12:         ELSE, JMP LBL[15] ;
  13:  LBL[21] ;
  14:  R[50:PointProdPrel]=R[21:Counter Prod A]+60 ;
  15:  R[52:PointTipoPrel]=R[21:Counter Prod A]+340 ;
  16:  R[53:PointTipoDep]=R[21:Counter Prod A]+400 ;
  17:  JMP LBL[25] ;
  18:  LBL[22] ;
  19:  R[50:PointProdPrel]=R[21:Counter Prod A]+120 ;
  20:  R[52:PointTipoPrel]=R[21:Counter Prod A]+540 ;
  21:  R[53:PointTipoDep]=R[21:Counter Prod A]+600 ;
  22:  JMP LBL[25] ;
  23:  LBL[23] ;
  24:  R[50:PointProdPrel]=R[21:Counter Prod A]+60 ;
  25:  R[52:PointTipoPrel]=R[21:Counter Prod A]+340 ;
  26:  R[53:PointTipoDep]=R[21:Counter Prod A]+400 ;
  27:  JMP LBL[25] ;
  28:  LBL[24] ;
  29:  R[50:PointProdPrel]=R[21:Counter Prod A]+120 ;
  30:  R[52:PointTipoPrel]=R[21:Counter Prod A]+540 ;
  31:  R[53:PointTipoDep]=R[21:Counter Prod A]+600 ;
  32:  LBL[25] ;
  33:   ;
  34:  IF R[106:Sel_TipoAsp]=0, JMP LBL[1] ;
  35:  IF R[106:Sel_TipoAsp]=2, JMP LBL[1] ;
  36:  ! Multipresa abilitata ;
  37:  R[56:TipoPrelCorrente]=R[R[52]] ;
  38:  R[57:TipoDepCorrente]=R[R[53]] ;
  39:  JMP LBL[2] ;
  40:  LBL[1:Only Ch A] ;
  41:  R[56:TipoPrelCorrente]=2 ;
  42:  R[57:TipoDepCorrente]=2 ;
  43:  LBL[2] ;
  44:   ;
  45:  ! Calculation points for actual ca ;
  46:  PR[59:CoordProdDaDepos]=P[100:0Pallet_NUT]+PR[R[50]] ;
  47:   ;
  48:  ! Aggiungo la correzione da pannel ;
  49:   ;
  50:  PR[59,1:CoordProdDaDepos]=PR[59,1:CoordProdDaDepos]+R[100:Off.XDepProd] ;
  51:   ;
  52:  PR[59,2:CoordProdDaDepos]=PR[59,2:CoordProdDaDepos]+R[101:Off.YDepProd] ;
  53:   ;
  54:  R[99:Appoggio]=R[126:Dim.Z Prod]*R[22:CounterLayerA] ;
  55:  PR[59,3:CoordProdDaDepos]=R[99:Appoggio]+R[109:Dim.Z Pallet]+R[102:Off.ZDepProd]+R[126:Dim.Z Prod]+R[25:IntlHeight] ;
  56:   ;
  57:  ! Calcolo avvicinamento cartone ;
  58:   ;
  59:  PR[58:PR59+Accostam]=PR[59:CoordProdDaDepos] ;
  60:  PR[58,1:PR59+Accostam]=PR[58,1:PR59+Accostam]+R[103:Accostamento X] ;
  61:  PR[58,2:PR59+Accostam]=PR[58,2:PR59+Accostam]+R[104:Accostamento Y] ;
  62:  PR[58,3:PR59+Accostam]=PR[58,3:PR59+Accostam]+R[105:Accostamento Z] ;
  63:   ;
  64:  ! Calcolo accostamento cartone ;
  65:  PR[57:PR58+Z Avvic]=PR[58:PR59+Accostam] ;
  66:  PR[57,3:PR58+Z Avvic]=PR[58,3:PR59+Accostam]+R[126:Dim.Z Prod]+R[152:Avvic.Z Pallet] ;
  67:   ;
  68:  IF R[103:Accostamento X]>=0, JMP LBL[50] ;
  69:  IF (PR[57,1:PR58+Z Avvic]<=700), JMP LBL[50] ;
  70:  IF (PR[57,3:PR58+Z Avvic]<=R[462:ZmaxHighLastRows]), JMP LBL[50] ;
  71:  PR[57,3:PR58+Z Avvic]=R[462:ZmaxHighLastRows] ;
  72:  PR[57,1:PR58+Z Avvic]=300 ;
  73:  LBL[50] ;
  74:   ;
  75:  END ;
  76:  LBL[15:Errore tipo Laye] ;
  77:  MESSAGE[.......................] ;
  78:  MESSAGE[...ERRORE SELEZIONE....] ;
  79:  MESSAGE[.....TIPO LAYER........] ;
  80:  MESSAGE[.......................] ;
  81:  END ;
  82:  J P[100:0Pallet_NUT] 100% CNT100 ;
/POS
P[100:0Pallet_NUT]  UF:5 UT:1  X=0.0 Y=0.0 Z=0.0 W=-180.0 P=0.0 R=0.0
