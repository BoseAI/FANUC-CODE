/PROG S13_PR_BUF
   1:  COL DETECT ON ;
   2:  UTOOL_NUM=2 ;
   3:   ;
   4:  IF R[1:RobotStatus]=0, JMP LBL[5] ;
   5:  IF R[1:RobotStatus]=1003, JMP LBL[5] ;
   6:  IF R[1:RobotStatus]=1005, JMP LBL[5] ;
   7:  IF R[1:RobotStatus]=1012, JMP LBL[5] ;
   8:  IF R[1:RobotStatus]=1006, JMP LBL[2] ;
   9:  IF R[1:RobotStatus]=1016, JMP LBL[5] ;
  10:   ;
  11:  JMP LBL[98] ;
  12:   ;
  13:  LBL[2] ;
  14:  UFRAME_NUM=9 ;
  15:  UTOOL_NUM=1 ;
  16:  J PR[50:ZeroPos Robot] 100% CNT100 ;
  17:   ;
  18:  LBL[5] ;
  19:  R[1:RobotStatus]=13 ;
  20:   ;
  21:  IF R[59:NumProdBuffer]<=0, JMP LBL[1] ;
  22:   ;
  23:  ! Calcolo il prossimo deposito ;
  24:  ! sul pallet ;
  25:  CALL PALCOORD ;
  26:  ! Scelgo il tool in funzione del ;
  27:  ! prossimo deposito su PR59 ;
  28:   ;
  29:  ! Calcolo pos. di prelievo ;
  30:  R[95:Appoggio]=R[59:NumProdBuffer]*R[125:Dim.Y Prod] ;
  31:  IF R[95:Appoggio]>=R[151:DimensioneBuffer], JMP LBL[6] ;
  32:  R[95:Appoggio]=R[95:Appoggio]-R[125:Dim.Y Prod] ;
  33:  PR[11:DepCorrBuffer]=PR[10:OrigineBuffer] ;
  34:  PR[11,2:DepCorrBuffer]=PR[10,2:OrigineBuffer]-R[95:Appoggio] ;
  35:   ;
  36:  PR[13:AvvVertBuffer]=PR[11:DepCorrBuffer] ;
  37:  PR[13,3:AvvVertBuffer]=PR[13,3:AvvVertBuffer]+60 ;
  38:   ;
  39:  ! Entro nel buffer con ;
  40:  ! il frame del prelievo ;
  41:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  42:  UFRAME_NUM=5 ;
  43:  UTOOL_NUM=2 ;
  44:  PR[9:Appoggio]=JPOS ;
  45:  PR[14:IngUscBuffer]=P[1:IngrBuffer] ;
  46:  PR[14,3:IngUscBuffer]=PR[14,3:IngUscBuffer]+R[126:Dim.Z Prod] ;
  47:  PR[14,6:IngUscBuffer]=PR[12,6:AccBuffer] ;
  48:   ;
  49:  PR[15:IngUscBuffer]=PR[14:IngUscBuffer] ;
  50:  PR[15,1:IngUscBuffer]=PR[15,1:IngUscBuffer]-750 ;
  51:  PR[15,2:IngUscBuffer]=-100 ;
  52:  PR[15,3:IngUscBuffer]=PR[15,3:IngUscBuffer]+120 ;
  53:   ;
  54:  CALL CORR_ANG(9,14) ;
  55:   ;
  56:  J PR[14:IngUscBuffer] 100% CNT20 ;
  57:  L PR[15:IngUscBuffer] 2000mm/sec CNT20 ;
  58:  ! Passo al frame buffer ;
  59:  UFRAME[5]=PR[191:Frame Buf+Offset] ;
  60:  UFRAME_NUM=5 ;
  61:  UTOOL_NUM=2 ;
  62:  OVERRIDE=R[2:NoProductSpeed] ;
  63:   ;
  64:  PR[9:Appoggio]=LPOS ;
  65:  PR[17:AuxBuffer]=PR[9:Appoggio] ;
  66:  PR[17,2:AuxBuffer]=PR[13,2:AvvVertBuffer] ;
  67:  L PR[17:AuxBuffer] 2000mm/sec CNT20 ;
  68:   ;
  69:  L PR[13:AvvVertBuffer] 2000mm/sec CNT20 ;
  70:  DO[44:Rq Inib All Prel Cartone]=ON ;
  71:   ;
  72:  IF DI[58:No Load Run]=ON, JMP LBL[199] ;
  73:  CALL ASPA_ON ;
  74:  IF R[106:Sel_TipoAsp]=2, CALL ASPB_ON ;
  75:  LBL[199] ;
  76:   ;
  77:  L PR[11:DepCorrBuffer] 2000mm/sec FINE ;
  78:  DO[44:Rq Inib All Prel Cartone]=OFF ;
  79:  OVERRIDE=R[3:SpeedWithProd] ;
  80:   ;
  81:  WAIT DI[33:CasePickUpChA]=ON OR R[20:TEST]=1 OR DI[58:No Load Run]=ON ;
  82:  IF R[106:Sel_TipoAsp]<>2, JMP LBL[200] ;
  83:  WAIT DI[37:CasePickUpChB]=ON OR R[20:TEST]=1 OR DI[58:No Load Run]=ON ;
  84:  LBL[200] ;
  85:   ;
  86:  R[59:NumProdBuffer]=R[59:NumProdBuffer]-1 ;
  87:  CALL CHK_BUF ;
  88:   ;
  89:  L PR[13:AvvVertBuffer] 2000mm/sec CNT2 ;
  90:  L PR[17:AuxBuffer] 2000mm/sec CNT20 ;
  91:   ;
  92:  ! Torno al frame prelievo ;
  93:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  94:  UFRAME_NUM=5 ;
  95:  UTOOL_NUM=2 ;
  96:  R[1:RobotStatus]=1013 ;
  97:  L PR[15:IngUscBuffer] 2000mm/sec CNT100 ;
  98:  J PR[14:IngUscBuffer] 100% CNT20 ;
  99:  END ;
 100:   ;
 101:  LBL[1:Buffer Vuoto] ;
 102:  R[59:NumProdBuffer]=0 ;
 103:  MESSAGE[................] ;
 104:  MESSAGE[..Buffer Vuoto..] ;
 105:  MESSAGE[................] ;
 106:  CALL ABORT ;
 107:  END ;
 108:  LBL[6:Err.Conteggio] ;
 109:  MESSAGE[................] ;
 110:  MESSAGE[..Superamento...] ;
 111:  MESSAGE[.Limite Buffer..] ;
 112:  MESSAGE[................] ;
 113:  CALL ABORT ;
 114:  END ;
 115:  J P[1:IngrBuffer] 1% FINE ;
 116:  END ;
 117:   ;
 118:  LBL[98] ;
 119:  MESSAGE[..................] ;
 120:  MESSAGE[..SEQUENCE ERROR..] ;
 121:  MESSAGE[..Status <> 0 ..] ;
 122:  MESSAGE[..Status <> 1003 ..] ;
 123:  MESSAGE[..Status <> 1005 ..] ;
 124:  MESSAGE[..Status <> 1006 ..] ;
 125:  MESSAGE[..Status <> 1012 ..] ;
 126:  MESSAGE[..Status <> 1016 ..] ;
 127:  CALL ABORT ;
 128:   ;
/POS
P[1:IngrBuffer]  UF:5 UT:2  X=-350.0 Y=10.0 Z=1200.0 W=-180.0 P=0.0 R=180.0
