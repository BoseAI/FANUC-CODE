/PROG S12_DEP_BUF
   1:  COL DETECT ON ;
   2:  UTOOL_NUM=2 ;
   3:  OVERRIDE=R[3:SpeedWithProd] ;
   4:   ;
   5:  IF R[1:RobotStatus]=1001, JMP LBL[5] ;
   6:  IF R[1:RobotStatus]=1007, JMP LBL[5] ;
   7:  IF R[1:RobotStatus]=1008, JMP LBL[10] ;
   8:  IF R[1:RobotStatus]=1013, JMP LBL[10] ;
   9:   ;
  10:   ;
  11:  JMP LBL[99] ;
  12:   ;
  13:  ! Arrivo da prel.prod. ;
  14:  ! o da scanner ;
  15:  LBL[5] ;
  16:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  17:  UFRAME_NUM=5 ;
  18:  R[1:RobotStatus]=12 ;
  19:  GO[5:Stato Robot]=R[1:RobotStatus] ;
  20:   ;
  21:  PR[9:Appoggio]=LPOS ;
  22:  R[95:Appoggio]=PR[9,6:Appoggio] ;
  23:  PR[9:Appoggio]=P[100] ;
  24:  PR[9,6:Appoggio]=R[95:Appoggio] ;
  25:   ;
  26:  L P[2] 2000mm/sec CNT10 Offset,PR[9:Appoggio] ;
  27:   ;
  28:  LBL[10] ;
  29:  DO[78:Out Obstruction PickUp]=ON ;
  30:  R[1:RobotStatus]=12 ;
  31:   ;
  32:  IF R[59:NumProdBuffer]<0, JMP LBL[4] ;
  33:  ! Calcolo pos. di deposito ;
  34:  R[95:Appoggio]=R[59:NumProdBuffer]*R[125:Dim.Y Prod] ;
  35:  R[96:Appoggio]=R[95:Appoggio]+R[125:Dim.Y Prod] ;
  36:  IF R[96:Appoggio]>=R[151:DimensioneBuffer], JMP LBL[1] ;
  37:  PR[11:DepCorrBuffer]=PR[10:OrigineBuffer] ;
  38:  PR[11,2:DepCorrBuffer]=PR[10,2:OrigineBuffer]-R[95:Appoggio] ;
  39:   ;
  40:  PR[12:AccBuffer]=PR[11:DepCorrBuffer] ;
  41:  PR[12,1:AccBuffer]=PR[11,1:DepCorrBuffer]-50 ;
  42:  PR[12,2:AccBuffer]=PR[11,2:DepCorrBuffer]-50 ;
  43:  PR[12,3:AccBuffer]=PR[11,3:DepCorrBuffer]+50 ;
  44:   ;
  45:  PR[13:AvvVertBuffer]=PR[11:DepCorrBuffer] ;
  46:  PR[13,3:AvvVertBuffer]=PR[11,3:DepCorrBuffer]+30 ;
  47:   ;
  48:  ! Entro nel buffer con ;
  49:  ! il frame del prelievo ;
  50:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  51:  UFRAME_NUM=5 ;
  52:  PR[9:Appoggio]=JPOS ;
  53:  PR[14:IngUscBuffer]=P[1:IngrBuffer] ;
  54:  PR[14,3:IngUscBuffer]=PR[14,3:IngUscBuffer]+R[126:Dim.Z Prod] ;
  55:  PR[14,6:IngUscBuffer]=PR[13,6:AvvVertBuffer] ;
  56:   ;
  57:  PR[15:IngUscBuffer]=PR[14:IngUscBuffer] ;
  58:  PR[15,1:IngUscBuffer]=PR[15,1:IngUscBuffer]-750 ;
  59:  PR[15,2:IngUscBuffer]=-100 ;
  60:  PR[15,3:IngUscBuffer]=PR[15,3:IngUscBuffer]+120 ;
  61:   ;
  62:  CALL CORR_ANG(9,14) ;
  63:   ;
  64:  J PR[14:IngUscBuffer] 100% CNT20 ;
  65:  L PR[15:IngUscBuffer] 2000mm/sec CNT30 ;
  66:  ! Passo al frame buffer ;
  67:  UFRAME[5]=PR[191:Frame Buf+Offset] ;
  68:  UFRAME_NUM=5 ;
  69:   ;
  70:  PR[9:Appoggio]=LPOS ;
  71:  PR[17:AuxBuffer]=PR[9:Appoggio] ;
  72:  PR[17,2:AuxBuffer]=PR[12,2:AccBuffer] ;
  73:  L PR[17:AuxBuffer] 2000mm/sec CNT20 ;
  74:   ;
  75:  L PR[12:AccBuffer] 2000mm/sec CNT20 ;
  76:  L PR[11:DepCorrBuffer] 2000mm/sec FINE ;
  77:   ;
  78:  ! Rilascio Pacco ;
  79:  IF DI[58:No Load Run]=ON, JMP LBL[45] ;
  80:  IF R[106:Sel_TipoAsp]=2, JMP LBL[41] ;
  81:   ;
  82:  CALL ASPA_OFF ;
  83:  WAIT DI[34:CaseReleaseChA]=ON OR R[20:TEST]=1 ;
  84:  JMP LBL[45] ;
  85:   ;
  86:  LBL[41] ;
  87:  CALL ASPA_OFF ;
  88:  CALL ASPB_OFF ;
  89:  IF R[20:TEST]=1, JMP LBL[45] ;
  90:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
  91:  JMP LBL[45] ;
  92:   ;
  93:  LBL[45] ;
  94:  R[1:RobotStatus]=112 ;
  95:   ;
  96:  R[59:NumProdBuffer]=R[59:NumProdBuffer]+1 ;
  97:  CALL CHK_BUF ;
  98:   ;
  99:  OVERRIDE=R[2:NoProductSpeed] ;
 100:   ;
 101:  L PR[13:AvvVertBuffer] 2000mm/sec CNT50 ;
 102:  ! Torno al frame prelievo ;
 103:  L PR[17:AuxBuffer] 2000mm/sec CNT50 ;
 104:   ;
 105:  R[1:RobotStatus]=1012 ;
 106:   ;
 107:  UFRAME[5]=PR[190:Frame PR+OFF] ;
 108:  UFRAME_NUM=5 ;
 109:  L PR[15:IngUscBuffer] 2000mm/sec CNT100 ;
 110:  J PR[14:IngUscBuffer] 100% CNT100 ;
 111:   ;
 112:  END ;
 113:   ;
 114:  LBL[1:Buffer Pieno] ;
 115:  MESSAGE[................] ;
 116:  MESSAGE[..Buffer Pieno..] ;
 117:  MESSAGE[................] ;
 118:  CALL ABORT ;
 119:  END ;
 120:  LBL[4:Err.Conteggio] ;
 121:  MESSAGE[................] ;
 122:  MESSAGE[Conteggio buffer] ;
 123:  MESSAGE[....negativo....] ;
 124:  MESSAGE[................] ;
 125:  CALL ABORT ;
 126:  END ;
 127:  J P[1:IngrBuffer] 1% FINE ;
 128:  J P[100] 100% FINE ;
 129:  END ;
 130:   ;
 131:  LBL[99] ;
 132:  MESSAGE[..................] ;
 133:  MESSAGE[..SEQUENCE ERROR..] ;
 134:  MESSAGE[..Status <> 1001 ..] ;
 135:  MESSAGE[..Status <> 1007 ..] ;
 136:  MESSAGE[..Status <> 1008 ..] ;
 137:  MESSAGE[..Status <> 1013 ..] ;
 138:  CALL ABORT ;
 139:   ;
/POS
P[1:IngrBuffer]  UF:5 UT:2  X=-350.0 Y=10.0 Z=1200.0 W=-180.0 P=0.0 R=0.0
P[2]  UF:5 UT:2  X=-361.1 Y=160.1 Z=950.0 W=180.0 P=0.0 R=0.0
P[100]  UF:5 UT:2  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
