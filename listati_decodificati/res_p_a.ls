/PROG RES_P_A
   1:  ! Inizializzo formato ;
   2:  R[31:IndexNextCase]=0 ;
   3:  R[32:IndexNextLayer]=0 ;
   4:   ;
   5:  ! Carico il primo punto ;
   6:   ;
   7:  R[21:Counter Prod A]=0 ;
   8:  R[22:CounterLayerA]=0 ;
   9:  R[23:CaseDepthHeight]=R[109:Dim.Z Pallet] ;
  10:  R[24:CountStrato]=276 ;
  11:  R[25:IntlHeight]=0 ;
  12:   ;
  13:  SELECT R[R[24]]=1, JMP LBL[1] ;
  14:         =2, JMP LBL[2] ;
  15:         =3, JMP LBL[3] ;
  16:         =4, JMP LBL[4] ;
  17:         =5, JMP LBL[1] ;
  18:         =6, JMP LBL[2] ;
  19:         ELSE, JMP LBL[5] ;
  20:   ;
  21:  LBL[1:Strato A] ;
  22:  R[50:PointProdPrel]=60 ;
  23:  R[52:PointTipoPrel]=340 ;
  24:  DO[27:Rq Interlayer]=OFF ;
  25:  JMP LBL[6] ;
  26:   ;
  27:  LBL[2:Strato B] ;
  28:  R[50:PointProdPrel]=120 ;
  29:  R[52:PointTipoPrel]=540 ;
  30:  DO[27:Rq Interlayer]=OFF ;
  31:  JMP LBL[6] ;
  32:   ;
  33:  LBL[3:Strato A+IntL] ;
  34:  R[50:PointProdPrel]=60 ;
  35:  R[52:PointTipoPrel]=340 ;
  36:  R[25:IntlHeight]=R[136:IntlThickness] ;
  37:  DO[27:Rq Interlayer]=ON ;
  38:  JMP LBL[6] ;
  39:   ;
  40:  LBL[4:Strato B+IntL] ;
  41:  R[50:PointProdPrel]=120 ;
  42:  R[52:PointTipoPrel]=540 ;
  43:  R[25:IntlHeight]=R[136:IntlThickness] ;
  44:  DO[27:Rq Interlayer]=ON ;
  45:  JMP LBL[6] ;
  46:   ;
  47:  LBL[5:Errore tipo Laye] ;
  48:  MESSAGE[.......................] ;
  49:  MESSAGE[...ERRORE SELEZIONE....] ;
  50:  MESSAGE[.....TIPO LAYER........] ;
  51:  MESSAGE[.......................] ;
  52:  DO[56:RqResetDone]=PULSE,0.2sec ;
  53:  CALL ABORT ;
  54:   ;
  55:  LBL[6] ;
  56:   ;
  57:  ! Lettura dati avvenuta ;
  58:  MESSAGE[...] ;
  59:  MESSAGE[...] ;
  60:  MESSAGE[...] ;
  61:  MESSAGE[......DATI LAVORO......] ;
  62:  MESSAGE[.......PALLET A........] ;
  63:  MESSAGE[.......AZZERATI........] ;
  64:  MESSAGE[...] ;
  65:  MESSAGE[...] ;
  66:  MESSAGE[...] ;
  67:   ;
  68:  GO[3:N Deposit Done]=R[21:Counter Prod A] ;
  69:  GO[4:Num Layers Completed]=R[22:CounterLayerA] ;
  70:  LBL[7] ;
  71:  DO[56:RqResetDone]=PULSE,0.2sec ;
  72:  IF DI[30:Rq Reset Pallet Counters]=ON, JMP LBL[7] ;
  73:   ;
