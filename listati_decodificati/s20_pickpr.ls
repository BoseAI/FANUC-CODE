/PROG S20_PICKPR
   1:  COL DETECT ON ;
   2:  UFRAME_NUM=8 ;
   3:  UTOOL_NUM=1 ;
   4:  ! Verifico da quale ciclo ;
   5:  ! proviene il robot e ;
   6:  ! scelgo la traiettoria ;
   7:  ! di conseguenza ;
   8:  IF R[1:RobotStatus]=0, JMP LBL[2] ;
   9:  IF R[1:RobotStatus]=1003, JMP LBL[2] ;
  10:  IF R[1:RobotStatus]=1004, JMP LBL[2] ;
  11:  IF R[1:RobotStatus]=1005, JMP LBL[2] ;
  12:   ;
  13:  IF R[1:RobotStatus]=1021, JMP LBL[1] ;
  14:  ! Non vengo da nessuno ;
  15:  ! dei cicli validi ;
  16:  ! Segnalazione allarme ;
  17:  JMP LBL[99] ;
  18:   ;
  19:  LBL[2] ;
  20:  ! Punto intermedio per ;
  21:  ! raggiungere il ;
  22:  ! prelievo prodotto ;
  23:  OVERRIDE=R[2:NoProductSpeed] ;
  24:  R[1:RobotStatus]=20 ;
  25:   ;
  26:  J P[50:Pickup_Entry] 100% CNT100 ;
  27:   ;
  28:  LBL[1] ;
  29:  R[1:RobotStatus]=20 ;
  30:  IF R[901:Pinze Presenti]>=1, CALL GRIP_OP ;
  31:  IF R[901:Pinze Presenti]=2, CALL GRIPT_OP ;
  32:  IF R[902:CupsUP/DW Presen]>=1, CALL CUPS_UP ;
  33:  ! Movimento su prelievo ;
  34:  L P[3:FuoriIngPrelProd] 2000mm/sec CNT5 ;
  35:  LBL[5:WaitPickupEnb] ;
  36:  L P[2:AttesaPrelProd] 2000mm/sec CNT50 <opz.EE> ;
  37:   ;
  38:  DO[90:WaitPickUpBundle]=ON ;
  39:   ;
  40:  IF R[10:RqRobotMission]=120 AND R[20:TEST]=0, JMP LBL[5] ;
  41:  R[1:RobotStatus]=120 ;
  42:   ;
  43:  IF (F[1]), JMP LBL[1000] ;
  44:  LBL[4:WAIT Attuatori] ;
  45:  IF DI[31:Decrease cnt Pallet]=OFF AND R[901:Pinze Presenti]=2, JMP LBL[4] ;
  46:  IF DI[35:Grippers opened]=OFF AND R[901:Pinze Presenti]>=1, JMP LBL[4] ;
  47:  IF DI[63:Cups UP]=OFF AND R[902:CupsUP/DW Presen]=1, JMP LBL[4] ;
  48:  LBL[1000] ;
  49:   ;
  50:  DO[90:WaitPickUpBundle]=OFF ;
  51:   ;
  52:  DO[66:OutOfObstructFromPickup]=OFF ;
  53:   ;
  54:  ! Discesa Robot in Prelievo ;
  55:  DO[44:Rq Inib All Prel Cartone]=ON ;
  56:  CALL ASPA_ON ;
  57:  CALL ASPB_ON ;
  58:   ;
  59:  L P[1:Prelievo Prod] 2000mm/sec FINE ;
  60:   ;
  61:  DO[44:Rq Inib All Prel Cartone]=OFF ;
  62:  IF R[901:Pinze Presenti]>=1, CALL GRIP_CL ;
  63:  IF R[901:Pinze Presenti]=2, CALL GRIPT_CL ;
  64:   ;
  65:  IF (F[1]), JMP LBL[1001] ;
  66:  LBL[3:WAIT Attuatori] ;
  67:   ;
  68:  IF DI[36:Grippers Closed]=OFF AND R[901:Pinze Presenti]>=1, JMP LBL[3] ;
  69:  IF DI[63:Cups UP]=OFF AND R[902:CupsUP/DW Presen]=1, JMP LBL[3] ;
  70:  WAIT (DI[33:CasePickUpChA]=ON AND DI[37:CasePickUpChB]=ON) ;
  71:  LBL[1001] ;
  72:   ;
  73:  ! Salita Robot da Prelievo ;
  74:  ! Prodotto ;
  75:   ;
  76:  OVERRIDE=R[5:PeP Speed] ;
  77:  ! Vado alla pos di prel + altezza ;
  78:  L P[3:FuoriIngPrelProd] 2000mm/sec CNT100 ;
  79:  DO[66:OutOfObstructFromPickup]=ON ;
  80:   ;
  81:  R[1:RobotStatus]=1020 ;
  82:   ;
  83:  $GROUP[1].$USE_TURNS=0 ;
  84:   ;
  85:   ;
  86:  END ;
  87:   ;
  88:  LBL[99] ;
  89:  MESSAGE[..................] ;
  90:  MESSAGE[..SEQUENCE ERROR..] ;
  91:  MESSAGE[..Status <> 1003..] ;
  92:  MESSAGE[..Status <> 1004..] ;
  93:  MESSAGE[..Status <> 1005..] ;
  94:  MESSAGE[..Status <> 1021..] ;
  95:  CALL ABORT ;
  96:  END ;
  97:   ;
/POS
P[1:Prelievo Prod]  UF:8 UT:1  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
P[2:AttesaPrelProd]  UF:8 UT:1  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
P[3:FuoriIngPrelProd]  UF:8 UT:1  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
P[50:Pickup_Entry]  UF:8 UT:1  X=-1350.0 Y=-300.0 Z=1750.0 W=180.0 P=0.0 R=0.0
P[100:Zero]  UF:5 UT:3  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
