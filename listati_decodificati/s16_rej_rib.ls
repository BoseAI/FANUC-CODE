/PROG S16_REJ_RIB
   1:   ;
   2:  IF R[1:RobotStatus]=1001, JMP LBL[3] ;
   3:  IF R[1:RobotStatus]=1007, JMP LBL[3] ;
   4:  IF R[1:RobotStatus]=1008, JMP LBL[3] ;
   5:  IF R[1:RobotStatus]=1013, JMP LBL[3] ;
   6:  IF R[1:RobotStatus]=1017, JMP LBL[3] ;
   7:  IF R[1:RobotStatus]=1018, JMP LBL[3] ;
   8:   ;
   9:  JMP LBL[98] ;
  10:  LBL[3] ;
  11:   ;
  12:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  13:  UFRAME_NUM=5 ;
  14:  UTOOL[2]=PR[182:Tool A+B] ;
  15:  UTOOL_NUM=2 ;
  16:   ;
  17:  OVERRIDE=R[3:SpeedWithProd] ;
  18:   ;
  19:   ;
  20:  R[1:RobotStatus]=16 ;
  21:  L P[3:EntrReject] 2000mm/sec CNT100 ;
  22:  L P[2:AvvReject] 2000mm/sec CNT10 ;
  23:   ;
  24:  WAIT R[10:RqRobotMission]=116 OR R[20:TEST]=1 ;
  25:  R[1:RobotStatus]=116 ;
  26:  DO[78:Out Obstruction PickUp]=OFF ;
  27:   ;
  28:  L P[1:PosReject] 2000mm/sec FINE ;
  29:   ;
  30:  ! Rilascio Pacco ;
  31:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
  32:   ;
  33:  IF DI[58:No Load Run]=ON, JMP LBL[45] ;
  34:  IF R[106:Sel_TipoAsp]=2, JMP LBL[41] ;
  35:   ;
  36:  SELECT R[57:TipoDepCorrente]=0, JMP LBL[41] ;
  37:         =2, JMP LBL[42] ;
  38:         =3, JMP LBL[43] ;
  39:   ;
  40:  LBL[41] ;
  41:  CALL ASPA_OFF ;
  42:  CALL ASPB_OFF ;
  43:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
  44:  JMP LBL[45] ;
  45:   ;
  46:  LBL[42] ;
  47:  CALL ASPA_OFF ;
  48:  WAIT DI[34:CaseReleaseChA]=ON ;
  49:  JMP LBL[45] ;
  50:   ;
  51:  LBL[43] ;
  52:  CALL ASPB_OFF ;
  53:  WAIT DI[38:CaseReleaseChB]=ON ;
  54:  JMP LBL[45] ;
  55:   ;
  56:  LBL[45] ;
  57:   ;
  58:  OVERRIDE=R[2:NoProductSpeed] ;
  59:   ;
  60:  L P[3:EntrReject] 2000mm/sec CNT100 ;
  61:   ;
  62:  DO[78:Out Obstruction PickUp]=ON ;
  63:  R[1:RobotStatus]=1016 ;
  64:   ;
  65:  END ;
  66:   ;
  67:  LBL[98] ;
  68:  MESSAGE[..................] ;
  69:  MESSAGE[..SEQUENCE ERROR..] ;
  70:  MESSAGE[..Status <> 1001..] ;
  71:  MESSAGE[..Status <> 1008..] ;
  72:  MESSAGE[..Program Aborted.] ;
  73:  MESSAGE[..................] ;
  74:  CALL ABORT ;
  75:   ;
  76:  LBL[99] ;
  77:  CALL ABORT ;
  78:  END ;
  79:   ;
  80:   ;
/POS
P[1:PosReject]  UF:5 UT:2  X=-216.5 Y=-168.0 Z=255.5 W=-180.0 P=0.0 R=180.0
P[2:AvvReject]  UF:5 UT:2  X=-216.5 Y=-168.0 Z=285.5 W=-180.0 P=0.0 R=180.0
P[3:EntrReject]  UF:5 UT:2  X=-216.5 Y=-168.0 Z=1055.5 W=-180.0 P=0.0 R=180.0
