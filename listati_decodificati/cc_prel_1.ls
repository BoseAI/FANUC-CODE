/PROG CC_PREL_1
   1:   ;
   2:  PR[1:Appoggio]=P[100:Zero] ;
   3:  SELECT R[903:FixedWirePick_1]=0, JMP LBL[1001] ;
   4:         =1, JMP LBL[21] ;
   5:         =2, JMP LBL[22] ;
   6:         =3, JMP LBL[23] ;
   7:   ;
   8:  LBL[21:FiloFissoSX] ;
   9:  PR[1,2:Appoggio]=R[113:NCasseInY]*R[125:Dim.Y Prod]/2 ;
  10:  PR[1,2:Appoggio]=0-PR[1,2:Appoggio] ;
  11:  JMP LBL[20] ;
  12:   ;
  13:  LBL[22:F_F_Centrale] ;
  14:  PR[1,2:Appoggio]=0 ;
  15:  JMP LBL[20] ;
  16:   ;
  17:  LBL[23:FiloFissoDX] ;
  18:  PR[1,2:Appoggio]=R[113:NCasseInY]*R[125:Dim.Y Prod]/2 ;
  19:  JMP LBL[20] ;
  20:   ;
  21:  LBL[20] ;
  22:  PR[1,1:Appoggio]=R[133:NCasseInX]*R[124:Dim.X Prod]/2 ;
  23:  PR[1,2:Appoggio]=PR[1,2:Appoggio]+R[121:OFF.Y PrelProd] ;
  24:  PR[1,3:Appoggio]=R[126:Dim.Z Prod] ;
  25:  PR[1,1:Appoggio]=0-PR[1,1:Appoggio]+R[120:OFF.X PrelProd] ;
  26:  PR[1,3:Appoggio]=PR[1,3:Appoggio]+R[122:OFF.Z PrelProd] ;
  27:  PR[1,4:Appoggio]=-180 ;
  28:  PR[1,5:Appoggio]=0 ;
  29:  PR[1,6:Appoggio]=R[123:OFF.R PrelProd] ;
  30:   ;
  31:  PR[2:Appoggio]=PR[1:Appoggio] ;
  32:  PR[2,3:Appoggio]=PR[1,3:Appoggio]+R[150:Avvic Z PrelProd] ;
  33:   ;
  34:  PR[3:Appoggio]=PR[2:Appoggio] ;
  35:  //PR[3,3:Appoggio]=PR[2,3:Appoggio]+200 ;
  36:  PR[3,3:Appoggio]=1100 ;
  37:   ;
  38:  PR[4:Appoggio]=PR[1:Appoggio] ;
  39:  //PR[3,3:Appoggio]=PR[2,3:Appoggio]+200 ;
  40:  PR[4,3:Appoggio]=PR[3,3:Appoggio]+R[126:Dim.Z Prod] ;
  41:   ;
  42:  CALL PR2P_MUL(1,1,'S01_PR_CASE',4) ;
  43:   ;
  44:  CALL PR2P_MUL(3,3,'S03_PALPLACE',2) ;
  45:   ;
  46:  CALL PR2P_MUL(3,3,'S03_PALPL_A',2) ;
  47:   ;
  48:  CALL PR2P_MUL(3,3,'S04_PALPL_B',2) ;
  49:   ;
  50:  CALL PR2P_MUL(3,3,'S10_DEP_INT',1) ;
  51:  CALL PR2P_MUL(3,3,'S10_DEP_INTA',1) ;
  52:  CALL PR2P_MUL(3,3,'S11_DEP_INTB',1) ;
  53:   ;
  54:  END ;
  55:  LBL[1001:Wrong R903] ;
  56:  MESSAGE[...] ;
  57:  MESSAGE[...IMPOSTARE R[903]....] ;
  58:  MESSAGE[....FILO FISSO ALIM....] ;
  59:  MESSAGE[....1 SX...............] ;
  60:  MESSAGE[....2 CENTRALE.........] ;
  61:  MESSAGE[....3 DX...............] ;
  62:  MESSAGE[...] ;
