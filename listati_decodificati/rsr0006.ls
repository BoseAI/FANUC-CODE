/PROG RSR0006
   1:  LBL[99] ;
   2:  ! BFB IMA Spa ;
   3:  ! Impianto Pallettizzatore ;
   4:  ! robotizzato ;
   5:  ! Versione 00 ;
   6:   ;
   7:  CALL MEM_DATI ;
   8:  CALL V_CNT_P ;
   9:  CALL V_NEXT_STEP ;
  10:  CALL PALCOORD ;
  11:  ! Programma principale ;
  12:   ;
  13:  MESSAGE[    ] ;
  14:  MESSAGE[    ] ;
  15:  MESSAGE[    ] ;
  16:  MESSAGE[    ] ;
  17:  MESSAGE[  IMA END OF LINE] ;
  18:  MESSAGE[    PALLETIZER  ] ;
  19:  MESSAGE[    ] ;
  20:  MESSAGE[    ] ;
  21:  MESSAGE[    ] ;
  22:  MESSAGE[    ] ;
  23:   ;
  24:  LBL[1:Ricorsivita'] ;
  25:  DO[26:StartRSR006Done]=ON ;
  26:   ;
  27:  ! Controllo BG logic ;
  28:   ;
  29:  CALL CHK_BGLOGIC ;
  30:  ! Rq funzioni Robot ;
  31:   ;
  32:  SELECT R[10:RqRobotMission]=1, CALL S01_PR_CASE ;
  33:         =3, CALL S03_PALPL_A ;
  34:         =4, JMP LBL[100] ;
  35:         =5, CALL S05_PR_INT ;
  36:         =6, CALL S06_REJECT ;
  37:         =7, CALL S07_LABEL ;
  38:         =8, CALL S08_CHK_LBL ;
  39:         =10, JMP LBL[101] ;
  40:         =11, CALL S11_DEP_INTB ;
  41:         =12, CALL S12_DEP_BUF ;
  42:         =13, CALL S13_PR_BUF ;
  43:         =14, CALL S14_SAMPLING ;
  44:         =15, CALL S15_REWORK ;
  45:         =16, CALL S16_REJ_RIB ;
  46:         =17, CALL S17_LABEL2 ;
  47:         =18, CALL S18_CHK_LBL2 ;
  48:  JMP LBL[102] ;
  49:   ;
  50:  LBL[100] ;
  51:  IF R[900:Tipo Macchina]=1 OR R[900:Tipo Macchina]=2, CALL S04_PALPLACE ;
  52:  IF R[900:Tipo Macchina]=3 OR R[900:Tipo Macchina]=4, CALL S04_PALPL_B ;
  53:  JMP LBL[102] ;
  54:   ;
  55:  LBL[101] ;
  56:  IF R[900:Tipo Macchina]=1 OR R[900:Tipo Macchina]=2, CALL S10_DEP_INT ;
  57:  IF R[900:Tipo Macchina]=3 OR R[900:Tipo Macchina]=4, CALL S10_DEP_INTA ;
  58:   ;
  59:  LBL[102] ;
  60:  IF R[20:TEST]=1, CALL S01_PR_CASE ;
  61:  IF R[20:TEST]=1 AND R[15:1_Test PALPL_B]=1 AND R[900:Tipo Macchina]=1, CALL S04_PALPLACE ;
  62:  IF R[20:TEST]=1 AND R[15:1_Test PALPL_B]=1 AND R[900:Tipo Macchina]=2, CALL S04_PALPLACE ;
  63:  IF R[20:TEST]=1 AND R[14:1_Test PALPL_A]=1 AND R[900:Tipo Macchina]=3, CALL S03_PALPL_A ;
  64:  IF R[20:TEST]=1 AND R[14:1_Test PALPL_A]=1 AND R[900:Tipo Macchina]=4, CALL S03_PALPL_A ;
  65:  IF R[20:TEST]=1 AND R[15:1_Test PALPL_B]=1, CALL S04_PALPL_B ;
  66:   ;
  67:   ;
  68:  JMP LBL[1] ;
  69:   ;
