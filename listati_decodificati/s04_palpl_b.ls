 131:  CALL CTRL_N(58,57,59,R[506:SogliaCtrlN J2_3],R[507:SogliaCtrlN J5],100,200) ;
 132:  IF (F[100]=OFF), JMP LBL[100] ;
 133:  JMP LBL[102] ;
