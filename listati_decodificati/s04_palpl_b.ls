  81:  PR[55,1:Centro Pallet]=-50 ;
  82:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]*0.7 ;
  83:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
  84:  PR[55,6:Centro Pallet]=PR[59,6:CoordProdDaDepos] ;
  85:   ;
  86:  ! IF NEEDED,RAISE TO 55,3 ;
  87:  PR[54:OutObstruction Z]=LPOS ;
