 212:  ! AND R=LAST DEPOSIT R ;
 213:  PR[55:Centro Pallet]=P[100:0Pallet_NUT] ;
 214:  PR[55,1:Centro Pallet]=R[107:Dim.X Pallet]/3 ;
 215:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]*0.6 ;
 216:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
 217:  PR[55,6:Centro Pallet]=PR[56,6:DistaccoVentose] ;
 218:  PR[9:Appoggio]=PR[55:Centro Pallet] ;
 219:  PR[9,3:Appoggio]=1600 ;
 220:   ;
 221:  PR[56:DistaccoVentose]=JPOS ;
