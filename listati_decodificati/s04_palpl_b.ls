   9:  IF R[1:RobotStatus]=1015 AND R[908:PosSampling]=1, JMP LBL[6] ;
  10:  IF R[1:RobotStatus]=1017, JMP LBL[6] ;
  11:  IF R[1:RobotStatus]=1018, JMP LBL[6] ;
