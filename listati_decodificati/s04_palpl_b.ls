/PROG S04_PALPL_B
   1:  R[55:Sec Deposito]=0 ;
   2:  COL DETECT ON ;
   3:   ;
   4:  IF R[1:RobotStatus]=1001, JMP LBL[6] ;
   5:  IF R[1:RobotStatus]=1007, JMP LBL[6] ;
   6:  IF R[1:RobotStatus]=1008, JMP LBL[6] ;
   7:  IF R[1:RobotStatus]=1013, JMP LBL[6] ;
