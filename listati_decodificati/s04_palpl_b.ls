 187:  PR[55,1:Centro Pallet]=R[107:Dim.X Pallet]/2 ;
 188:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]/2 ;
 189:  PR[55,3:Centro Pallet]=PR[58,3:PR59+Accostam]+R[126:Dim.Z Prod]+R[152:Avvic.Z Pallet] ;
 190:  PR[55,6:Centro Pallet]=PR[59,6:CoordProdDaDepos] ;
 191:  ! CORRECT PR55 TO HAVE ;
 192:  ! MINIMUM J6 MOVEMENT ;
 193:  CALL CORR_ANG(56,55) ;
 194:   ;
 195:  ! CORRECT PROBLEM L PR57 AFTER J P ;
 196:  IF (PR[55,6:Centro Pallet]>270)PR[55,6:Centro Pallet]=(PR[55,6:Centro Pallet]-360) ;
 197:  IF (PR[55,6:Centro Pallet]<-270)PR[55,6:Centro Pallet]=(PR[55,6:Centro Pallet]+360) ;
 198:   ;
