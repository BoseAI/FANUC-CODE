 235:  L PR[54:OutObstruction Z] 2000mm/sec CNT20 ;
 236:   ;
 237:  UFRAME[5]=PR[190:Frame PR+OFF] ;
 238:  UFRAME_NUM=5 ;
 239:  UTOOL[2]=PR[182:Tool A+B] ;
 240:  UTOOL_NUM=2 ;
