 277:  MESSAGE[..SEQUENCE ERROR..] ;
 278:  MESSAGE[..Status <> 1001 ..] ;
 279:  MESSAGE[..Status <> 1007 ..] ;
 280:  MESSAGE[..Status <> 1008 ..] ;
 281:  MESSAGE[..Status <> 1013 ..] ;
 282:  MESSAGE[..Status <> 1015 ..] ;
 283:  MESSAGE[..Status <> 1017 ..] ;
 284:  MESSAGE[..Status <> 1018 ..] ;
 285:  CALL ABORT ;
