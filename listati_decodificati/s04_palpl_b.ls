  56:  //! CORRECT PR55 TO HAVE ;
  57:  //! MINIMUM J6 MOVEMENT ;
  58:  //CALL CORR_ANG(54,55) ;
  59:   ;
  60:   ;
  61:   ;
  62:  LBL[30:2_Deposito] ;
