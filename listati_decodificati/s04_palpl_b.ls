 148:         =3, JMP LBL[43] ;
 149:   ;
 150:  LBL[41] ;
 151:  CALL ASPA_OFF ;
 152:  CALL ASPB_OFF ;
 153:  IF R[20:TEST]=1, JMP LBL[45] ;
 154:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
 155:  JMP LBL[45] ;
 156:   ;
 157:  LBL[42] ;
 158:  CALL ASPA_OFF ;
 159:  DO[82]=ON ;
 160:  WAIT DI[34:CaseReleaseChA]=ON OR R[20:TEST]=1 ;
 161:  JMP LBL[45] ;
 162:   ;
