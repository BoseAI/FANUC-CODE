  64:  PR[55,3:Centro Pallet]=(PR[54,3:OutObstruction Z]) ;
  65:  LBL[29] ;
  66:  ! NO MODIFIY CNT80 ;
  67:  L PR[55:Centro Pallet] 2000mm/sec CNT40 ;
  68:  JMP LBL[107] ;
  69:   ;
  70:  LBL[106] ;
  71:  R[1:RobotStatus]=4 ;
  72:  OVERRIDE=R[3:SpeedWithProd] ;
  73:  CALL PALCOORD ;
  74:   ;
