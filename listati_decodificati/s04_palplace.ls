/PROG S04_PALPLACE
   1:  R[55:Sec Deposito]=0 ;
   2:  COL DETECT ON ;
   3:   ;
   4:  IF R[1:RobotStatus]=1001, JMP LBL[7] ;
   5:  IF R[1:RobotStatus]=1007, JMP LBL[7] ;
   6:  IF R[1:RobotStatus]=1008, JMP LBL[6] ;
   7:  IF R[1:RobotStatus]=1013, JMP LBL[11] ;
   8:  IF R[1:RobotStatus]=1015, JMP LBL[6] ;
   9:  IF R[1:RobotStatus]=1017, JMP LBL[6] ;
  10:  IF R[1:RobotStatus]=1018, JMP LBL[6] ;
  11:   ;
  12:  JMP LBL[98] ;
  13:   ;
  14:  JMP LBL[6] ;
  15:  LBL[7] ;
  16:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  17:  UFRAME_NUM=5 ;
  18:  UTOOL[2]=PR[182:Tool A+B] ;
  19:  UTOOL_NUM=2 ;
  20:   ;
  21:  L P[4:UscPrelProd] 2000mm/sec CNT100 ;
  22:  LBL[11] ;
  23:  ! Change to World ;
  24:  UFRAME_NUM=9 ;
  25:  ! Load Position ;
  26:  PR[9:Appoggio]=LPOS ;
  27:  PR[9,1:Appoggio]=566 ;
  28:  ! Set static values ;
  29:  PR[9,3:Appoggio]=877 ;
  30:  ! Move Linear ;
  31:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
  32:  ! Set static values ;
  33:  PR[9,1:Appoggio]=566 ;
  34:  ! Change rotation only if nec. ;
  35:  IF (PR[9,6:Appoggio]<>90 AND PR[9,6:Appoggio]<>-90) THEN ;
  36:  PR[9,6:Appoggio]=90 ;
  37:  ENDIF ;
  38:  ! Move Linear ;
  39:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
  40:  ! Set static values ;
  41:  PR[9,2:Appoggio]=277 ;
  42:  ! Move Linear ;
  43:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
  44:   ;
  45:  LBL[6] ;
  46:   ;
  47:  R[1:RobotStatus]=4 ;
  48:  OVERRIDE=R[3:SpeedWithProd] ;
  49:  CALL PALCOORD ;
  50:   ;
  51:  DO[78:Out Obstruction PickUp]=ON ;
  52:   ;
  53:  UFRAME[5]=PR[189:Frame P_B+Off] ;
  54:  UFRAME_NUM=5 ;
  55:  UTOOL[2]=PR[182:Tool A+B] ;
  56:  UTOOL_NUM=2 ;
  57:   ;
  58:  PR[55:Centro Pallet]=P[100:0Pallet_NUT] ;
  59:  PR[55,1:Centro Pallet]=500 ;
  60:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]/2 ;
  61:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
  62:  PR[55,6:Centro Pallet]=PR[59,6:CoordProdDaDepos] ;
  63:   ;
  64:  ! IF CONSENT TO DEPAL ;
  65:  ! PR55,3 = PR57,3 ;
  66:  IF R[10:RqRobotMission]=103 AND R[20:TEST]=0, JMP LBL[106] ;
  67:  PR[55,3:Centro Pallet]=PR[57,3:PR58+Z Avvic] ;
  68:  ! LIMIT PR55,3 ;
  69:  ! TO MIN HEIGHT R461 ;
  70:  R[98:Appoggio]=PR[57,3:PR58+Z Avvic]-R[126:Dim.Z Prod] ;
  71:  IF R[98:Appoggio]>R[461:ZMinTraslPal], JMP LBL[106] ;
  72:  PR[55,3:Centro Pallet]=R[461:ZMinTraslPal]+R[126:Dim.Z Prod] ;
  73:  LBL[106] ;
  74:   ;
  75:  ! IF NEEDED,RAISE TO 55,3 ;
  76:  PR[54:OutObstruction Z]=LPOS ;
  77:   ;
  78:  ! Y MAX PACKAGING ;
  79:  PR[54,2:OutObstruction Z]=-300 ;
  80:  ! X,R CENTRE PALLET ;
  81:  PR[54,1:OutObstruction Z]=PR[55,1:Centro Pallet] ;
  82:  PR[54,6:OutObstruction Z]=PR[55,6:Centro Pallet] ;
  83:  ! Z CENTRE PALLET ;
  84:   ;
  85:  R[580:Appoggio]=PR[54,3:OutObstruction Z] ;
  86:  R[581:Appoggio]=PR[55,3:Centro Pallet] ;
  87:   ;
  88:  IF R[580:Appoggio]>R[581:Appoggio], JMP LBL[88] ;
  89:   ;
  90:  PR[54,3:OutObstruction Z]=PR[55,3:Centro Pallet] ;
  91:  L PR[54:OutObstruction Z] 2000mm/sec CNT100 ;
  92:   ;
  93:  LBL[88] ;
  94:   ;
  95:  ! CORRECT PR55 TO HAVE ;
  96:  ! MINIMUM J6 MOVEMENT ;
  97:  CALL CORR_ANG(54,55) ;
  98:   ;
  99:  LBL[30:2_Deposito] ;
 100:   ;
 101:  J PR[55:Centro Pallet] 100% CNT80 ;
 102:   ;
 103:  SELECT R[57:TipoDepCorrente]=0, JMP LBL[21] ;
 104:         =2, JMP LBL[22] ;
 105:         =3, JMP LBL[23] ;
 106:   ;
 107:  ! CARICO TOOL A+B ;
 108:  LBL[21] ;
 109:  UTOOL[2]=PR[182:Tool A+B] ;
 110:  UTOOL_NUM=2 ;
 111:  JMP LBL[25] ;
 112:   ;
 113:  ! CARICO TOOL A ;
 114:  LBL[22] ;
 115:  UTOOL[2]=PR[180:Tool A] ;
 116:  UTOOL_NUM=2 ;
 117:  JMP LBL[25] ;
 118:   ;
 119:  ! CARICO TOOL B ;
 120:  LBL[23] ;
 121:  UTOOL[2]=PR[181:Tool B] ;
 122:  UTOOL_NUM=2 ;
 123:  JMP LBL[25] ;
 124:   ;
 125:  LBL[25] ;
 126:  WAIT R[10:RqRobotMission]=104 OR R[20:TEST]=1 ;
 127:  DO[70:Out Obstruction Pallet B]=OFF ;
 128:  R[1:RobotStatus]=104 ;
 129:  L PR[57:PR58+Z Avvic] 2000mm/sec CNT20 ;
 130:   ;
 131:  IF R[506:SogliaCtrlN J2_3]=0, JMP LBL[101] ;
 132:  OVERRIDE=100 ;
 133:  F[99]=(OFF) ;
 134:  CALL CTRL_N(58,57,59,R[506:SogliaCtrlN J2_3],R[507:SogliaCtrlN J5],100,200) ;
 135:  IF (F[100]=OFF), JMP LBL[100] ;
 136:  JMP LBL[102] ;
 137:   ;
 138:  LBL[101:NoCollisionDet] ;
 139:  L PR[58:PR59+Accostam] 2000mm/sec CNT25 ;
 140:  L PR[59:CoordProdDaDepos] 2000mm/sec FINE ;
 141:   ;
 142:  LBL[102] ;
 143:  OVERRIDE=R[3:SpeedWithProd] ;
 144:  IF R[901:Pinze Presenti]=1, CALL GRIP_DIS ;
 145:  ! Rilascio Pacco ;
 146:   ;
 147:  IF DI[58:No Load Run]=ON, JMP LBL[45] ;
 148:  IF R[106:Sel_TipoAsp]=2, JMP LBL[41] ;
 149:   ;
 150:  SELECT R[57:TipoDepCorrente]=0, JMP LBL[41] ;
 151:         =2, JMP LBL[42] ;
 152:         =3, JMP LBL[43] ;
 153:   ;
 154:  LBL[41] ;
 155:  CALL ASPA_OFF ;
 156:  CALL ASPB_OFF ;
 157:  IF R[20:TEST]=1, JMP LBL[45] ;
 158:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
 159:  JMP LBL[46] ;
 160:   ;
 161:  LBL[42] ;
 162:  CALL ASPA_OFF ;
 163:  WAIT DI[34:CaseReleaseChA]=ON OR R[20:TEST]=1 ;
 164:  JMP LBL[46] ;
 165:   ;
 166:  LBL[43] ;
 167:  CALL ASPB_OFF ;
 168:  WAIT DI[38:CaseReleaseChB]=ON OR R[20:TEST]=1 ;
 169:  JMP LBL[46] ;
 170:   ;
 171:  LBL[45] ;
 172:  ! Solo ASP.A ;
 173:  CALL ASPA_OFF ;
 174:  LBL[46] ;
 175:  PR[56:DistaccoVentose]=PR[59:CoordProdDaDepos] ;
 176:  PR[56,3:DistaccoVentose]=PR[57,3:PR58+Z Avvic] ;
 177:   ;
 178:  ! Incremento puntatori ;
 179:  CALL STEP_UP ;
 180:  CALL PALCOORD ;
 181:   ;
 182:  L PR[56:DistaccoVentose] 2000mm/sec CNT100 ;
 183:   ;
 184:  IF R[56:TipoPrelCorrente]<>1, JMP LBL[26] ;
 185:  R[55:Sec Deposito]=1 ;
 186:   ;
 187:  UTOOL[2]=PR[182:Tool A+B] ;
 188:  ! RECALCULATE PR55 TO ;
 189:  ! X,Y= PALLET CENTER ;
 190:  ! Z=PR57,3 NOT LIMITED ;
 191:  PR[55:Centro Pallet]=P[100:0Pallet_NUT] ;
 192:  PR[55,1:Centro Pallet]=R[107:Dim.X Pallet]/2 ;
 193:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]/2 ;
 194:  PR[55,3:Centro Pallet]=PR[58,3:PR59+Accostam]+R[126:Dim.Z Prod]+R[152:Avvic.Z Pallet] ;
 195:  PR[55,6:Centro Pallet]=PR[59,6:CoordProdDaDepos] ;
 196:  ! CORRECT PR55 TO HAVE ;
 197:  ! MINIMUM J6 MOVEMENT ;
 198:  CALL CORR_ANG(56,55) ;
 199:   ;
 200:  ! CORRECT PROBLEM L PR57 AFTER J P ;
 201:  IF (PR[55,6:Centro Pallet]>270)PR[55,6:Centro Pallet]=(PR[55,6:Centro Pallet]-360) ;
 202:  IF (PR[55,6:Centro Pallet]<-270)PR[55,6:Centro Pallet]=(PR[55,6:Centro Pallet]+360) ;
 203:   ;
 204:  JMP LBL[30] ;
 205:   ;
 206:  LBL[26] ;
 207:   ;
 208:  R[55:Sec Deposito]=0 ;
 209:  R[37:=1 PhCaseInHead]=0 ;
 210:  OVERRIDE=R[2:NoProductSpeed] ;
 211:  R[1:RobotStatus]=1004 ;
 212:   ;
 213:  !  vai al centropallet ;
 214:  UTOOL[2]=PR[182:Tool A+B] ;
 215:  ! RECALCULATE PR55 TO ;
 216:  ! INITIAL ENTRY POINT ;
 217:  ! AND R=LAST DEPOSIT R ;
 218:  PR[55:Centro Pallet]=P[100:0Pallet_NUT] ;
 219:  PR[55,1:Centro Pallet]=500 ;
 220:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]/2 ;
 221:  PR[55,3:Centro Pallet]=PR[54,3:OutObstruction Z] ;
 222:  PR[55,6:Centro Pallet]=PR[56,6:DistaccoVentose] ;
 223:   ;
 224:  ! LIMIT PR55,3 ;
 225:  ! TO MIN HEIGHT R461 ;
 226:  R[98:Appoggio]=PR[55,3:Centro Pallet]+R[126:Dim.Z Prod] ;
 227:  IF R[98:Appoggio]<R[462:ZmaxHighLastRows], JMP LBL[116] ;
 228:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
 229:  LBL[116] ;
 230:   ;
 231:  ! CORRECT PR55 TO HAVE ;
 232:  ! MINIMUM J6 MOVEMENT ;
 233:  CALL CORR_ANG(56,55) ;
 234:   ;
 235:  J PR[55:Centro Pallet] 100% CNT100 ;
 236:  DO[70:Out Obstruction Pallet B]=ON ;
 237:   ;
 238:  ! WAIT CHANGE MISSION ;
 239:  ! FROM PLC ;
 240:  R[99:Appoggio]=0 ;
 241:  LBL[200] ;
 242:  IF R[10:RqRobotMission]=5, JMP LBL[990] ;
 243:  R[99:Appoggio]=R[99:Appoggio]+1 ;
 244:  IF R[99:Appoggio]>=20, JMP LBL[97] ;
 245:  IF DO[27:Rq Interlayer]=ON, JMP LBL[200] ;
 246:   ;
 247:  UFRAME[5]=PR[190:Frame PR+OFF] ;
 248:  UFRAME_NUM=5 ;
 249:  UTOOL[2]=PR[182:Tool A+B] ;
 250:  UTOOL_NUM=2 ;
 251:   ;
 252:  ! Change to World ;
 253:  UFRAME_NUM=9 ;
 254:  ! Load Position ;
 255:  PR[9:Appoggio]=LPOS ;
 256:  ! Set static values ;
 257:  PR[9,1:Appoggio]=566 ;
 258:  PR[9,2:Appoggio]=277 ;
 259:  PR[9,3:Appoggio]=887 ;
 260:  ! Move Linear ;
 261:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
 262:  ! Set static values ;
 263:  PR[9,2:Appoggio]=-300 ;
 264:  ! Move Linear ;
 265:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
 266:  ! Change to Pickup ;
 267:  UFRAME_NUM=5 ;
 268:  PR[8:Appoggio]=P[4:UscPrelProd] ;
 269:  PR[9:Appoggio]=PR[8:Appoggio] ;
 270:  ! Move Joint ;
 271:  J PR[9:Appoggio] 100% CNT10 ;
 272:  ! PR54=PREL_PROD ENTRY ;
 273:  ! POINT AT ACTUAL HEIGHT ;
 274:  PR[1:Appoggio]=LPOS ;
 275:  PR[54:OutObstruction Z]=P[3:EntrPrelProd] ;
 276:  R[98:Appoggio]=PR[1,3:Appoggio] ;
 277:  R[99:Appoggio]=PR[54,3:OutObstruction Z] ;
 278:  IF R[98:Appoggio]<=R[99:Appoggio], JMP LBL[120] ;
 279:  PR[54,3:OutObstruction Z]=R[98:Appoggio] ;
 280:  LBL[120] ;
 281:  ! NECESSARY J[PR54: ;
 282:  ! FOR RETURN IN INTERVAL ;
 283:  ! 180..-180 ;
 284:  J PR[54:OutObstruction Z] 100% CNT100 ;
 285:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
 286:   ;
 287:  END ;
 288:   ;
 289:  LBL[97] ;
 290:  MESSAGE[..................] ;
 291:  MESSAGE[..SEQUENCE ERROR..] ;
 292:  MESSAGE[..INTERLAYER FROM.. ] ;
 293:  MESSAGE[..PAL..] ;
 294:  CALL ABORT ;
 295:   ;
 296:  LBL[98] ;
 297:  MESSAGE[..................] ;
 298:  MESSAGE[..SEQUENCE ERROR..] ;
 299:  MESSAGE[..Status <> 1001 ..] ;
 300:  MESSAGE[..Status <> 1007 ..] ;
 301:  MESSAGE[..Status <> 1008 ..] ;
 302:  MESSAGE[..Status <> 1013 ..] ;
 303:  MESSAGE[..Status <> 1015 ..] ;
 304:  MESSAGE[..Status <> 1017 ..] ;
 305:  MESSAGE[..Status <> 1018 ..] ;
 306:  CALL ABORT ;
 307:   ;
 308:  LBL[99] ;
 309:  CALL ABORT ;
 310:  END ;
 311:   ;
 312:  LBL[100:CollisionDet] ;
 313:  MESSAGE[..................] ;
 314:  MESSAGE[....COLLISION.....] ;
 315:  MESSAGE[....DETECTED......] ;
 316:  MESSAGE[..................] ;
 317:  DO[45:Torque alarm]=PULSE,0.3sec ;
 318:  END ;
 319:   ;
 320:  LBL[990] ;
 321:  R[1:RobotStatus]=R[1:RobotStatus]+900 ;
 322:  OVERRIDE=R[2:NoProductSpeed] ;
 323:   ;
 324:  ! IF NEEDED,RAISE TO 55,3 ;
 325:  PR[54:OutObstruction Z]=LPOS ;
 326:  PR[54,1:OutObstruction Z]=0 ;
 327:  PR[54,2:OutObstruction Z]=R[108:Dim.Y Pallet]*0.4 ;
 328:  PR[54,3:OutObstruction Z]=R[682:OutObstruInt] ;
 329:  L PR[54:OutObstruction Z] 2000mm/sec CNT20 ;
 330:  IF R[902:CupsUP/DW Presen]=1, CALL CUPS_DW ;
 331:   ;
 332:  UFRAME[5]=PR[184:Frame Intlr+OFF] ;
 333:   ;
 334:  UFRAME_NUM=5 ;
 335:  UTOOL_NUM=3 ;
 336:   ;
 337:  J P[10:OutObstructionIt] 100% CNT100 ;
 338:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
 339:   ;
 340:  END ;
 341:   ;
 342:  J P[100:0Pallet_NUT] 100% CNT100 ;
/POS
P[3:EntrPrelProd]  UF:5 UT:2  X=-221.5 Y=148.0 Z=1100.0 W=-180.0 P=0.0 R=0.0
P[4:UscPrelProd]  UF:5 UT:2  X=-221.5 Y=148.0 Z=1378.0 W=-180.0 P=0.0 R=0.0
P[10:OutObstructionIt]  UF:5 UT:3  X=609.5 Y=-508.0 Z=850.0 W=-180.0 P=0.0 R=0.0
P[100:0Pallet_NUT]  UF:5 UT:1  X=0.0 Y=0.0 Z=0.0 W=-180.0 P=0.0 R=0.0
