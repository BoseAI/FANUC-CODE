/PROG S15_REWORK
   1:   ;
   2:  IF R[1:RobotStatus]=0, JMP LBL[1] ;
   3:  IF R[1:RobotStatus]=1003, JMP LBL[1] ;
   4:  IF R[1:RobotStatus]=1004, JMP LBL[1] ;
   5:  IF R[1:RobotStatus]=1006, JMP LBL[1] ;
   6:  IF R[1:RobotStatus]=1016, JMP LBL[1] ;
   7:  IF R[1:RobotStatus]=1014, JMP LBL[1] ;
   8:   ;
   9:  JMP LBL[98] ;
  10:   ;
  11:  LBL[1] ;
  12:  IF R[908:PosSampling]=3 AND R[1:RobotStatus]=1006, JMP LBL[100] ;
  13:   ;
  14:  OVERRIDE=R[2:NoProductSpeed] ;
  15:   ;
  16:  UFRAME_NUM=9 ;
  17:  UTOOL_NUM=1 ;
  18:  COL DETECT ON ;
  19:   ;
  20:  PR[9:Appoggio]=LPOS ;
  21:  R[97:Appoggio]=PR[9,1:Appoggio] ;
  22:  R[96:Appoggio]=PR[9,2:Appoggio] ;
  23:  R[95:Appoggio]=PR[9,3:Appoggio] ;
  24:   ;
  25:  IF R[97:Appoggio]<520, JMP LBL[2] ;
  26:  ! Robot in zona Pallet ;
  27:   ;
  28:  IF R[95:Appoggio]>100, JMP LBL[20] ;
  29:   ;
  30:  PR[9,3:Appoggio]=100 ;
  31:  L PR[9:Appoggio] 2000mm/sec FINE ;
  32:   ;
  33:  LBL[20] ;
  34:   ;
  35:  IF R[96:Appoggio]>0, JMP LBL[4] ;
  36:  ! Robot in zona Pallet A ;
  37:   ;
  38:  J P[120:ExitPalletA] 100% FINE ;
  39:   ;
  40:  JMP LBL[3] ;
  41:  LBL[4] ;
  42:  ! Robot in zona Pallet B ;
  43:   ;
  44:  J P[130:ExitPalletB] 100% FINE ;
  45:   ;
  46:  JMP LBL[3] ;
  47:  LBL[2] ;
  48:  ! Robot in zona Pickup Case ;
  49:  IF (R[95:Appoggio]<100) THEN ;
  50:  PR[9,3:Appoggio]=100 ;
  51:  L PR[9:Appoggio] 2000mm/sec FINE ;
  52:  ENDIF ;
  53:   ;
  54:  LBL[3] ;
  55:   ;
  56:  R[1:RobotStatus]=15 ;
  57:   ;
  58:  IF R[908:PosSampling]=1, JMP LBL[100] ;
  59:   ;
  60:  UFRAME[5]=PR[189:Frame P_B+Off] ;
  61:  UFRAME_NUM=5 ;
  62:  UTOOL[2]=PR[182:Tool A+B] ;
  63:  UTOOL_NUM=2 ;
  64:   ;
  65:  PR[55:Centro Pallet]=P[100:Zero] ;
  66:  PR[55,1:Centro Pallet]=70 ;
  67:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]*0.3 ;
  68:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
  69:   ;
  70:  ! IF NEEDED,RAISE TO 55,3 ;
  71:  PR[54:OutObstruction Z]=LPOS ;
  72:  PR[54,1:OutObstruction Z]=-200 ;
  73:  PR[54,2:OutObstruction Z]=-720 ;
  74:  PR[54,3:OutObstruction Z]=PR[55,3:Centro Pallet] ;
  75:  J PR[54:OutObstruction Z] 100% CNT80 ;
  76:   ;
  77:  ! CORRECT PR55 TO HAVE ;
  78:  ! MINIMUM J6 MOVEMENT ;
  79:  CALL CORR_ANG(54,55) ;
  80:   ;
  81:  J PR[55:Centro Pallet] 80% CNT100 ;
  82:  DO[78:Out Obstruction PickUp]=ON ;
  83:   ;
  84:  LBL[100] ;
  85:   ;
  86:  UFRAME[5]=PR[196:Frame Sampling] ;
  87:  UFRAME_NUM=5 ;
  88:  UTOOL[2]=PR[182:Tool A+B] ;
  89:  UTOOL_NUM=2 ;
  90:   ;
  91:  L P[3:EntrPrel] 2000mm/sec CNT5 ;
  92:  L P[2:AvvPrel] 2000mm/sec CNT3 ;
  93:   ;
  94:  WAIT R[10:RqRobotMission]=115 OR R[20:TEST]=1 ;
  95:   ;
  96:  L P[1:PosPrel] 2000mm/sec FINE ;
  97:   ;
  98:  ! Prelievo Pacco ;
  99:  IF DI[58:No Load Run]=ON, JMP LBL[45] ;
 100:   ;
 101:  IF R[106:Sel_TipoAsp]=2, JMP LBL[41] ;
 102:   ;
 103:  IF R[56:TipoPrelCorrente]=0 OR R[56:TipoPrelCorrente]=2, CALL ASPA_ON ;
 104:  IF R[56:TipoPrelCorrente]=0 OR R[56:TipoPrelCorrente]=3, CALL ASPB_ON ;
 105:  JMP LBL[45] ;
 106:  LBL[41] ;
 107:  CALL ASPA_ON ;
 108:  CALL ASPB_ON ;
 109:   ;
 110:  LBL[45] ;
 111:   ;
 112:  DO[44:Rq Inib All Prel Cartone]=OFF ;
 113:  IF DI[58:No Load Run]=ON, JMP LBL[46] ;
 114:   ;
 115:  SELECT R[56:TipoPrelCorrente]=0, JMP LBL[21] ;
 116:         =2, JMP LBL[22] ;
 117:         =3, JMP LBL[23] ;
 118:   ;
 119:  LBL[21] ;
 120:  WAIT (DI[33:CasePickUpChA]=ON AND DI[37:CasePickUpChB]=ON) ;
 121:  JMP LBL[46] ;
 122:   ;
 123:  LBL[22] ;
 124:  WAIT DI[33:CasePickUpChA]=ON ;
 125:  JMP LBL[46] ;
 126:   ;
 127:  LBL[23] ;
 128:  WAIT DI[37:CasePickUpChB]=ON ;
 129:  JMP LBL[46] ;
 130:   ;
 131:  LBL[46] ;
 132:   ;
 133:  IF R[901:Pinze Presenti]=0, JMP LBL[300] ;
 134:  IF R[902:CupsUP/DW Presen]=1, JMP LBL[300] ;
 135:  CALL GRIP_CL ;
 136:  WAIT DI[36:Grippers Closed]=ON ;
 137:  LBL[300] ;
 138:   ;
 139:  OVERRIDE=R[3:SpeedWithProd] ;
 140:   ;
 141:  L P[3:EntrPrel] 2000mm/sec CNT100 ;
 142:   ;
 143:   ;
 144:  IF R[908:PosSampling]=1, JMP LBL[101] ;
 145:   ;
 146:  UFRAME[5]=PR[189:Frame P_B+Off] ;
 147:  UFRAME_NUM=5 ;
 148:  UTOOL[2]=PR[182:Tool A+B] ;
 149:  UTOOL_NUM=2 ;
 150:   ;
 151:  J PR[55:Centro Pallet] 80% CNT100 ;
 152:  DO[70:Out Obstruction Pallet B]=ON ;
 153:  R[1:RobotStatus]=1015 ;
 154:   ;
 155:  //J PR[54:OutObstruction Z] 80% CNT100 ;
 156:   ;
 157:  LBL[101] ;
 158:  END ;
 159:   ;
 160:   ;
 161:  LBL[98] ;
 162:  MESSAGE[..................] ;
 163:  MESSAGE[..SEQUENCE ERROR..] ;
 164:  MESSAGE[..Status <> 0 ....] ;
 165:  MESSAGE[..Status <> 1003 ....] ;
 166:  MESSAGE[..Status <> 1004 ....] ;
 167:  MESSAGE[..Status <> 1006 ....] ;
 168:  MESSAGE[..Status <> 1014 ....] ;
 169:  MESSAGE[..Status <> 1016 ....] ;
 170:  MESSAGE[..Program Aborted.] ;
 171:  MESSAGE[..................] ;
 172:  CALL ABORT ;
 173:   ;
 174:  LBL[99] ;
 175:  CALL ABORT ;
 176:  J P[100:Zero] 100% CNT100 ;
 177:   ;
 178:   ;
/POS
P[1:PosPrel]  UF:5 UT:2  X=216.5 Y=168.0 Z=255.5 W=-180.0 P=0.0 R=0.0
P[2:AvvPrel]  UF:5 UT:2  X=216.5 Y=168.0 Z=661.0 W=-180.0 P=0.0 R=0.0
P[3:EntrPrel]  UF:5 UT:2  X=216.5 Y=168.0 Z=855.5 W=-180.0 P=0.0 R=0.0
P[100:Zero]  UF:5 UT:2  X=0.0 Y=0.0 Z=0.0 W=-180.0 P=0.0 R=0.0
P[120:ExitPalletA]  UF:9 UT:1  X=700.0 Y=-320.0 Z=250.0 W=180.0 P=0.0 R=0.0
P[130:ExitPalletB]  UF:9 UT:1  X=700.0 Y=320.0 Z=250.0 W=180.0 P=0.0 R=0.0
