/PROG S21_DEPPR
   1:  COL DETECT ON ;
   2:  UFRAME_NUM=8 ;
   3:  UTOOL_NUM=1 ;
   4:  ! Verifico da quale ciclo ;
   5:  ! proviene il robot e ;
   6:  ! scelgo la traiettoria ;
   7:  ! di conseguenza ;
   8:  IF R[1:RobotStatus]=0, JMP LBL[2] ;
   9:  IF R[1:RobotStatus]=1020, JMP LBL[2] ;
  10:  ! Non vengo da nessuno ;
  11:  ! dei cicli validi ;
  12:  ! Segnalazione allarme ;
  13:  JMP LBL[99] ;
  14:   ;
  15:  LBL[2] ;
  16:  ! Punto intermedio per ;
  17:  ! raggiungere il ;
  18:  ! prelievo prodotto ;
  19:  OVERRIDE=R[2:NoProductSpeed] ;
  20:   ;
  21:  R[1:RobotStatus]=21 ;
  22:   ;
  23:  R[42:OffsZLastLayer]=R[831:Z DepLastLayer]-R[827:Z DepositBundle] ;
  24:   ;
  25:  PR[8:Appoggio]=P[100:Zero] ;
  26:  IF R[799:NumLayersOnCase]=0, JMP LBL[3] ;
  27:  ! Not First Layer ;
  28:  R[99:Appoggio]=847+R[799:NumLayersOnCase] ;
  29:  PR[8,3:Appoggio]=R[R[99]]-R[827:Z DepositBundle] ;
  30:  LBL[3] ;
  31:   ;
  32:  R[798:ZLinearDepBundle]=R[834:Z ConsHopperUp]-R[827:Z DepositBundle]-PR[8,3:Appoggio] ;
  33:  R[41:OoPBundleDepAdv]=R[833:Z OutDepBundles]-R[834:Z ConsHopperUp] ;
  34:   ;
  35:  L P[13:FuoriIngDepProd] 2000mm/sec CNT100 ;
  36:  IF DI[92:Space_PalA]=ON, JMP LBL[11] ;
  37:  L P[12:AttesaDepProd] 2000mm/sec CNT100 <opz.EE> ;
  38:   ;
  39:  DO[91:WaitDeposBundle]=ON ;
  40:   ;
  41:  ! Discesa Robot in Deposito ;
  42:  WAIT R[10:RqRobotMission]=121 ;
  43:  LBL[11] ;
  44:  DO[91:WaitDeposBundle]=OFF ;
  45:  DO[67:OutOfObstructFromCasePak]=OFF ;
  46:  R[1:RobotStatus]=121 ;
  47:   ;
  48:  R[96:Appoggio]=1 ;
  49:  R[98:Appoggio]=R[799:NumLayersOnCase]+1 ;
  50:  IF R[98:Appoggio]=R[808:Layers on Case], JMP LBL[12] ;
  51:  R[96:Appoggio]=0 ;
  52:  LBL[12] ;
  53:  L P[11:Deposito Prod] 2000mm/sec CNT1 Offset,PR[8:Appoggio] <opz.EE> <opz.EA> <opz.02> <opz.83> <opz.1E> ;
  54:  IF R[901:Pinze Presenti]>=1, CALL GRIP_DIS ;
  55:  IF R[901:Pinze Presenti]=2, CALL GRIPT_DIS ;
  56:  IF R[902:CupsUP/DW Presen]>=1, CALL CUPS_DW ;
  57:  CALL CNT_PR ;
  58:  WAIT DI[62:Cups DW]=ON OR R[902:CupsUP/DW Presen]=0 ;
  59:   ;
  60:  CALL ASPA_OFF ;
  61:  CALL ASPB_OFF ;
  62:  $GROUP[1].$USE_TURNS=1 ;
  63:   ;
  64:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
  65:  OVERRIDE=R[2:NoProductSpeed] ;
  66:   ;
  67:  IF R[902:CupsUP/DW Presen]>=1, CALL CUPS_UP ;
  68:  L P[13:FuoriIngDepProd] 2000mm/sec CNT40 <opz.E9> <opz.02> <opz.83> <opz.1E> ;
  69:  IF R[901:Pinze Presenti]>=1, CALL GRIP_OP ;
  70:  IF R[901:Pinze Presenti]=2, CALL GRIPT_OP ;
  71:  DO[67:OutOfObstructFromCasePak]=ON ;
  72:   ;
  73:  R[1:RobotStatus]=1021 ;
  74:   ;
  75:  END ;
  76:   ;
  77:  LBL[99] ;
  78:  MESSAGE[..................] ;
  79:  MESSAGE[..SEQUENCE ERROR..] ;
  80:  MESSAGE[..Status <> 1020..] ;
  81:  CALL ABORT ;
  82:  END ;
  83:   ;
/POS
P[11:Deposito Prod]  UF:8 UT:1  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
P[12:AttesaDepProd]  UF:8 UT:1  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
P[13:FuoriIngDepProd]  UF:8 UT:1  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
P[50:Pickup_Entry]  UF:8 UT:1  X=-1350.0 Y=-300.0 Z=1750.0 W=180.0 P=0.0 R=0.0
P[100:Zero]  UF:5 UT:3  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
