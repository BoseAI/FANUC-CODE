/PROG S03_PALPLACE
   1:  R[55:Sec Deposito]=0 ;
   2:  COL DETECT ON ;
   3:   ;
   4:  IF R[1:RobotStatus]=1001, JMP LBL[7] ;
   5:  IF R[1:RobotStatus]=1007, JMP LBL[7] ;
   6:  IF R[1:RobotStatus]=1008, JMP LBL[7] ;
   7:  IF R[1:RobotStatus]=1013, JMP LBL[11] ;
   8:  IF R[1:RobotStatus]=1015, JMP LBL[6] ;
   9:  IF R[1:RobotStatus]=1017, JMP LBL[6] ;
  10:  IF R[1:RobotStatus]=1018, JMP LBL[6] ;
  11:   ;
  12:  JMP LBL[98] ;
  13:   ;
  14:  JMP LBL[6] ;
  15:  LBL[7] ;
  16:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  17:  UFRAME_NUM=5 ;
  18:  UTOOL[2]=PR[182:Tool A+B] ;
  19:  UTOOL_NUM=2 ;
  20:   ;
  21:  L P[4:UscPrelProd] 2000mm/sec CNT100 ;
  22:  LBL[11] ;
  23:  ! Change to World ;
  24:  UFRAME_NUM=9 ;
  25:  ! Load Position ;
  26:  PR[9:Appoggio]=LPOS ;
  27:  ! Set static values ;
  28:  PR[9,3:Appoggio]=887 ;
  29:  ! Move Linear ;
  30:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
  31:  ! Set static values ;
  32:  PR[9,1:Appoggio]=566 ;
  33:  ! Change rotation only if nec. ;
  34:  IF (PR[9,6:Appoggio]<>90 AND PR[9,6:Appoggio]<>-90) THEN ;
  35:  PR[9,6:Appoggio]=90 ;
  36:  ENDIF ;
  37:  ! Move Linear ;
  38:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
  39:  ! Set static values ;
  40:  PR[9,2:Appoggio]=277 ;
  41:  ! Move Linear ;
  42:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
  43:   ;
  44:  LBL[6] ;
  45:   ;
  46:  R[1:RobotStatus]=3 ;
  47:  OVERRIDE=R[3:SpeedWithProd] ;
  48:  CALL PALCOORD ;
  49:   ;
  50:  DO[78:Out Obstruction PickUp]=ON ;
  51:   ;
  52:  UFRAME[5]=PR[192:Frame P_A+Off] ;
  53:  UFRAME_NUM=5 ;
  54:  UTOOL[2]=PR[182:Tool A+B] ;
  55:  UTOOL_NUM=2 ;
  56:   ;
  57:  PR[55:Centro Pallet]=P[100:0Pallet_NUT] ;
  58:  PR[55,1:Centro Pallet]=500 ;
  59:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]/2 ;
  60:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
  61:  PR[55,6:Centro Pallet]=PR[59,6:CoordProdDaDepos] ;
  62:   ;
  63:  ! IF CONSENT TO DEPAL ;
  64:  ! PR55,3 = PR57,3 ;
  65:  IF R[10:RqRobotMission]=103 AND R[20:TEST]=0, JMP LBL[106] ;
  66:  PR[55,3:Centro Pallet]=PR[57,3:PR58+Z Avvic] ;
  67:  ! LIMIT PR55,3 ;
  68:  ! TO MIN HEIGHT R461 ;
  69:  R[98:Appoggio]=PR[57,3:PR58+Z Avvic]-R[126:Dim.Z Prod] ;
  70:  IF R[98:Appoggio]>R[461:ZMinTraslPal], JMP LBL[106] ;
  71:  PR[55,3:Centro Pallet]=R[461:ZMinTraslPal]+R[126:Dim.Z Prod] ;
  72:  LBL[106] ;
  73:   ;
  74:  ! IF NEEDED,RAISE TO 55,3 ;
  75:  PR[54:OutObstruction Z]=LPOS ;
  76:   ;
  77:  ! Y MAX PACKAGING ;
  78:  PR[54,2:OutObstruction Z]=-300 ;
  79:  ! X,R CENTRE PALLET ;
  80:  PR[54,1:OutObstruction Z]=PR[55,1:Centro Pallet] ;
  81:  PR[54,6:OutObstruction Z]=PR[55,6:Centro Pallet] ;
  82:  ! Z CENTRE PALLET ;
  83:   ;
  84:  R[580:Appoggio]=PR[54,3:OutObstruction Z] ;
  85:  R[581:Appoggio]=PR[55,3:Centro Pallet] ;
  86:   ;
  87:  IF R[580:Appoggio]>R[581:Appoggio], JMP LBL[88] ;
  88:   ;
  89:  PR[54,3:OutObstruction Z]=PR[55,3:Centro Pallet] ;
  90:  L PR[54:OutObstruction Z] 2000mm/sec CNT100 ;
  91:   ;
  92:  LBL[88] ;
  93:   ;
  94:  ! CORRECT PR55 TO HAVE ;
  95:  ! MINIMUM J6 MOVEMENT ;
  96:  CALL CORR_ANG(54,55) ;
  97:   ;
  98:  LBL[30:2_Deposito] ;
  99:   ;
 100:  J PR[55:Centro Pallet] 100% CNT80 ;
 101:   ;
 102:  SELECT R[57:TipoDepCorrente]=0, JMP LBL[21] ;
 103:         =2, JMP LBL[22] ;
 104:         =3, JMP LBL[23] ;
 105:   ;
 106:  ! CARICO TOOL A+B ;
 107:  LBL[21] ;
 108:  UTOOL[2]=PR[182:Tool A+B] ;
 109:  UTOOL_NUM=2 ;
 110:  JMP LBL[25] ;
 111:   ;
 112:  ! CARICO TOOL A ;
 113:  LBL[22] ;
 114:  UTOOL[2]=PR[180:Tool A] ;
 115:  UTOOL_NUM=2 ;
 116:  JMP LBL[25] ;
 117:   ;
 118:  ! CARICO TOOL B ;
 119:  LBL[23] ;
 120:  UTOOL[2]=PR[181:Tool B] ;
 121:  UTOOL_NUM=2 ;
 122:  JMP LBL[25] ;
 123:   ;
 124:  LBL[25] ;
 125:  WAIT R[10:RqRobotMission]=103 OR R[20:TEST]=1 ;
 126:  DO[69:Out Obstruction Pallet A]=OFF ;
 127:  R[1:RobotStatus]=103 ;
 128:  L PR[57:PR58+Z Avvic] 2000mm/sec CNT20 ;
 129:   ;
 130:  IF R[506:SogliaCtrlN J2_3]=0, JMP LBL[101] ;
 131:  OVERRIDE=100 ;
 132:  F[99]=(OFF) ;
 133:  CALL CTRL_N(58,57,59,R[506:SogliaCtrlN J2_3],R[507:SogliaCtrlN J5],100,200) ;
 134:  IF (F[100]=OFF), JMP LBL[100] ;
 135:  JMP LBL[102] ;
 136:   ;
 137:  LBL[101:NoCollisionDet] ;
 138:  L PR[58:PR59+Accostam] 2000mm/sec CNT25 ;
 139:  L PR[59:CoordProdDaDepos] 2000mm/sec FINE ;
 140:   ;
 141:  LBL[102] ;
 142:  OVERRIDE=R[3:SpeedWithProd] ;
 143:  IF R[901:Pinze Presenti]=1, CALL GRIP_DIS ;
 144:  ! Rilascio Pacco ;
 145:   ;
 146:  IF DI[58:No Load Run]=ON, JMP LBL[45] ;
 147:  IF R[106:Sel_TipoAsp]=2, JMP LBL[41] ;
 148:   ;
 149:  SELECT R[57:TipoDepCorrente]=0, JMP LBL[41] ;
 150:         =2, JMP LBL[42] ;
 151:         =3, JMP LBL[43] ;
 152:   ;
 153:  LBL[41] ;
 154:  CALL ASPA_OFF ;
 155:  CALL ASPB_OFF ;
 156:  IF R[20:TEST]=1, JMP LBL[45] ;
 157:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
 158:  JMP LBL[46] ;
 159:   ;
 160:  LBL[42] ;
 161:  CALL ASPA_OFF ;
 162:  WAIT DI[34:CaseReleaseChA]=ON OR R[20:TEST]=1 ;
 163:  JMP LBL[46] ;
 164:   ;
 165:  LBL[43] ;
 166:  CALL ASPB_OFF ;
 167:  WAIT DI[38:CaseReleaseChB]=ON OR R[20:TEST]=1 ;
 168:  JMP LBL[46] ;
 169:   ;
 170:  LBL[45] ;
 171:  ! Solo ASP.A ;
 172:  CALL ASPA_OFF ;
 173:  LBL[46] ;
 174:  PR[56:DistaccoVentose]=PR[59:CoordProdDaDepos] ;
 175:  PR[56,3:DistaccoVentose]=PR[57,3:PR58+Z Avvic] ;
 176:   ;
 177:  ! Incremento puntatori ;
 178:  CALL STEP_UP ;
 179:  CALL PALCOORD ;
 180:   ;
 181:  L PR[56:DistaccoVentose] 2000mm/sec CNT100 ;
 182:   ;
 183:  IF R[56:TipoPrelCorrente]<>1, JMP LBL[26] ;
 184:  R[55:Sec Deposito]=1 ;
 185:   ;
 186:  UTOOL[2]=PR[182:Tool A+B] ;
 187:  ! RECALCULATE PR55 TO ;
 188:  ! X,Y= PALLET CENTER ;
 189:  ! Z=PR57,3 NOT LIMITED ;
 190:  PR[55:Centro Pallet]=P[100:0Pallet_NUT] ;
 191:  PR[55,1:Centro Pallet]=R[107:Dim.X Pallet]/2 ;
 192:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]/2 ;
 193:  PR[55,3:Centro Pallet]=PR[58,3:PR59+Accostam]+R[126:Dim.Z Prod]+R[152:Avvic.Z Pallet] ;
 194:  PR[55,6:Centro Pallet]=PR[59,6:CoordProdDaDepos] ;
 195:  ! CORRECT PR55 TO HAVE ;
 196:  ! MINIMUM J6 MOVEMENT ;
 197:  CALL CORR_ANG(56,55) ;
 198:   ;
 199:  ! CORRECT PROBLEM L PR57 AFTER J P ;
 200:  IF (PR[55,6:Centro Pallet]>270)PR[55,6:Centro Pallet]=(PR[55,6:Centro Pallet]-360) ;
 201:  IF (PR[55,6:Centro Pallet]<-270)PR[55,6:Centro Pallet]=(PR[55,6:Centro Pallet]+360) ;
 202:   ;
 203:  JMP LBL[30] ;
 204:   ;
 205:  LBL[26] ;
 206:   ;
 207:  R[55:Sec Deposito]=0 ;
 208:  R[37:=1 PhCaseInHead]=0 ;
 209:  OVERRIDE=R[2:NoProductSpeed] ;
 210:  R[1:RobotStatus]=1003 ;
 211:   ;
 212:  !  vai al centropallet ;
 213:  UTOOL[2]=PR[182:Tool A+B] ;
 214:  ! RECALCULATE PR55 TO ;
 215:  ! INITIAL ENTRY POINT ;
 216:  ! AND R=LAST DEPOSIT R ;
 217:  PR[55:Centro Pallet]=P[100:0Pallet_NUT] ;
 218:  PR[55,1:Centro Pallet]=500 ;
 219:  PR[55,2:Centro Pallet]=R[108:Dim.Y Pallet]/2 ;
 220:  PR[55,3:Centro Pallet]=PR[54,3:OutObstruction Z] ;
 221:  PR[55,6:Centro Pallet]=PR[56,6:DistaccoVentose] ;
 222:   ;
 223:  ! LIMIT PR55,3 ;
 224:  ! TO MIN HEIGHT R461 ;
 225:  R[98:Appoggio]=PR[55,3:Centro Pallet]+R[126:Dim.Z Prod] ;
 226:  IF R[98:Appoggio]<R[462:ZmaxHighLastRows], JMP LBL[116] ;
 227:  PR[55,3:Centro Pallet]=R[462:ZmaxHighLastRows]+R[126:Dim.Z Prod] ;
 228:  LBL[116] ;
 229:   ;
 230:  ! CORRECT PR55 TO HAVE ;
 231:  ! MINIMUM J6 MOVEMENT ;
 232:  CALL CORR_ANG(56,55) ;
 233:   ;
 234:  J PR[55:Centro Pallet] 100% CNT100 ;
 235:  DO[69:Out Obstruction Pallet A]=ON ;
 236:   ;
 237:  ! WAIT CHANGE MISSION ;
 238:  ! FROM PLC ;
 239:  R[99:Appoggio]=0 ;
 240:  LBL[200] ;
 241:  IF R[10:RqRobotMission]=5, JMP LBL[990] ;
 242:  R[99:Appoggio]=R[99:Appoggio]+1 ;
 243:  IF R[99:Appoggio]>=20, JMP LBL[97] ;
 244:  IF DO[27:Rq Interlayer]=ON, JMP LBL[200] ;
 245:   ;
 246:  UFRAME[5]=PR[190:Frame PR+OFF] ;
 247:  UFRAME_NUM=5 ;
 248:  UTOOL[2]=PR[182:Tool A+B] ;
 249:  UTOOL_NUM=2 ;
 250:   ;
 251:  ! Change to World ;
 252:  UFRAME_NUM=9 ;
 253:  ! Load Position ;
 254:  PR[9:Appoggio]=LPOS ;
 255:  ! Set static values ;
 256:  PR[9,1:Appoggio]=566 ;
 257:  PR[9,2:Appoggio]=277 ;
 258:  PR[9,3:Appoggio]=887 ;
 259:  ! Move Linear ;
 260:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
 261:  ! Set static values ;
 262:  PR[9,2:Appoggio]=-300 ;
 263:  ! Move Linear ;
 264:  L PR[9:Appoggio] 2000mm/sec CNT50 ;
 265:  ! Change to Pickup ;
 266:  UFRAME_NUM=5 ;
 267:  PR[8:Appoggio]=P[4:UscPrelProd] ;
 268:  PR[9:Appoggio]=PR[8:Appoggio] ;
 269:  ! Move Joint ;
 270:  J PR[9:Appoggio] 100% CNT80 ;
 271:  ! PR54=PREL_PROD ENTRY ;
 272:  ! POINT AT ACTUAL HEIGHT ;
 273:  PR[1:Appoggio]=LPOS ;
 274:  PR[54:OutObstruction Z]=P[3:EntrPrelProd] ;
 275:  R[98:Appoggio]=PR[1,3:Appoggio] ;
 276:  R[99:Appoggio]=PR[54,3:OutObstruction Z] ;
 277:  IF R[98:Appoggio]<=R[99:Appoggio], JMP LBL[120] ;
 278:  PR[54,3:OutObstruction Z]=R[98:Appoggio] ;
 279:  LBL[120] ;
 280:  ! NECESSARY J[PR54: ;
 281:  ! FOR RETURN IN INTERVAL ;
 282:  ! 180..-180 ;
 283:  J PR[54:OutObstruction Z] 100% CNT100 ;
 284:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
 285:   ;
 286:  END ;
 287:   ;
 288:  LBL[97] ;
 289:  MESSAGE[..................] ;
 290:  MESSAGE[..SEQUENCE ERROR..] ;
 291:  MESSAGE[..INTERLAYER FROM.. ] ;
 292:  MESSAGE[..PAL..] ;
 293:  CALL ABORT ;
 294:   ;
 295:  LBL[98] ;
 296:  MESSAGE[..................] ;
 297:  MESSAGE[..SEQUENCE ERROR..] ;
 298:  MESSAGE[..Status <> 1001 ..] ;
 299:  MESSAGE[..Status <> 1007 ..] ;
 300:  MESSAGE[..Status <> 1008 ..] ;
 301:  MESSAGE[..Status <> 1013 ..] ;
 302:  MESSAGE[..Status <> 1015 ..] ;
 303:  MESSAGE[..Status <> 1017 ..] ;
 304:  MESSAGE[..Status <> 1018 ..] ;
 305:  CALL ABORT ;
 306:   ;
 307:  LBL[99] ;
 308:  CALL ABORT ;
 309:  END ;
 310:   ;
 311:  LBL[100:CollisionDet] ;
 312:  MESSAGE[..................] ;
 313:  MESSAGE[....COLLISION.....] ;
 314:  MESSAGE[....DETECTED......] ;
 315:  MESSAGE[..................] ;
 316:  DO[45:Torque alarm]=PULSE,0.3sec ;
 317:  END ;
 318:   ;
 319:  LBL[990] ;
 320:  R[1:RobotStatus]=R[1:RobotStatus]+900 ;
 321:  OVERRIDE=R[2:NoProductSpeed] ;
 322:   ;
 323:  ! IF NEEDED,RAISE TO 55,3 ;
 324:  PR[54:OutObstruction Z]=LPOS ;
 325:  PR[54,1:OutObstruction Z]=0 ;
 326:  PR[54,2:OutObstruction Z]=R[108:Dim.Y Pallet]*0.4 ;
 327:  PR[54,3:OutObstruction Z]=R[682:OutObstruInt] ;
 328:  L PR[54:OutObstruction Z] 2000mm/sec CNT20 ;
 329:  IF R[902:CupsUP/DW Presen]=1, CALL CUPS_DW ;
 330:   ;
 331:  UFRAME[5]=PR[184:Frame Intlr+OFF] ;
 332:   ;
 333:  UFRAME_NUM=5 ;
 334:  UTOOL_NUM=3 ;
 335:   ;
 336:  J P[10:OutObstructionIt] 100% CNT100 ;
 337:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
 338:   ;
 339:  END ;
 340:   ;
 341:  J P[100:0Pallet_NUT] 100% CNT100 ;
/POS
P[3:EntrPrelProd]  UF:5 UT:2  X=-196.5 Y=-158.0 Z=1100.0 W=-180.0 P=0.0 R=180.0
P[4:UscPrelProd]  UF:5 UT:2  X=-196.5 Y=-158.0 Z=1355.5 W=-180.0 P=0.0 R=180.0
P[10:OutObstructionIt]  UF:5 UT:3  X=609.5 Y=-508.0 Z=850.0 W=-180.0 P=0.0 R=0.0
P[100:0Pallet_NUT]  UF:5 UT:1  X=0.0 Y=0.0 Z=0.0 W=-180.0 P=0.0 R=0.0
