/PROG S10_DEP_INT
   1:   ;
   2:  IF R[1:RobotStatus]=1005, JMP LBL[3] ;
   3:  JMP LBL[98] ;
   4:   ;
   5:  LBL[3] ;
   6:  R[1:RobotStatus]=10 ;
   7:  UFRAME[5]=PR[192:Frame P_A+Off] ;
   8:  UFRAME_NUM=5 ;
   9:  UTOOL_NUM=3 ;
  10:   ;
  11:  L PR[55:Centro Pallet] 2000mm/sec CNT70 ;
  12:   ;
  13:   ;
  14:  DO[69:Out Obstruction Pallet A]=OFF ;
  15:   ;
  16:  WAIT R[10:RqRobotMission]=110 OR R[20:TEST]=1 ;
  17:  PR[54:OutObstruction Z]=LPOS ;
  18:  PR[44,6:Deposito Intl]=PR[54,6:OutObstruction Z] ;
  19:  PR[45,6:Avvic Dep Intl]=PR[54,6:OutObstruction Z] ;
  20:  L PR[45:Avvic Dep Intl] 2000mm/sec CNT100 ;
  21:  DO[44:Rq Inib All Prel Cartone]=OFF ;
  22:   ;
  23:  L PR[44:Deposito Intl] 2000mm/sec CNT5 <opz.EE> ;
  24:   ;
  25:   ;
  26:  IF DI[58:No Load Run]=ON, JMP LBL[225] ;
  27:  IF R[106:Sel_TipoAsp]=0, JMP LBL[221] ;
  28:  SELECT R[114:Sel_InterTipoAsp]=2, JMP LBL[221] ;
  29:         =3, JMP LBL[222] ;
  30:         =0, JMP LBL[223] ;
  31:   ;
  32:  LBL[221] ;
  33:  CALL ASPA_OFF ;
  34:  WAIT DI[34:CaseReleaseChA]=ON OR R[20:TEST]=1 ;
  35:  JMP LBL[225] ;
  36:   ;
  37:  LBL[222] ;
  38:  CALL ASPB_OFF ;
  39:  WAIT DI[38:CaseReleaseChB]=ON OR R[20:TEST]=1 ;
  40:  JMP LBL[225] ;
  41:   ;
  42:  LBL[223] ;
  43:  CALL ASPA_OFF ;
  44:  CALL ASPB_OFF ;
  45:  IF R[20:TEST]=1, JMP LBL[225] ;
  46:  WAIT DI[34:CaseReleaseChA]=ON AND DI[38:CaseReleaseChB]=ON ;
  47:  JMP LBL[225] ;
  48:   ;
  49:  LBL[225] ;
  50:   ;
  51:  R[30:RqIntlTopPallet]=0 ;
  52:   ;
  53:  R[43]=2 ;
  54:  CALL V_CNT_P ;
  55:  R[25:IntlHeight]=R[25:IntlHeight]+R[136:IntlThickness] ;
  56:   ;
  57:  L PR[45:Avvic Dep Intl] 2000mm/sec CNT100 ;
  58:   ;
  59:  R[1:RobotStatus]=1010 ;
  60:  L PR[55:Centro Pallet] 2000mm/sec CNT70 ;
  61:  IF R[902:CupsUP/DW Presen]=1, CALL CUPS_UP ;
  62:   ;
  63:  DO[69:Out Obstruction Pallet A]=ON ;
  64:   ;
  65:  ! WAIT CHANGE MISSION ;
  66:  ! FROM PLC ;
  67:  R[99:Appoggio]=0 ;
  68:  LBL[200] ;
  69:  IF R[10:RqRobotMission]=5, JMP LBL[990] ;
  70:  R[99:Appoggio]=R[99:Appoggio]+1 ;
  71:  IF R[99:Appoggio]>=20, JMP LBL[97] ;
  72:  IF DO[27:Rq Interlayer]=ON, JMP LBL[200] ;
  73:   ;
  74:  UFRAME[5]=PR[190:Frame PR+OFF] ;
  75:  UFRAME_NUM=5 ;
  76:  UTOOL[2]=PR[182:Tool A+B] ;
  77:  UTOOL_NUM=2 ;
  78:  ! PR54=PREL_PROD ENTRY ;
  79:  ! POINT AT ACTUAL HEIGHT ;
  80:  PR[1:Appoggio]=LPOS ;
  81:  PR[54:OutObstruction Z]=P[3:EntrPrelProd] ;
  82:  R[98:Appoggio]=PR[1,3:Appoggio] ;
  83:  R[99:Appoggio]=PR[54,3:OutObstruction Z] ;
  84:  IF R[98:Appoggio]<=R[99:Appoggio], JMP LBL[120] ;
  85:  PR[54,3:OutObstruction Z]=R[98:Appoggio] ;
  86:  LBL[120] ;
  87:  ! NECESSARY J[PR54: ;
  88:  ! FOR RETURN IN INTERVAL ;
  89:  ! 180..-180 ;
  90:  J PR[54:OutObstruction Z] 100% CNT100 ;
  91:   ;
  92:  END ;
  93:   ;
  94:  LBL[97] ;
  95:  MESSAGE[..................] ;
  96:  MESSAGE[..SEQUENCE ERROR..] ;
  97:  MESSAGE[..INTERLAYER FROM ] ;
  98:  MESSAGE[..DEP INT..] ;
  99:  CALL ABORT ;
 100:   ;
 101:  LBL[98] ;
 102:  MESSAGE[..................] ;
 103:  MESSAGE[..SEQUENCE ERROR..] ;
 104:  MESSAGE[..Status <> 1005 ..] ;
 105:  MESSAGE[..Program Aborted.] ;
 106:  MESSAGE[..................] ;
 107:  CALL ABORT ;
 108:   ;
 109:  ! OUT OBSTRUCTION ;
 110:  ! FOR PICKUP INTERLAYER ;
 111:  LBL[990] ;
 112:  R[1:RobotStatus]=R[1:RobotStatus]+900 ;
 113:   ;
 114:  OVERRIDE=R[2:NoProductSpeed] ;
 115:   ;
 116:  ! IF NEEDED,RAISE TO 55,3 ;
 117:  PR[54:OutObstruction Z]=LPOS ;
 118:  PR[54,1:OutObstruction Z]=0 ;
 119:  PR[54,2:OutObstruction Z]=R[108:Dim.Y Pallet]*0.4 ;
 120:  PR[54,3:OutObstruction Z]=R[682:OutObstruInt] ;
 121:  L PR[54:OutObstruction Z] 2000mm/sec CNT50 ;
 122:   ;
 123:  UFRAME[5]=PR[184:Frame Intlr+OFF] ;
 124:   ;
 125:  UFRAME_NUM=5 ;
 126:  UTOOL_NUM=3 ;
 127:   ;
 128:  IF R[901:Pinze Presenti]=1, CALL GRIP_OP ;
 129:  L P[10:OutObstructionIt] 2000mm/sec CNT100 ;
 130:   ;
 131:  END ;
 132:   ;
/POS
P[3:EntrPrelProd]  UF:5 UT:2  X=-196.5 Y=-158.0 Z=1100.0 W=-180.0 P=0.0 R=180.0
P[10:OutObstructionIt]  UF:5 UT:3  X=609.5 Y=-508.0 Z=850.0 W=-180.0 P=0.0 R=0.0
