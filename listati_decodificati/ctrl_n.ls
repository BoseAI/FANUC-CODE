/PROG CTRL_N
   1:  JMP LBL[999] ;
   2:  ! Questo programma esegue una skip ;
   3:  ! collision partendo da un ;
   4:  ! punto memorizzato appena prima ;
   5:  ! della chiamata tramite un CALL. ;
   6:  ! E' necessario passare come ;
   7:  ! argomenti alcuni parametri: ;
   8:  ! AR[1] = Numero del Position ;
   9:  ! Register che contiene la ;
  10:  ! posizione di destinazione. ;
  11:  ! AR[2] = Numero del position ;
  12:  ! Register che contiene la ;
  13:  ! posizione di ritorno in caso di ;
  14:  ! COLLISIONE AVVENUTA. ;
  15:  ! Per evitare che il robot si ;
  16:  ! muova in caso di mancata ;
  17:  ! collisione impostare tale valore ;
  18:  ! uguale a zero. ;
  19:  ! AR[3] = Numero del position ;
  20:  ! Register che contiene la ;
  21:  ! posizione di ritorno in caso di ;
  22:  ! COLLISIONE NON AVVENUTA. ;
  23:  ! Per evitare che il robot si ;
  24:  ! muova in caso di mancata ;
  25:  ! collisione impostare tale valore ;
  26:  ! uguale a zero. ;
  27:  ! AR[4] = Soglia di ;
  28:  ! sensibilita' AX2 e AX3 da ;
  29:  ! utilizzare durante la ricerca. ;
  30:  ! Nel caso di calcolo soglia auto- ;
  31:  ! matico il dato viene sommato al ;
  32:  ! valore rilevato altrimenti ;
  33:  ! risulta essere la soglia vera ;
  34:  ! e propria di torsione. ;
  35:  ! AR[5] = Soglia di ;
  36:  ! sensibilita' AX5 da ;
  37:  ! utilizzare durante la ricerca. ;
  38:  ! Nel caso di calcolo soglia auto- ;
  39:  ! matico il dato viene sommato al ;
  40:  ! valore rilevato altrimenti ;
  41:  ! risulta essere la soglia vera ;
  42:  ! e propria di torsione. ;
  43:  ! AR[6] = Distanza in mm dal ;
  44:  ! punto di inizio ricerca neces- ;
  45:  ! saria a stabilizzare il valore ;
  46:  ! di torsione sul motore. ;
  47:  ! Se impostato a zero il calcolo ;
  48:  ! di soglia automatico viene ;
  49:  ! disabilitato e la soglia inseri- ;
  50:  ! nell'AR[4] deve essere quella ;
  51:  ! reale sul motore. ;
  52:  ! AR [7] = E' la velocit  alla ;
  53:  ! quale verr  effettuata la ;
  54:  ! ricerca. E' da intendersi in ;
  55:  ! mm/sec. ;
  56:  ! AR [8] = n. del DI da controllar ;
  57:  ! Se F[99]=Off, si può omettere ;
  58:   ;
  59:  ! ******************************** ;
  60:  ! ******************************** ;
  61:   ;
  62:  ! LA LISTA DEI PARAMETRI USATI ;
  63:  ! E LA LOGICA PER MODIFICARLI ;
  64:  ! SONO ALLA FINE DEL PROGRAMMA. ;
  65:   ;
  66:  ! ******************************** ;
  67:  ! ******************************** ;
  68:  LBL[999] ;
  69:  COL DETECT ON ;
  70:   ;
  71:  R[694:J2 errors]=0 ;
  72:  R[693:J3 errors]=0 ;
  73:  R[692:J5 errors]=0 ;
  74:  R[696:Distanza Start]=AR[6] ;
  75:  R[695:Vel Ricerca mm/s]=AR[7] ;
  76:  IF R[696:Distanza Start]=0, JMP LBL[20] ;
  77:   ;
  78:  $SCR_GRP[1].$M_POS_ENB=1 ;
  79:  $SCR_GRP[1].$M_DST_ENB=1 ;
  80:  $SCR_GRP[1].$MOVE_DST=0 ;
  81:   ;
  82:  ! R[700:Soglia+Appl Ax2]=100*1.001 ;
  83:  ! R[699:Soglia-Appl Ax2 ]=100*(-1. ;
  84:  ! R[694:Soglia+Appl Ax3]=100*1.001 ;
  85:  ! R[693:Soglia-Appl Ax3]=100*(-1.0 ;
  86:  ! R[692:Soglia+Appl Ax5]=100*1.001 ;
  87:  ! R[691:Soglia-Appl Ax5]=100*(-1.0 ;
  88:   ;
  89:  LBL[20] ;
  90:  PR[48:PosStartRicerca]=LPOS-LPOS ;
  91:  PR[48,3:PosStartRicerca]=0+R[696:Distanza Start] ;
  92:  IF (F[99]=ON), JMP LBL[31] ;
  93:  ! Ctrl DI disabilitato ;
  94:   ;
  95:  SKIP CONDITION R[694:J2 errors]>=R[479:J2 Torque toll] OR R[693:J3 errors]>=R[480:J3 Torque toll] OR R[692:J5 errors]>=R[481:J5 Torque toll] ;
  96:  JMP LBL[10] ;
  97:   ;
  98:  LBL[31] ;
  99:  ! Ctrl DI abilitato ;
 100:  SKIP CONDITION R[694:J2 errors]=R[479:J2 Torque toll] OR R[693:J3 errors]=R[480:J3 Torque toll] OR R[692:J5 errors]=R[481:J5 Torque toll] OR DI[AR[8]]=ON ;
 101:   ;
 102:  LBL[10] ;
 103:   ;
 104:  F[100]=(OFF) ;
 105:  R[698:Indice StopPrg]=0 ;
 106:   ;
 107:  ! Se vengono modificati i ;
 108:  ! parametri   necessario ;
 109:  ! anche modificare gli argomenti ;
 110:  ! nella CALL successiva per ;
 111:  ! il corretto funzionamento del ;
 112:  ! programma. ;
 113:  ! Fare riferimento alla lista ;
 114:  ! alla fine del programma. ;
 115:   ;
 116:  IF R[696:Distanza Start]=0, JMP LBL[21] ;
 117:   ;
 118:  CALL RUN_MT03(AR[6],AR[4],23,698,694,693,692,AR[5],1) ;
 119:  DO[23:Torque check active]=ON ;
 120:  LBL[21:Test collision] ;
 121:  ! L PR[AR[1]] R[695]mm/sec CNT100 ;
 122:  L PR[AR[1]] R[695]mm/sec CNT10 Skip,LBL[99],PR[49:PosPezzoTrovato]=LPOS ;
 123:   ;
 124:  DO[23:Torque check active]=OFF ;
 125:  R[698:Indice StopPrg]=100 ;
 126:  !   PR[49]=LPOS ;
 127:  ! Ctrl collisione avvenuta ;
 128:  ! o DI impegnata ;
 129:  IF (F[99]=OFF), JMP LBL[103] ;
 130:  IF DI[AR[8]]=ON, JMP LBL[102] ;
 131:  LBL[103] ;
 132:  R[697:Appoggio CTRL_N]=AR[2] ;
 133:  IF R[697:Appoggio CTRL_N]=0, JMP LBL[100] ;
 134:   ;
 135:  ! Movimento in caso di ;
 136:  ! collisione avvenuta ;
 137:   ;
 138:  L PR[AR[2]] R[695]mm/sec FINE ;
 139:   ;
 140:  LBL[100] ;
 141:  END ;
 142:   ;
 143:  LBL[99:No collision] ;
 144:  DO[23:Torque check active]=OFF ;
 145:  R[698:Indice StopPrg]=100 ;
 146:  F[100]=(ON) ;
 147:  PR[49:PosPezzoTrovato]=LPOS ;
 148:  R[697:Appoggio CTRL_N]=AR[3] ;
 149:  IF R[697:Appoggio CTRL_N]=0, JMP LBL[101] ;
 150:   ;
 151:  ! Movimento in caso di ;
 152:  ! collisione NON avvenuta. ;
 153:   ;
 154:  L PR[AR[3]] R[695]mm/sec FINE ;
 155:   ;
 156:  LBL[101] ;
 157:  END ;
 158:   ;
 159:  LBL[102:LetturaFTC] ;
 160:  R[698:Indice StopPrg]=100 ;
 161:  F[100]=(ON) ;
 162:  END ;
 163:   ;
 164:  ! ******************************** ;
 165:  ! ******************************** ;
 166:   ;
 167:  ! ***  LISTA PARAMETRI USATI  *** ;
 168:  ! ***      NEL PROGRAMMA      *** ;
 169:   ;
 170:  ! F[100] = Risultato ricerca ;
 171:  !     ON = Collisione avvenuta ;
 172:  !    OFF = Collisione non avvenuta ;
 173:  ! F[99]  = Abilita ctrl DI ;
 174:  !   ON = Ctrl DI[xxx] abilitato ;
 175:  !  OFF = Ctrl DI[xxx] disabilitato ;
 176:  ! R[700] = Soglia positiva Asse2 ;
 177:  ! R[699] = Soglia negativa Asse2 ;
 178:  ! R[698] = Indice di esecuzione pe ;
 179:  !         arrestare il programma ;
 180:  !         in multy tasking. ;
 181:  ! R[697] = Appoggio Ctrl_N ;
 182:  ! R[696] = Distanza dallo start ;
 183:  ! R[695] = Velocita di ricerca mm/ ;
 184:  ! R[694] = Soglia positiva Asse3 ;
 185:  ! R[693] = Soglia negativa Asse3 ;
 186:   ;
 187:  ! PR[48] = Posiz. iniziale ricerc ;
 188:  ! PR[49] = Posiz. pezzo trovato ;
 189:   ;
