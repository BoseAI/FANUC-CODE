/PROG PAL_DATA
   1:  ! Leggo e carico i dati ;
   2:  ! del Pallet ;
   3:  R[17:DataCount]=0 ;
   4:  IF R[12:Data Flow In]=19, JMP LBL[3] ;
   5:  ! IF R[12:Data Flow In]=9,JMP LB ;
   6:  JMP LBL[1] ;
   7:   ;
   8:  LBL[3:Init. variables] ;
   9:   ;
  10:  R[19:MemPointer]=60 ;
  11:  ! JMP LBL[1] ;
  12:  ! LBL[4] ;
  13:  ! R[19:MemPointer]=120 ;
  14:   ;
  15:  ! Scrittura dati Pallet ;
  16:  LBL[1:Record data] ;
  17:   ;
  18:  IF R[17:DataCount]>=24, JMP LBL[2] ;
  19:  R[18:InputPointer]=R[17:DataCount]+2 ;
  20:   ;
  21:  ! PR[R[49],1]=GI[R[18]] ;
  22:   ;
  23:  ! R[18:InputPointer]=R[48:Punt ;
  24:   ;
  25:  ! PR[R[49],2]=GI[R[18]] ;
  26:   ;
  27:  ! R[18:InputPointer]=R[48:Punt ;
  28:   ;
  29:  ! PR[R[49],6]=GI[R[18]] ;
  30:   ;
  31:  CALL SET_PR(R[19:MemPointer],R[18:InputPointer]) ;
  32:  ! Azzero gli altri ;
  33:  ! componenti per ;
  34:  ! inizializzare il ;
  35:  ! vettore punto ;
  36:   ;
  37:  ! PR[R[49],3]=0 ;
  38:  ! PR[R[49],4]=0 ;
  39:  ! PR[R[49],5]=0 ;
  40:   ;
  41:   ;
  42:  R[17:DataCount]=R[17:DataCount]+3 ;
  43:  R[19:MemPointer]=R[19:MemPointer]+1 ;
  44:  JMP LBL[1] ;
  45:  LBL[2:End recording] ;
  46:   ;
