/PROG GET_DAT
   1:  ! Leggo e carico i dati ;
   2:  ! dai GI ;
   3:   ;
   4:  R[17:DataCount]=0 ;
   5:  IF R[12:Data Flow In]>=1 AND R[12:Data Flow In]<=2, JMP LBL[10] ;
   6:  IF R[12:Data Flow In]=3, JMP LBL[11] ;
   7:  IF R[12:Data Flow In]=4, JMP LBL[13] ;
   8:  IF R[12:Data Flow In]>=5 AND R[12:Data Flow In]<=6, JMP LBL[4] ;
   9:  IF R[12:Data Flow In]=7, JMP LBL[5] ;
  10:  IF R[12:Data Flow In]=8, JMP LBL[6] ;
  11:  IF R[12:Data Flow In]>=9 AND R[12:Data Flow In]<=13, JMP LBL[7] ;
  12:  IF R[12:Data Flow In]>=14 AND R[12:Data Flow In]<=18, JMP LBL[8] ;
  13:  IF R[12:Data Flow In]=34, JMP LBL[12] ;
  14:  IF R[12:Data Flow In]>=35 AND R[12:Data Flow In]<=37, JMP LBL[15] ;
  15:   ;
  16:  LBL[4:GROUP5_6] ;
  17:  ! PACCHETTI 5-6 (R100-R147) ;
  18:  R[16:Aux Size Change]=R[12:Data Flow In]-5 ;
  19:   ;
  20:  R[19:MemPointer]=24*R[16:Aux Size Change] ;
  21:   ;
  22:  R[19:MemPointer]=100+R[19:MemPointer] ;
  23:   ;
  24:  JMP LBL[1] ;
  25:   ;
  26:  LBL[5:GROUP7] ;
  27:  ! PACCHETTO 7 ;
  28:  R[19:MemPointer]=276 ;
  29:  JMP LBL[1] ;
  30:   ;
  31:  LBL[12:GROUP34] ;
  32:  ! PACCHETTO 34 ;
  33:  R[19:MemPointer]=300 ;
  34:  JMP LBL[1] ;
  35:   ;
  36:  LBL[6:GROUP8] ;
  37:  ! PACCHETTO 8 ;
  38:  R[19:MemPointer]=500 ;
  39:  JMP LBL[1] ;
  40:   ;
  41:  LBL[7:GROUP9_13] ;
  42:  ! PACCHETTI 9-13 (R340-R459) ;
  43:  R[16:Aux Size Change]=R[12:Data Flow In]-9 ;
  44:   ;
  45:  R[19:MemPointer]=24*R[16:Aux Size Change] ;
  46:   ;
  47:  R[19:MemPointer]=340+R[19:MemPointer] ;
  48:   ;
  49:  JMP LBL[1] ;
  50:   ;
  51:  LBL[8:GROUP14_18] ;
  52:  ! PACCHETTI 14-18 (R540-R659) ;
  53:  R[16:Aux Size Change]=R[12:Data Flow In]-14 ;
  54:   ;
  55:  R[19:MemPointer]=24*R[16:Aux Size Change] ;
  56:   ;
  57:  R[19:MemPointer]=540+R[19:MemPointer] ;
  58:   ;
  59:  JMP LBL[1] ;
  60:   ;
  61:  LBL[10:GROUP1_2] ;
  62:  ! PACCHETTI 1 O 2 (R150-R197) ;
  63:  R[16:Aux Size Change]=R[12:Data Flow In]-1 ;
  64:   ;
  65:  R[19:MemPointer]=24*R[16:Aux Size Change] ;
  66:   ;
  67:  R[19:MemPointer]=150+R[19:MemPointer] ;
  68:  JMP LBL[1] ;
  69:   ;
  70:  LBL[15:PeP DATA GROUP] ;
  71:  ! PACCHETTI 35 O 36 O 37 (R800-R87 ;
  72:  R[16:Aux Size Change]=R[12:Data Flow In]-35 ;
  73:   ;
  74:  R[19:MemPointer]=24*R[16:Aux Size Change] ;
  75:   ;
  76:  R[19:MemPointer]=800+R[19:MemPointer] ;
  77:  JMP LBL[1] ;
  78:   ;
  79:  LBL[11:GROUP3] ;
  80:  ! PACCHETTO 3 ;
  81:  R[19:MemPointer]=460 ;
  82:  JMP LBL[1] ;
  83:   ;
  84:  LBL[13:GROUP4] ;
  85:  ! PACCHETTO 4 ;
  86:  R[19:MemPointer]=660 ;
  87:  JMP LBL[1] ;
  88:   ;
  89:  LBL[1:GI->R] ;
  90:  IF R[17:DataCount]>23, JMP LBL[2] ;
  91:  R[18:InputPointer]=R[17:DataCount]+2 ;
  92:  R[R[19]]=GI[R[18]] ;
  93:  ! Test conversione valori negativi ;
  94:   ;
  95:  IF R[R[19]]<=32767, JMP LBL[3] ;
  96:  R[R[19]]=65536-R[R[19]] ;
  97:  R[R[19]]=0-R[R[19]] ;
  98:  LBL[3:DatoPositivo] ;
  99:   ;
 100:  ! Incremento puntatori ;
 101:  R[17:DataCount]=R[17:DataCount]+1 ;
 102:  R[19:MemPointer]=R[19:MemPointer]+1 ;
 103:  JMP LBL[1] ;
 104:  LBL[2] ;
