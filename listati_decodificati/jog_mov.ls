/PROG JOG_MOV
   1:   ;
   2:  PR[2:Appoggio]=LPOS ;
   3:   ;
   4:   ;
   5:  R[711:Vel JOG]=50 ;
   6:  R[712:Step Vel JOG]=1 ;
   7:   ;
   8:  LBL[1:Loop] ;
   9:   ;
  10:  SELECT R[704:SelJOG Direction]=1001, JMP LBL[101] ;
  11:         =1003, JMP LBL[102] ;
  12:         =1005, JMP LBL[103] ;
  13:         =1007, JMP LBL[104] ;
  14:         =1009, JMP LBL[105] ;
  15:         =1011, JMP LBL[106] ;
  16:         =1002, JMP LBL[111] ;
  17:         =1004, JMP LBL[112] ;
  18:         =1006, JMP LBL[113] ;
  19:         =1008, JMP LBL[114] ;
  20:         =1010, JMP LBL[115] ;
  21:         =1012, JMP LBL[116] ;
  22:   ;
  23:  LBL[101:Direction X+] ;
  24:  PR[2,1:Appoggio]=PR[2,1:Appoggio]+20 ;
  25:  JMP LBL[120] ;
  26:   ;
  27:  LBL[102:Direction Y+] ;
  28:  PR[2,2:Appoggio]=PR[2,2:Appoggio]+20 ;
  29:  JMP LBL[120] ;
  30:   ;
  31:  LBL[103:Direction Z+] ;
  32:  PR[2,3:Appoggio]=PR[2,3:Appoggio]+20 ;
  33:  JMP LBL[120] ;
  34:   ;
  35:  LBL[104:Direction W+] ;
  36:  UFRAME_NUM=0 ;
  37:  PR[1:Appoggio]=LPOS ;
  38:  UFRAME[7]=PR[1:Appoggio] ;
  39:  UFRAME_NUM=7 ;
  40:  PR[2:Appoggio]=LPOS ;
  41:  PR[2,4:Appoggio]=PR[2,4:Appoggio]+1 ;
  42:  JMP LBL[120] ;
  43:   ;
  44:  LBL[105:Direction P+] ;
  45:  UFRAME_NUM=0 ;
  46:  PR[1:Appoggio]=LPOS ;
  47:  UFRAME[7]=PR[1:Appoggio] ;
  48:  UFRAME_NUM=7 ;
  49:  PR[2:Appoggio]=LPOS ;
  50:  PR[2,5:Appoggio]=PR[2,5:Appoggio]+1 ;
  51:  JMP LBL[120] ;
  52:   ;
  53:  LBL[106:Direction R+] ;
  54:  UFRAME_NUM=0 ;
  55:  PR[1:Appoggio]=LPOS ;
  56:  UFRAME[7]=PR[1:Appoggio] ;
  57:  UFRAME_NUM=7 ;
  58:  PR[2:Appoggio]=LPOS ;
  59:  PR[2,6:Appoggio]=PR[2,6:Appoggio]+1 ;
  60:  JMP LBL[120] ;
  61:   ;
  62:  LBL[111:Direction X-] ;
  63:  PR[2,1:Appoggio]=PR[2,1:Appoggio]-20 ;
  64:  JMP LBL[120] ;
  65:   ;
  66:  LBL[112:Direction Y-] ;
  67:  PR[2,2:Appoggio]=PR[2,2:Appoggio]-20 ;
  68:  JMP LBL[120] ;
  69:   ;
  70:  LBL[113:Direction Z-] ;
  71:  PR[2,3:Appoggio]=PR[2,3:Appoggio]-20 ;
  72:  JMP LBL[120] ;
  73:   ;
  74:  LBL[114:Direction W-] ;
  75:  UFRAME_NUM=0 ;
  76:  PR[1:Appoggio]=LPOS ;
  77:  UFRAME[7]=PR[1:Appoggio] ;
  78:  UFRAME_NUM=7 ;
  79:  PR[2:Appoggio]=LPOS ;
  80:  PR[2,4:Appoggio]=PR[2,4:Appoggio]-1 ;
  81:  JMP LBL[120] ;
  82:   ;
  83:  LBL[115:Direction P-] ;
  84:  UFRAME_NUM=0 ;
  85:  PR[1:Appoggio]=LPOS ;
  86:  UFRAME[7]=PR[1:Appoggio] ;
  87:  UFRAME_NUM=7 ;
  88:  PR[2:Appoggio]=LPOS ;
  89:  PR[2,5:Appoggio]=PR[2,5:Appoggio]-1 ;
  90:  JMP LBL[120] ;
  91:   ;
  92:  LBL[116:Direction R-] ;
  93:  UFRAME_NUM=0 ;
  94:  PR[1:Appoggio]=LPOS ;
  95:  UFRAME[7]=PR[1:Appoggio] ;
  96:  UFRAME_NUM=7 ;
  97:  PR[2:Appoggio]=LPOS ;
  98:  PR[2,6:Appoggio]=PR[2,6:Appoggio]-1 ;
  99:  JMP LBL[120] ;
 100:   ;
 101:  LBL[120:Speed Select] ;
 102:  SELECT R[712:Step Vel JOG]=3, JMP LBL[3] ;
 103:         =6, JMP LBL[6] ;
 104:   ;
 105:  LBL[2] ;
 106:  SKIP CONDITION DI[26:Jog Robot]=OFF ;
 107:  L PR[2:Appoggio] R[711]mm/sec CNT100 Skip,LBL[100],PR[3:Appoggio]=LPOS ;
 108:  DO[28:EnMemorizzaJogPos]=ON ;
 109:   ;
 110:  WAIT 0.20(sec) ;
 111:  UFRAME_NUM=8 ;
 112:  PR[3:Appoggio]=LPOS ;
 113:   ;
 114:  END ;
 115:   ;
 116:  LBL[100:Continue Mov] ;
 117:  R[712:Step Vel JOG]=R[712:Step Vel JOG]+1 ;
 118:  JMP LBL[1] ;
 119:   ;
 120:  LBL[3:SPEED 3] ;
 121:  R[711:Vel JOG]=100 ;
 122:  JMP LBL[2] ;
 123:   ;
 124:  LBL[6:SPEED 6] ;
 125:  R[711:Vel JOG]=200 ;
 126:  JMP LBL[2] ;
 127:   ;
 128:  J P[100] 100% FINE ;
/POS
P[100]  UF:5 UT:2  X=0.0 Y=0.0 Z=0.0 W=0.0 P=0.0 R=0.0
